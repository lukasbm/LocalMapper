502 def normalize_item_target(item: dict[str, Any]) -> dict[str, Any] | None:
503     reference_rxns = item.get("mapped_rxns", [item["rxn"]])
504     normalized_rxns = [
505         normalized
506         for reference_rxn in reference_rxns
507         if (normalized := normalize_mapped_rxn(reference_rxn))
508     ]
509     if not normalized_rxns:
510         return None
511     return {
512         **item,
513         "rxn": normalized_rxns[0],
514         "mapped_rxns": normalized_rxns,
515         "num_mappings": len(normalized_rxns),
516     }
