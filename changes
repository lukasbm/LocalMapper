354 @lru_cache(maxsize=100_000)
355 def synkit_mapping_fingerprint(
356     rxn: str,
357     *,
358     check_method: str = "ITS",
359 ) -> str | None:
360     try:
361         import networkx as nx
362         from synkit.Graph.ITS.its_construction import ITSConstruction
363         from synkit.Graph.ITS.its_decompose import get_rc
364         from synkit.IO.chem_converter import rsmi_to_graph
365 
366         reactant, product = rsmi_to_graph(
367             rsmi=rxn,
368             sanitize=True,
369             drop_non_aam=True,
370         )
371         graph = ITSConstruction().ITSGraph(reactant, product)
372         if check_method.upper() == "RC":
373             graph = get_rc(graph)
374 
375         graph = graph.copy()
376         for _, attrs in graph.nodes(data=True):
377             attrs["_equivalence_label"] = repr(attrs.get("typesGH"))
378         for _, _, attrs in graph.edges(data=True):
379             attrs["_equivalence_label"] = repr(attrs.get("order"))
380 
381         return nx.weisfeiler_lehman_graph_hash(
382             graph,
383             node_attr="_equivalence_label",
384             edge_attr="_equivalence_label",
385             iterations=8,
386             digest_size=32,
387         )
388     except Exception:
389         return None
390 
