322 @lru_cache(maxsize=100_000)
323 def synkit_mapping_equivalent(
324     predicted_rxn: str,
325     reference_rxn: str,
326     *,
327     check_method: str = "ITS",
328 ) -> bool:
329     timeout = _synkit_timeout_seconds()
330     use_alarm = timeout > 0 and threading.current_thread() is threading.main_thread()
331     previous_handler = None
332     try:
333         if use_alarm:
334             previous_handler = signal.getsignal(signal.SIGALRM)
335             signal.signal(signal.SIGALRM, _handle_synkit_timeout)
336             signal.setitimer(signal.ITIMER_REAL, timeout)
337         from synkit.Chem.Reaction.aam_validator import AAMValidator
338 
339         return bool(
340             AAMValidator.smiles_check(
341                 predicted_rxn,
342                 reference_rxn,
343                 check_method=check_method,
344             )
345         )
346     except Exception:
347         return False
348     finally:
349         if use_alarm:
350             signal.setitimer(signal.ITIMER_REAL, 0)
351             signal.signal(signal.SIGALRM, previous_handler)
