702 _CGR_ISOLATED_BACKENDS = {"cgrtools", "cgrtools_isolated", "cgrtools_safe"}
703 _CGR_WORKER = None
704 _CGR_TASK_QUEUE = None
705 _CGR_RESULT_QUEUE = None
706 _CGR_TASK_ID = 0
