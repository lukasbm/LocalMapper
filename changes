455 def confident_pseudo_items(
456     root: str | Path,
457     dataset: str,
458     model_name: str,
459     seed: int,
460     iteration: int,
461     split: str,
462     per_template: int,
463 ) -> list[dict[str, Any]]:
464     if iteration <= 1 or per_template <= 0:
465         return []
466 
467     pred_path = prediction_path(root, dataset, model_name, seed, split, iteration - 1)
468     if not pred_path.exists():
469         return []
470 
471     known_templates = verified_templates(root, dataset, model_name, seed, iteration - 1)
472     if not known_templates:
473         return []
474 
475     predictions = pd.read_csv(pred_path, dtype={"data_idx": str})
476     if predictions.empty:
477         return []
478 
479     annotations = load_annotations(root, dataset, model_name, seed, iteration)
480     annotated_ids = (
481         set(annotations["data_idx"].astype(str)) if not annotations.empty else set()
482     )
483     predictions = predictions[
484         predictions["template"].fillna("").isin(known_templates)
485         & ~predictions["data_idx"].astype(str).isin(annotated_ids)
486     ].copy()
487     if "invalid_mapping" in predictions:
488         invalid = predictions["invalid_mapping"].astype(str).str.lower()
489         predictions = predictions[~invalid.isin({"true", "1", "yes"})].copy()
490     predictions = predictions[
491         predictions["mapped_rxn"].map(reaction_passes_paper_filters)
492     ].copy()
493     if predictions.empty:
494         return []
495 
496     sampled = []
497     rng = np.random.default_rng(seed + 10_000 + iteration)
498     for _, group in predictions.groupby("template"):
499         n = min(per_template, len(group))
500         chosen = group.sample(n=n, random_state=int(rng.integers(0, 2**31 - 1))).copy()
501         if len(group) <= per_template:
502             chosen["weight"] = PSEUDO_TEMPLATE_TOTAL_WEIGHT / max(len(chosen), 1)
503             chosen["train_split"] = "train"
504         else:
505             chosen["weight"] = 1.0
506             chosen["train_split"] = "train"
507             n_val = max(1, int(round(len(chosen) * 0.1)))
508             val_indices = chosen.sample(
509                 n=n_val, random_state=int(rng.integers(0, 2**31 - 1))
510             ).index
511             chosen.loc[val_indices, "train_split"] = "val"
512         sampled.append(chosen)
513     pseudo = pd.concat(sampled, ignore_index=True) if sampled else pd.DataFrame()
514     return [
515         {
516             "id": str(row["data_idx"]),
517             "rxn": row["mapped_rxn"],
518             "split": row.get("split", split),
519             "source": row.get("source"),
520             "num_mappings": row.get("num_mappings", 1),
521             "weight": float(row["weight"]),
522             "train_split": row["train_split"],
523             "label_source": "confident_prediction",
524         }
525         for _, row in pseudo.iterrows()
526     ]
527 

