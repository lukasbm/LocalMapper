53 107     def score_graphs(self, rgraphs, pgraphs):
54 108         rbg, pbg = dgl.batch(rgraphs), dgl.batch(pgraphs)
55 109         rbg.set_n_initializer(dgl.init.zero_initializer)
   110         pbg.set_n_initializer(dgl.init.zero_initializer)
   111         rbg.set_e_initializer(dgl.init.zero_initializer)
   112         pbg.set_e_initializer(dgl.init.zero_initializer)
   113         rbg, pbg = rbg.to(self.device), pbg.to(self.device)
   114         rnode_feats, pnode_feats = (
   115             rbg.ndata.pop("h").to(self.device),
   116             pbg.ndata.pop("h").to(self.device),
   117         )
   118         redge_feats, pedge_feats = (
   119             rbg.edata.pop("e").to(self.device),
   120             pbg.edata.pop("e").to(self.device),
   121         )
   122         return self(rbg, pbg, rnode_feats, pnode_feats, redge_feats, pedge_feats)
   123 
   124     def _rxns_to_graphs(self, rxns):
   125         if self.graph_function is None:
   126             raise ValueError("graph_function is required to score raw reaction strings")
   127         rgraphs, pgraphs = [], []
   128         for rxn in rxns:
   129             reactant, product = rxn.split(">>")
   130             rgraphs.append(self.graph_function(Chem.MolFromSmiles(reactant)))
   131             pgraphs.append(self.graph_function(Chem.MolFromSmiles(product)))
   132         return rgraphs, pgraphs
   133 
   134     def score_rxns(self, rxns, grad=False):
   135         single_input = isinstance(rxns, str)
   136         if single_input:
   137             rxns = [rxns]
   138         rgraphs, pgraphs = self._rxns_to_graphs(rxns)
   139         if grad:
   140             scores = self.score_graphs(rgraphs, pgraphs)
   141         else:
   142             with torch.no_grad():
   143                 scores = self.score_graphs(rgraphs, pgraphs)
   144         return scores[0] if single_input else scores
   145 
   146     def map_rxns(
   147         self,
   148         rxns,
   149         accepted_templates=None,
   150         try_twice=True,
   151         return_dict=False,
   152     ):
   153         single_input = isinstance(rxns, str)
   154         if single_input:
   155             rxns = [rxns]
   156         was_training = self.training
   157         self.eval()
   158         logits_list = self.score_rxns(rxns, grad=False)
   159         results = self.map_scores(
   160             rxns,
   161             logits_list,
   162             accepted_templates=accepted_templates,
   163             try_twice=try_twice,
   164             return_dict=return_dict,
   165         )
   166 
   167         if was_training:
   168             self.train()
   169         return results[0] if single_input else results
   170 
   171     def map_scores(
   172         self,
   173         rxns,
   174         logits_list,
   175         accepted_templates=None,
   176         try_twice=True,
   177         return_dict=False,
   178     ):
   179         has_template_filter = accepted_templates is not None
   180         accepted_templates = set() if accepted_templates is None else accepted_templates
   181 
   182         results = []
   183         for rxn, logits in zip(rxns, logits_list):
   184             prediction = torch.softmax(logits, dim=1).cpu().numpy()
   185             mapped_result = prediction2map(rxn, prediction)
   186             result = {"rxn": rxn}
   187             result.update(mapped_result)
   188             confident = result["template"] in accepted_templates
   189             if has_template_filter and try_twice and not confident:
   190                 mapped_result = prediction2map(rxn, prediction, neighbor_weight=90)
   191                 result.update(mapped_result)
   192                 confident = result["template"] in accepted_templates
   193             result["confident"] = confident if has_template_filter else None
   194             results.append(result if return_dict else mapped_result["mapped_rxn"])
   195         return results

