 18 def _output_dir(root: Path, dataset: str, model_name: str, seed: int) -> Path:
 19     return root / "outputs" / dataset / f"{model_name}_seed{seed}"
 20 
 21 
 22 def _git_value(*args: str) -> str | None:
 23     try:
 24         completed = subprocess.run(
 25             ["git", *args],
 26             cwd=ROOT,
 27             check=True,
 28             capture_output=True,
 29             text=True,
 30         )
 31     except Exception:
 32         return None
 33     return completed.stdout.strip() or None
 34 
 35 
 36 def _package_version(module_name: str, *distribution_names: str) -> str | None:
 37     for distribution_name in distribution_names:
 38         try:
 39             return metadata.version(distribution_name)
 40         except metadata.PackageNotFoundError:
 41             continue
 42     try:
 43         module = __import__(module_name)
 44     except Exception:
 45         return None
 46     return getattr(module, "__version__", None)
 47 
