 80 def get_tagged_atoms_from_mols(mols):
 81     """Takes a list of RDKit molecules and returns total list of
 82     atoms and their tags"""
 83     atoms = []
 84     atom_tags = []
 85     for mol in mols:
 86         new_atoms, new_atom_tags = get_tagged_atoms_from_mol(mol)
 87         atoms += new_atoms
 88         atom_tags += new_atom_tags
 89     return atoms, atom_tags
 90 
 91 
 92 def get_tagged_atoms_from_mol(mol):
 93     """Takes an RDKit molecule and returns list of tagged atoms and their
 94     corresponding numbers"""
 95     atoms = []
 96     atom_tags = []
 97     for atom in mol.GetAtoms():
 98         if atom.HasProp("molAtomMapNumber"):
 99             atoms.append(atom)
100             atom_tags.append(str(atom.GetProp("molAtomMapNumber")))
101     return atoms, atom_tags
102 
103 
104 def atoms_are_different(atom1, atom2):
105     """Compares two RDKit atoms based on basic properties"""
106 
107     if atom1.GetAtomicNum() != atom2.GetAtomicNum():
108         return True  # must be true for atom mapping
109 
110         #     if atom1.GetNumRadicalElectrons() != atom2.GetNumRadicalElectrons(): return True
111     if REMOTE:
112         if atom1.GetFormalCharge() != atom2.GetFormalCharge():
113             return True
114         # may be wrong information due to wrong atom mapping
115         if atom1.GetTotalNumHs() != atom2.GetTotalNumHs():
116             return True
117 
118     # add or break bonds
119     if atom_neighbors(atom1) != atom_neighbors(atom2):
120         return True
121 
122     # change bonds
123     bonds1 = sorted([bond_to_smarts(bond) for bond in atom1.GetBonds()])
124     bonds2 = sorted([bond_to_smarts(bond) for bond in atom2.GetBonds()])
125     if bonds1 != bonds2:
126         return True
127 
128     return False
129 
130 
131 def find_map_num(mol, mapnum):
132     return [
133         (a.GetIdx(), a)
134         for a in mol.GetAtoms()
135         if a.HasProp("molAtomMapNumber")
136         and a.GetProp("molAtomMapNumber") == str(mapnum)
137     ][0]
138 
139 
140 def clear_isotope(mol):
141     [a.SetIsotope(0) for a in mol.GetAtoms()]
142 
143 
144 def get_changed_atoms(reactants, products):
145     """Looks at mapped atoms in a reaction and determines which ones changed"""
146 
147     err = 0
148     prod_atoms, prod_atom_tags = get_tagged_atoms_from_mols(products)
149 
150     if VERBOSE:
151         print("Products contain {} tagged atoms".format(len(prod_atoms)))
152     if VERBOSE:
153         print(
154             "Products contain {} unique atom numbers".format(len(set(prod_atom_tags)))
155         )
156 
157     reac_atoms, reac_atom_tags = get_tagged_atoms_from_mols(reactants)
158     if len(set(prod_atom_tags)) != len(set(reac_atom_tags)):
159         if VERBOSE:
160             print("warning: different atom tags appear in reactants and products")
161     if len(prod_atoms) != len(reac_atoms):
162         if VERBOSE:
163             print("warning: total number of tagged atoms differ, stoichometry != 1?")
164 
165     # Find differences
166     changed_atoms = []  # actual reactant atom species
167     changed_atom_tags = []  # atom map numbers of those atoms
168 
169     # Product atoms that are different from reactant atom equivalent
170     for i, prod_tag in enumerate(prod_atom_tags):
171         for j, reac_tag in enumerate(reac_atom_tags):
172             if reac_tag != prod_tag:
173                 continue
174             if (
175                 reac_tag not in changed_atom_tags
176             ):  # don't bother comparing if we know this atom changes
177                 # If atom changed, add
178                 if atoms_are_different(prod_atoms[i], reac_atoms[j]):
179                     changed_atoms.append(reac_atoms[j])
180                     changed_atom_tags.append(reac_tag)
181                     break
182                 # If reac_tag appears multiple times, add (need for stoichometry > 1)
183                 if prod_atom_tags.count(reac_tag) > 1:
184                     changed_atoms.append(reac_atoms[j])
185                     changed_atom_tags.append(reac_tag)
186                     break
187 
188     # Reactant atoms that do not appear in product (tagged leaving groups)
189     for j, reac_tag in enumerate(reac_atom_tags):
190         if reac_tag not in changed_atom_tags:
191             if reac_tag not in prod_atom_tags:
192                 changed_atoms.append(reac_atoms[j])
193                 changed_atom_tags.append(reac_tag)
194 
195     [clear_isotope(reactant) for reactant in reactants]
196     [clear_isotope(product) for product in products]
197 
198     if VERBOSE:
199         print(
200             "{} tagged atoms in reactants change 1-atom properties".format(
201                 len(changed_atom_tags)
202             )
203         )
204         for smarts in [atom.GetSmarts() for atom in changed_atoms]:
205             print("  {}".format(smarts))
206 
207     return changed_atoms, changed_atom_tags, err
208 
209 
210 def template_scorer(template, atom_dict):
211     score = 0
212     for s, b in enumerate(["-", ":", "=", "#"]):
213         score += template.count(b) * (s + 1)
214     for n in re.findall("\:([0-9]+)\]", template):
215         if n in atom_dict:
216             score += 0.1 * atom_dict[n]["charge"] + 0.01 * atom_dict[n]["Hs"]
217     return score
218 
219 
220 def inv_temp(template):  # for more canonical representation
221     symbols = re.findall("\[[a-zA-Z@]+\:.*?\]", template)
222     nums = [int(n) for n in re.findall("\[[a-zA-Z@]+\:(.*?)\]", template)]
223     if len(nums) not in [2, 3] or "]1" in template:
224         return template
225     if nums[0] < nums[1]:
226         return template
227     if len(nums) == 3:
228         if nums[0] < nums[2]:
229             return template
230     bonds = [""] + [
231         sorted(bond)[1] for bond in re.findall(r"]([-=#:])|]1([-=#:])", template)
232     ]
233     return "".join(["%s%s" % (a, b) for a, b in zip(symbols[::-1], bonds[::-1])])
234 
235 
236 def inverse_template(template):  # for more canonical representation
237     n_atoms = sum(
238         [Chem.MolFromSmarts(smarts).GetNumAtoms() for smarts in template.split(">>")]
239     )
240     labels = re.findall("(\[[a-zA-Z@]+\:.*?\])", template)
241     if n_atoms > len(labels):  # include leaving group
242         return template
243 
244     def score_bonds(bonds):
245         bond_dict = {b: str(i + 1) for i, b in enumerate(["-", ":", "=", "#"])}
246         return eval("".join([bond_dict[b] for b in bonds]))
247 
248     if "]1" in template:
249         ring_template = True
250     else:
251         ring_template = False
252     bonds1 = [sorted(bond)[1] for bond in re.findall(r"]([-=#:])|]1([-=#:])", template)]
253     bonds2 = bonds1[::-1]
254     if (
255         len(bonds1) == 0
256         or ")" in template
257         or score_bonds(bonds1) <= score_bonds(bonds2)
258     ):
259         return template
260 
261     labels = re.findall(r"\[.*?]", template)[::-1]
262     inv_template = labels[0]
263     for i in range(len(bonds2)):
264         if ring_template:
265             if i == 0:
266                 inv_template += "1"
267             if i + 1 == len(labels):
268                 inv_template += bonds2[0]
269                 inv_template += "1"
270             else:
271                 inv_template += bonds2[i + 1]
272                 inv_template += labels[i + 1]
273         else:
274             inv_template += bonds2[i]
275             inv_template += labels[i + 1]
276     return inv_template
277 
278 
279 def canonicalize_smarts(smarts):  # for more canonical representation
280     return smarts
281     if USE_ATOM_SYMBOL:
282         return smarts
283     preserved_info = {
284         "[#0:%s]" % a.split(":")[-1].split("]")[0]: a
285         for a in re.findall(r"\[.*?]", smarts)
286     }
287     try:
288         smiles = Chem.MolToSmiles(Chem.MolFromSmarts(smarts))
289         smarts_ = Chem.MolToSmarts(Chem.MolFromSmiles(smiles))
290     except:
291         return smarts
292     if "(" not in smarts_:
293         smarts = smarts_
294         for k, v in preserved_info.items():
295             smarts = smarts.replace(k, v)
296     return smarts
297 
298 
299 def sort_template(transform, atom_dict):  # for more canonical representation
300     transform = (
301         transform.split(">>")[0][1:-1].replace(").(", ".")
302         + ">>"
303         + transform.split(">>")[1][1:-1].replace(").(", ".")
304     )
305     templates = []
306     for tt in transform.split(">>"):
307         ts = []
308         for smarts in sorted(
309             tt.split("."), key=lambda s: template_scorer(s, atom_dict)
310         ):
311             try:
312                 ts.append(inverse_template(canonicalize_smarts(smarts)))
313             except:
314                 ts.append(canonicalize_smarts(smarts))
315         templates.append(".".join(ts))
316     return ">>".join(templates)
317 
318 
319 def permutations(template):
320     n_atoms = sum(
321         [Chem.MolFromSmarts(smarts).GetNumAtoms() for smarts in template.split(">>")]
322     )
323     labels = re.findall("(\[[a-zA-Z@]+\:.*?\])", template)
324     if (
325         len(labels) == 1 or "(" in template or n_atoms > len(labels)
326     ):  # include leaving group
327         return [labels]
328     charges = re.findall("\;(.+?[0-9]+)\:", template)
329     bonds = re.findall("\]([-=#:])\[", template)
330     if "".join(bonds) != "".join(bonds[::-1]) or "".join(charges) != "".join(
331         charges[::-1]
332     ):
333         return [labels]
334     return [labels, labels[::-1]]
335 
336 
337 def enumerate_mapping(transform):
338     for i, templates in enumerate(transform.split(">>")):
339         grow_template = None
340         for template in templates.split("."):
341             pert_template = permutations(template)
342             if grow_template == None:
343                 grow_template = pert_template
344             else:
345                 growed_template = []
346                 for t in grow_template:
347                     for p in pert_template:
348                         growed_template.append(t + p)
349                 grow_template = growed_template
350         if i == 0:
351             r_permutes = grow_template
352         else:
353             p_permutes = grow_template
354 
355     t_permutes = []
356     for r in r_permutes:
357         for p in p_permutes:
358             t_permutes.append(r + p)
359     return t_permutes
360 
361 
362 def reassign_atom_mapping(transform, atom_dict):
363     if not RETRO:
364         transform = ">>".join(transform.split(">>")[::-1])
365     transform = sort_template(transform, atom_dict)
366 
367     p_labels = enumerate_mapping(transform)
368     templates = set()
369     templates_sort = {}
370     replacement_dicts = {}
371     for all_labels in p_labels:
372         # Define list of replacements which matches all_labels *IN ORDER*
373         replacements = []
374         replacement_dict_symbol = {}
375         replacement_dict = {}
376         counter = 1
377         for label in all_labels:  # keep in order! this is important
378             atom_map = label.split(":")[1].split("]")[0]
379             if atom_map not in replacement_dict:
380                 replacement_dict_symbol[label] = "%s:%s]" % (
381                     label.split(":")[0],
382                     counter,
383                 )
384                 replacement_dict[atom_map] = str(counter)
385                 counter += 1
386             else:
387                 replacement_dict_symbol[label] = "%s:%s]" % (
388                     label.split(":")[0],
389                     replacement_dict[atom_map],
390                 )
391             replacements.append(replacement_dict_symbol[label])
392 
393         # Perform replacements in order
394         transform_newmaps = re.sub(
395             "\[[a-zA-Z@]+\:.*?\]", lambda match: replacements.pop(0), transform
396         )
397         transform_newmaps = ">>".join(transform_newmaps.split(">>")[::-1])
398 
399         templates.add(transform_newmaps)
400         templates_sort[transform_newmaps] = "".join(
401             re.findall("\[[a-zA-Z@]+\:.*?\]", transform_newmaps)
402         )
403         replacement_dicts[transform_newmaps] = replacement_dict
404 
405     transform_newmaps = sorted(list(templates), key=lambda t: templates_sort[t])[0]
406     replacement_dict = replacement_dicts[transform_newmaps]
407     return transform_newmaps, replacement_dict
408 
409 
410 def get_strict_smarts_for_atom(atom):
411     """
412     For an RDkit atom object, generate a SMARTS pattern that
413     matches the atom as strictly as possible
414     """
415     if USE_ATOM_SYMBOL:
416         symbol = "[%s:%s]" % (atom.GetSymbol(), atom.GetAtomMapNum())
417     else:
418         symbol = "[A:%s]" % (atom.GetAtomMapNum())
419 
420     if atom.GetIsAromatic():
421         symbol = symbol.lower()
422 
423     if atom.GetSymbol() == "H":
424         symbol = "[#1]"
425 
426     if "[" not in symbol:
427         symbol = "[" + symbol + "]"
428 
429     return symbol
430 
431 
432 def get_fragments_for_changed_atoms(
433     mols, changed_atom_tags, category="reactant", special_atoms=[]
434 ):
435     fragments = ""
436     mols_changed = []
437     mols_special = []
438     for mol in mols:
439         # Initialize list of replacement symbols (updated during expansion)
440         symbol_replacements = []
441 
442         # Build list of atoms to use
443         atoms_to_use = []
444 
445         for atom in mol.GetAtoms():
446             # Check self (only tagged atoms)
447             if ":" in atom.GetSmarts():
448                 atom_map = atom.GetSmarts().split(":")[1][:-1]
449                 if atom_map in changed_atom_tags + special_atoms:
450                     atoms_to_use.append(atom.GetIdx())
451                     symbol = get_strict_smarts_for_atom(atom)
452                     if atom_map in changed_atom_tags:
453                         symbol = get_strict_smarts_for_atom(atom)
454                         if symbol != atom.GetSmarts():
455                             symbol_replacements.append((atom.GetIdx(), symbol))
456                     else:
457                         if atom.GetIsAromatic():
458                             symbol_replacements.append(
459                                 (atom.GetIdx(), atom.GetSymbol().lower())
460                             )
461                         else:
462                             symbol_replacements.append(
463                                 (atom.GetIdx(), atom.GetSymbol())
464                             )
465 
466         if category == "reactant":
467             if INCLUDE_NEIGHBORS:
468                 groups = get_special_groups(mol)
469                 atoms_to_use, symbol_replacements, mol = expand_atoms_to_use(
470                     mol,
471                     atoms_to_use,
472                     groups=groups,
473                     symbol_replacements=symbol_replacements,
474                 )
475                 for atom_idx in atoms_to_use:
476                     atom = mol.GetAtomWithIdx(atom_idx)
477                     atom_map = str(atom.GetAtomMapNum())
478                     if atom_map not in changed_atom_tags:
479                         special_atoms.append(atom_map)
480                         if atom.GetIsAromatic():
481                             symbol_replacements.append(
482                                 (atom.GetIdx(), atom.GetSymbol().lower())
483                             )
484                         else:
485                             symbol_replacements.append(
486                                 (atom.GetIdx(), atom.GetSymbol())
487                             )
488 
489             for atom in mol.GetAtoms():
490                 if not atom.HasProp(
491                     "molAtomMapNumber"
492                 ):  # LG in reactant is also mapped in foward synthesis
493                     atoms_to_use.append(atom.GetIdx())
494 
495         else:
496             groups = []
497         mols_special.append(mol)
498         # Define new symbols based on symbol_replacements
499         symbols = [atom.GetSmarts() for atom in mol.GetAtoms()]
500         for i, symbol in symbol_replacements:
501             symbols[i] = symbol
502         if not atoms_to_use:
503             continue
504 
505         mol_copy = deepcopy(mol)
506         [x.ClearProp("molAtomMapNumber") for x in mol_copy.GetAtoms()]
507         this_fragment = AllChem.MolFragmentToSmiles(
508             mol_copy,
509             atoms_to_use,
510             atomSymbols=symbols,
511             allHsExplicit=True,
512             isomericSmiles=USE_STEREOCHEMISTRY,
513             allBondsExplicit=True,
514         )
515         fragments += "(" + this_fragment + ")."
516         mols_changed.append(
517             Chem.MolToSmiles(
518                 clear_mapnum(Chem.MolFromSmiles(Chem.MolToSmiles(mol, True))), True
519             )
520         )
521 
522     # auxiliary template information: is this an intramolecular reaction or dimerization?
523     intra_only = 1 == len(mols_changed)
524     dimer_only = (1 == len(set(mols_changed))) and (len(mols_changed) == 2)
525     return fragments[:-1], intra_only, dimer_only, mols_special, special_atoms
526 
527 
528 def canonicalize_transform(transform, atom_dict):
529     """This function takes an atom-mapped SMARTS transform and
530     converts it to a canonical form by, if nececssary, rearranging
531     the order of reactant and product templates and reassigning
532     atom maps."""
533 
534     transform_reordered = ">>".join(
535         [canonicalize_template(x) for x in transform.split(">>")]
536     )
537     return reassign_atom_mapping(transform_reordered, atom_dict)
538 
539 
540 def canonicalize_template(template):
541     """This function takes one-half of a template SMARTS string
542     (i.e., reactants or products) and re-orders them based on
543     an equivalent string without atom mapping."""
544 
545     # Strip labels to get sort orders
546     template_nolabels = re.sub("\:[0-9]+\]", "]", template)
547 
548     # Split into separate molecules *WITHOUT wrapper parentheses*
549     template_nolabels_mols = template_nolabels[1:-1].split(").(")
550     template_mols = template[1:-1].split(").(")
551 
552     # Split into fragments within those molecules
553     for i in range(len(template_mols)):
554         nolabel_mol_frags = template_nolabels_mols[i].split(".")
555         mol_frags = template_mols[i].split(".")
556 
557         # Get sort order within molecule, defined WITHOUT labels
558         sortorder = [
559             j[0] for j in sorted(enumerate(nolabel_mol_frags), key=lambda x: x[1])
560         ]
561 
562         # Apply sorting and merge list back into overall mol fragment
563         template_nolabels_mols[i] = ".".join([nolabel_mol_frags[j] for j in sortorder])
564         template_mols[i] = ".".join([mol_frags[j] for j in sortorder])
565 
566     # Get sort order between molecules, defined WITHOUT labels
567     sortorder = [
568         j[0] for j in sorted(enumerate(template_nolabels_mols), key=lambda x: x[1])
569     ]
570 
571     # Apply sorting and merge list back into overall transform
572     template = "(" + ").(".join([template_mols[i] for i in sortorder]) + ")"
573 
574     return template
575 
576 
577 def bond_to_smarts(bond):
578     """This function takes an RDKit bond and creates a label describing
579     the most important attributes"""
580     a1_label = str(bond.GetBeginAtom().GetAtomicNum())
581     a2_label = str(bond.GetEndAtom().GetAtomicNum())
582     if bond.GetBeginAtom().HasProp("molAtomMapNumber"):
583         a1_label += bond.GetBeginAtom().GetProp("molAtomMapNumber")
584     if bond.GetEndAtom().HasProp("molAtomMapNumber"):
585         a2_label += bond.GetEndAtom().GetProp("molAtomMapNumber")
586     atoms = sorted([a1_label, a2_label])
587     bond_dict = {"SINGLE": "-", "DOUBLE": "=", "TRIPLE": "#", "AROMATIC": ":"}
588     bond_smarts = bond_dict[str(bond.GetBondType())]
589 
590     return "{}{}{}".format(atoms[0], bond_smarts, atoms[1])
591 
592 
593 def split_reagents(reaction):
594     rs, ps = (
595         replace_deuterated(reaction["reactants"]).split("."),
596         replace_deuterated(reaction["products"]).split("."),
597     )
598     largest_p = [
599         Chem.MolFromSmiles(smiles).GetNumAtoms()
600         for smiles in ps
601         if smiles not in rs and smiles != ""
602     ]
603     if len(largest_p) == 0:
604         return [], [], []
605     least_atom_n = min([max(largest_p), LEAST_ATOM_NUM])
606     reactants = []
607     reagents = []
608     products = []
609     pmaps = []
610     for smiles in ps:
611         mol = Chem.MolFromSmiles(smiles)
612         if mol.GetNumAtoms() >= least_atom_n and smiles not in reagents:
613             pmaps += [atom.GetAtomMapNum() for atom in mol.GetAtoms()]
614             products.append(smiles)
615 
616     for smiles in rs:
617         mol = Chem.MolFromSmiles(smiles)
618         if (
619             smiles in ps
620             or sum([atom.GetAtomMapNum() in pmaps for atom in mol.GetAtoms()]) == 0
621         ):
622             reagents.append(smiles)
623         else:
624             reactants.append(smiles)
625     products = [p for p in products if p not in reagents]
626     return reactants, reagents, products
627 
628 
629 def extract_from_reaction(reaction, setting=default_setting):
630     set_extractor(setting)
631     if type(reaction) == type("string"):
632         reaction = {
633             "reactants": reaction.split(">>")[0],
634             "products": reaction.split(">>")[1],
635         }
636     reactants_list, reagents_list, products_list = split_reagents(reaction)
637 
638     if len(products_list) == 0:
639         return None
640     product_maps = [
641         atom.GetAtomMapNum()
642         for products in products_list
643         for atom in Chem.MolFromSmiles(products).GetAtoms()
644     ]
645     products = clean_map_and_sort(products_list, product_maps, return_mols=True)
646     reactants = clean_map_and_sort(reactants_list, product_maps, return_mols=True)
647 
648     if None in reactants:
649         return None
650     if None in products:
651         return None
652     # try to sanitize molecules
653     try:
654         for i in range(len(reactants)):
655             reactants[i] = AllChem.RemoveHs(reactants[i])  # *might* not be safe
656         for i in range(len(products)):
657             products[i] = AllChem.RemoveHs(products[i])  # *might* not be safe
658         [Chem.SanitizeMol(mol) for mol in reactants + products]  # redundant w/ RemoveHs
659         [mol.UpdatePropertyCache() for mol in reactants + products]
660     except Exception as e:
661         if VERBOSE:
662             print(e)
663             print("Could not load SMILES or sanitize")
664         return
665 
666     if None in reactants + products:
667         if VERBOSE:
668             print("Could not parse all molecules in reaction, skipping")
669         return
670 
671     # Calculate changed atoms
672     changed_atoms, changed_atom_tags, err = get_changed_atoms(reactants, products)
673 
674     if err:
675         if VERBOSE:
676             print("Could not get changed atoms")
677         return
678     if not changed_atom_tags:
679         if VERBOSE:
680             print("No atoms changed?")
681         return
682 
683     try:
684         reactant_fragments, _, _, reactants, special_atoms = (
685             get_fragments_for_changed_atoms(
686                 reactants, changed_atom_tags, "reactant", []
687             )
688         )
689         product_fragments, _, _, _, _ = get_fragments_for_changed_atoms(
690             products, changed_atom_tags, "product", special_atoms
691         )
692         reaction["reactants"] = ".".join(
693             [Chem.MolToSmiles(m, canonical=False) for m in reactants]
694         )
695     except ValueError as e:
696         if VERBOSE:
697             print(e)
698         return
699 
700     # Put together and canonicalize (as best as possible)
701     rxn_string = reactant_fragments + ">>" + product_fragments
702     if VERBOSE:
703         print(rxn_string)
704     atom_dict = {
705         str(atom.GetAtomMapNum()): {
706             "charge": atom.GetFormalCharge(),
707             "Hs": atom.GetNumExplicitHs(),
708         }
709         for atom in changed_atoms
710     }
711 
712     rxn_canonical, replacement_dict = canonicalize_transform(rxn_string, atom_dict)
713 
714     reactants_string = rxn_canonical.split(">>")[0]
715     products_string = rxn_canonical.split(">>")[1]
716     products_smiles = ".".join([Chem.MolToSmiles(p) for p in products])
717     reactants_smiles = ".".join([Chem.MolToSmiles(r) for r in reactants])
718     try:
719         products_string = canonicalize_smarts(products_string)
720         reactants_string = canonicalize_smarts(reactants_string)
721     except:
722         pass
723 
724     canonical_template = "%s>>%s" % (reactants_string, products_string)
725     rxn = AllChem.ReactionFromSmarts(canonical_template)
726     if rxn.Validate()[1] != 0:
727         if VERBOSE:
728             print("Could not validate reaction successfully")
729             print("canonical_template: {}".format(canonical_template))
730             print(reaction["reactants"] + ">>" + reaction["products"])
731         return
732 
733     return canonical_template
734 

