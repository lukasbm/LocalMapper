387 def save_rejected_template_library(
388     root: str | Path,
389     dataset: str,
390     model_name: str,
391     seed: int,
392     split: str,
393     through_prediction_iteration: int,
394     through_annotation_iteration: int,
395 ) -> Path:
396     rejected = sorted(
397         rejected_templates(
398             root,
399             dataset,
400             model_name,
401             seed,
402             split,
403             through_prediction_iteration=through_prediction_iteration,
404             through_annotation_iteration=through_annotation_iteration,
405         )
406     )
407     path = rejected_template_library_path(
408         root, dataset, model_name, seed, split, through_annotation_iteration
409     )
410     mkdir_p(path.parent)
411     pd.DataFrame({"template": rejected}).to_csv(path, index=False)
412     return path
