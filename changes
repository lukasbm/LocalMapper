401 def save_rejected_template_library(
402     root: str | Path,
403     dataset: str,
404     model_name: str,
405     seed: int,
406     split: str,
407     through_prediction_iteration: int,
408     through_annotation_iteration: int,
409 ) -> Path:
410     rejected = sorted(
