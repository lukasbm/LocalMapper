346 def save_annotations(
347     root: str | Path,
348     dataset: str,
349     model_name: str,
350     seed: int,
351     iteration: int,
352     annotations: pd.DataFrame,
353 ) -> Path:
354     path = annotation_path(root, dataset, model_name, seed, iteration)
355     mkdir_p(path.parent)
356     annotations.to_csv(path, index=False)
357     save_verified_template_library(root, dataset, model_name, seed, iteration)
358     return path
