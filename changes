 19 def set_extractor(setting):
 20     global VERBOSE,  USE_STEREOCHEMISTRY, USE_ATOM_SYMBOL, LEAST_ATOM_NUM, INCLUDE_NEIGHBORS, MAXIMUM_NUMBER_UNMAPPED_PRODUCT_ATOMS, RETRO, REMOTE
 21     VERBOSE = setting['verbose'] # False
 22     USE_STEREOCHEMISTRY = setting['use_stereo'] # False
 23     USE_ATOM_SYMBOL = setting['use_symbol'] # False
 24     LEAST_ATOM_NUM = setting['least_atom_num']
 25     INCLUDE_NEIGHBORS = setting['include_neighbors']
 26     MAXIMUM_NUMBER_UNMAPPED_PRODUCT_ATOMS = setting['max_unmap'] # 5
 27     RETRO = setting['retro']
 28     REMOTE = setting['remote']
 29     return
