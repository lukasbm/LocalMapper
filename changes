211 def _cgr_signature_direct(rxn: str) -> str | None:
212     if get_mapping_label(rxn) is None:
213         return None
214 
215     smiles_read = _load_cgr_smiles_reader()
216     if smiles_read is None:
217         return None
218 
219     with smiles_read(
220         StringIO(f"{rxn}\n"),
221         ignore=_cgrtools_ignore_parser_errors(),
222         store_log=bool(_cgr_debug_path()),
223     ) as reader:
224         reaction = next(iter(reader))
225         if _cgr_debug_path():
226             parser_log = reaction.meta.get("CGRtoolsParserLog", "")
227             if parser_log:
228                 _log_cgr_event("cgrtools_parser_log", rxn, detail=parser_log.replace("\n", " | "))
229     cgr = reaction.compose()
230     return str(cgr)
231 
