 18 class EarlyStopping:
 19     def __init__(self, mode="lower", patience=5, filename="checkpoint.pth"):
 20         self.mode = mode
 21         self.patience = patience
 22         self.filename = filename
 23         self.best_score = None
 24         self.num_bad_epochs = 0
 25         self.sign = 1 if mode == "higher" else -1
 26 
 27     def step(self, value, model):
 28         score = self.sign * value
 29         if self.best_score is None or score > self.best_score:
 30             self.best_score = score
 31             self.num_bad_epochs = 0
 32             torch.save({"model_state_dict": model.state_dict()}, self.filename)
 33             return False
 34 
 35         self.num_bad_epochs += 1
 36         return self.num_bad_epochs >= self.patience
 37 
