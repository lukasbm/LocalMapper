829 def _progress(iterable, *, desc: str, total: int | None = None):
830     if tqdm is None or os.environ.get("LOCALMAPPER_PROGRESS", "1") == "0":
831         return iterable
832     return tqdm(iterable, desc=desc, total=total)
833 
834 
835 def normalize_item_targets(
836     items: list[dict[str, Any]],
837     *,
838     progress_desc: str | None = None,
839 ) -> list[dict[str, Any]]:
840     iterator = (
841         _progress(items, desc=progress_desc, total=len(items))
842         if progress_desc
843         else items
844     )
845     return [
846         normalized
847         for item in iterator
848         if (normalized := normalize_item_target_with_timeout(item)) is not None
849     ]
