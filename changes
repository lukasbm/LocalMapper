404 def _valid_rxn(rxn: Any) -> bool:
405     if not isinstance(rxn, str) or rxn.count(">>") != 1:
406         return False
407     reactants, products = rxn.split(">>")
408     return bool(reactants and products)
409 
410 
411 def _alternatives(value: Any) -> list[str]:
412     if not isinstance(value, str):
413         return []
414     return [
415         part.strip() for part in value.strip().split(",") if _valid_rxn(part.strip())
416     ]
417 
418 
419 def _item(
420     idx: Any,
421     rxn: Any,
422     *,
423     split: str | None = None,
424     source: Any = None,
425     alternatives: list[str] | None = None,
426 ) -> dict[str, Any] | None:
427     rxns = alternatives if alternatives is not None else _alternatives(rxn)
428     if not rxns:
429         return None
430     return {
431         "id": str(idx),
432         "rxn": rxns[0],
433         "mapped_rxns": rxns,
434         "split": split,
435         "original_split": split,
436         "source": None if pd.isna(source) else source,
437         "num_mappings": len(rxns),
438     }
439 
440 
441 def _from_frame(
442     df: pd.DataFrame,
443     rxn_col: str,
444     *,
445     split: str | None = None,
446     id_col: str | None = None,
447     source_col: str | None = None,
448 ) -> list[dict[str, Any]]:
449     items = []
450     for i, row in df.iterrows():
451         item = _item(
452             row[id_col] if id_col and id_col in df.columns else i,
453             row[rxn_col],
454             split=split,
455             source=row[source_col] if source_col and source_col in df.columns else None,
456         )
457         if item is not None:
458             items.append(item)
459     return items
460 
461 
462 def _from_line_file(path: Path, *, split: str, id_prefix: str | None = None) -> list[dict[str, Any]]:
463     items = []
464     with path.open() as f:
465         for i, line in enumerate(f):
466             rxns = _alternatives(line.rstrip("\n\r"))
467             idx = f"{id_prefix}:{i}" if id_prefix else i
468             item = _item(idx, None, split=split, alternatives=rxns)
469             if item is not None:
470                 items.append(item)
471     return items
472 
473 
474 def _from_semicolon_file(path: Path, *, split: str, id_prefix: str | None = None) -> list[dict[str, Any]]:
475     items = []
476     with path.open() as f:
477         for i, line in enumerate(f):
478             line = line.rstrip("\n\r")
479             if not line:
480                 continue
481             idx, payload = line.split(";", 1) if ";" in line else (i, line)
482             idx = f"{id_prefix}:{idx}" if id_prefix else idx
483             item = _item(idx, None, split=split, alternatives=_alternatives(payload))
484             if item is not None:
485                 items.append(item)
486     return items
