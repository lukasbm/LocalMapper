19 def load_templates(files, samp_iter):
20     loaded_templates = set()
21     for i, file in enumerate(files):
22         iteration = int(file.split('_')[-1].split('.')[0])
23         if iteration > samp_iter:
24             continue
25         df = pd.read_csv(file)
26         loaded_templates.update(df['template'].tolist())
27     return loaded_templates
28     
29 def load_fixed_templates(dataset, chemist_name, samp_iter):
30     pred_temps = load_templates(glob.glob('../data/%s/%s/pred_train_*.csv' % (dataset, chemist_name)), samp_iter-1)
31     accepted_temps = load_templates(glob.glob('../data/%s/%s/fixed_train_*.csv' % (dataset, chemist_name)), samp_iter-1)
32     conf_temps = load_templates(glob.glob('../data/%s/%s/conf_pred_*.csv' % (dataset, chemist_name)), samp_iter)
33     accepted_temps = accepted_temps.union(conf_temps)
34     rejected_temps = set([temp for temp in pred_temps if temp not in accepted_temps])
35     return accepted_temps, rejected_temps
