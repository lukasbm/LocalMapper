596 def _dataset_key(dataset: str) -> str:
597     return dataset.lower().replace("-", "_")
598 
599 
600 def create_reaction_dataset(
601     dataset: str,
602     mol_to_graph,
603     *,
604     data_root: str | Path = "data",
605     include_labels: bool = True,
606 ) -> ReactionDataset:
607     dataset_cls = DATASETS.get(_dataset_key(dataset))
608     if dataset_cls is None:
609         raise ValueError(f"Unknown dataset: {dataset}")
610     dataset_obj = dataset_cls(
611         mol_to_graph,
612         data_root=data_root,
613         include_labels=include_labels,
614     )
615     return dataset_obj
