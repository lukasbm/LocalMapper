 26 def set_extractor(setting):
 27     global \
 28         VERBOSE, \
 29         USE_STEREOCHEMISTRY, \
 30         USE_ATOM_SYMBOL, \
 31         LEAST_ATOM_NUM, \
 32         INCLUDE_NEIGHBORS, \
 33         MAXIMUM_NUMBER_UNMAPPED_PRODUCT_ATOMS, \
 34         RETRO, \
 35         REMOTE
 36     VERBOSE = setting["verbose"]  # False
 37     USE_STEREOCHEMISTRY = setting["use_stereo"]  # False
 38     USE_ATOM_SYMBOL = setting["use_symbol"]  # False
 39     LEAST_ATOM_NUM = setting["least_atom_num"]
 40     INCLUDE_NEIGHBORS = setting["include_neighbors"]
 41     MAXIMUM_NUMBER_UNMAPPED_PRODUCT_ATOMS = setting["max_unmap"]  # 5
 42     RETRO = setting["retro"]
 43     REMOTE = setting["remote"]
 44     return
