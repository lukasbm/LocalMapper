 47 def clean_map_and_sort(smiles_list, product_maps=[], return_mols=False):
 48     mols = []
 49     for smiles in smiles_list:
 50         if not smiles:
 51             continue
 52         mol = Chem.MolFromSmiles(smiles)
 53         [
 54             atom.SetAtomMapNum(0)
 55             for atom in mol.GetAtoms()
 56             if atom.GetAtomMapNum() not in product_maps
 57         ]
 58         mols.append(mol)
 59     #         mols.append(Chem.MolFromSmiles(Chem.MolToSmiles(mol)))
 60     mols = sorted(mols, key=lambda m: m.GetNumAtoms(), reverse=True)
 61     if return_mols:
 62         return mols
 63     else:
 64         return [Chem.MolToSmiles(mol) for mol in mols]
