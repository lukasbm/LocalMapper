 13 def prediction2map(rxn, prediction, neighbor_weight=10):
 14     reactant, product = rxn.split('>>')
 15     product_mapping = {atom.GetIdx(): atom.GetAtomMapNum() for atom in Chem.MolFromSmiles(product).GetAtoms()}
 16     if 0 in product_mapping.values():
 17         product_mapping = {atom.GetIdx(): atom.GetIdx()+1 for atom in Chem.MolFromSmiles(product).GetAtoms()}
 18     mapper = AtomMapper(rxn, prediction, product_mapping, neighbor_weight)
 19     mapped_rxn = mapper.generate_atom_mapping()
 20     try:
 21         template = extract_from_reaction(mapped_rxn)
 22     except:
 23         template = None
 24     return {'mapped_rxn': mapped_rxn, 'template': template}
 25         
 26 
 27 class AtomMapper:
 28     def __init__(
 29         self,
 30         rxn_smiles: str,
 31         predictions: np.ndarray,
 32         fixed_product_mapping,
 33         neighbor_weight,
 34         mask_mapped_product_atoms: bool = True,
 35         mask_mapped_reactant_atoms: bool = True):
 36         
 37         self.reactant, self.product = rxn_smiles.split('>>')
 38         self.predictions = predictions
 39         self.fixed_product_mapping = fixed_product_mapping
 40         self.reactant_mapping = {}
 41         self.product_mapping = {}
 42         
 43         self.neighbor_weight = neighbor_weight
 44         self.mask_mapped_product_atoms = mask_mapped_product_atoms
 45         self.mask_mapped_reactant_atoms = mask_mapped_reactant_atoms
 46         self.map_steps = None
 47         
 48         self.mask_prediction()
 49         self.get_adj_matrix()
 50         
 51 
 52     def mask_prediction(self):
 53         self.reactant_mol, self.product_mol = Chem.MolFromSmiles(self.reactant), Chem.MolFromSmiles(self.product)
 54         self.patoms, self.ratoms = Chem.MolFromSmiles(self.product).GetAtoms(),  Chem.MolFromSmiles(self.reactant).GetAtoms()
 55         self.n_patoms, self.n_ratoms = len(self.patoms), len(self.ratoms)
 56         psymbols, rsymbols = [atom.GetSymbol() for atom in self.patoms], [atom.GetSymbol() for atom in self.ratoms]
 57         self.atom_mask = np.array([[rsymbol == psymbol for rsymbol in rsymbols] for psymbol in psymbols]).astype(int)
 58         self.masked_predictions = np.multiply(self.predictions, self.atom_mask)
 59         self.neighbor_weight_matrix = np.ones_like(self.atom_mask).astype(float)
 60         return 
 61     
 62     def get_adj_matrix(self):
 63         self.p_adj_matrix = np.array(Chem.GetAdjacencyMatrix(self.product_mol), "bool")
 64         self.r_adj_matrix = np.array(Chem.GetAdjacencyMatrix(self.reactant_mol), "bool")
 65         self.isolated_carbons = np.zeros(self.n_ratoms, dtype=bool)
 66         self.isolated_carbons[[atom.GetSymbol() == 'C' for atom in self.ratoms]] = True
 67         
 68         self.r_mol_matrix = np.array(Chem.GetDistanceMatrix(self.reactant_mol)) < 100
 69         self.r_mol_matrix[[atom.GetSymbol() == 'C' for atom in self.ratoms]] = False
 70         self.mapped_molecules = np.zeros(self.n_ratoms, dtype=bool)
 71         return 
 72 
 73     def _get_normailzed_predictions(self, predictions):
 74         
 75         row_sums = predictions.sum(axis=1)
 76         column_sums = predictions.sum(axis=0)
 77         row_normalized = np.divide(
 78             predictions, row_sums[:, np.newaxis], 
 79             out=np.zeros_like(predictions), where=row_sums[:, np.newaxis] != 0
 80         )
 81         column_normalized = np.divide(
 82             predictions, column_sums[np.newaxis, :],
 83             out=np.zeros_like(predictions), where=column_sums[np.newaxis, :] != 0
 84         )
 85         normalized_predictions = row_normalized*column_normalized
 86         
 87         # prevent hopping AAM
 88         low_score = np.max(predictions, axis=0) < 0.5
 89         if self.neighbor_weight < 90:
 90             normalized_predictions[:, low_score+self.isolated_carbons] *= 0.01
 91         else:
 92             normalized_predictions[:, low_score] *= 0.01
 93         
 94         # in case of multiple reagents
 95         normalized_predictions[:, self.mapped_molecules] *= 0.99
 96         
 97         return normalized_predictions
 98     
 99     def _get_combined_normalized_predictions(self):
100         combined_predictions = np.multiply(self.masked_predictions, self.neighbor_weight_matrix)
101         return self._get_normailzed_predictions(combined_predictions)
102 
103     def generate_atom_mapping(self):
104         pxr_mapping_vector = (np.ones(self.n_patoms) * -1).astype(int)
105         scores = np.ones(self.n_patoms)
106         mapping_steps = []
107         for i in range(self.n_patoms):
108             normalized_predictions = self._get_combined_normalized_predictions()
109             product_atom_to_map = np.argmax(np.max(normalized_predictions, axis=1))
110             corresponding_reactant_atom = np.argmax(normalized_predictions, axis=1)[product_atom_to_map]
111             score = np.max(normalized_predictions, axis=1)[product_atom_to_map]
112                 
113             if np.isclose(score, 0.0):
114                 score = 1.0
115                 corresponding_reactant_atom = pxr_mapping_vector[product_atom_to_map]  # either -1 or already mapped
116                 break
117 
118             pxr_mapping_vector[product_atom_to_map] = corresponding_reactant_atom
119             scores[product_atom_to_map] = score
120             
121             self._update_neighbor_weight_matrix(product_atom_to_map, corresponding_reactant_atom)
122             if self.fixed_product_mapping:
123                 map_number = self.fixed_product_mapping[product_atom_to_map]
124             else:
125                 map_number = i+1
126                 
127             mapping_steps.append([str(map_number), str(product_atom_to_map), str(corresponding_reactant_atom), round(score, 3)])
128             self.product_mapping[int(product_atom_to_map)], self.reactant_mapping[int(corresponding_reactant_atom)] = map_number, map_number
129         
130         self.map_steps = pd.DataFrame({t[0]: t[1:] for t in mapping_steps}, index=['product_idx', 'reactant_idx', 'score'])
131         mapped_rxn = self.map_on_rxn(self.reactant_mapping, self.product_mapping)
132 
133         return mapped_rxn
134     
135     def _update_neighbor_weight_matrix(self, product_atom, reactant_atom):
136         if reactant_atom != -1:
137             # Neighbor atoms
138             neighbors_in_products = self.p_adj_matrix[product_atom]
139             neighbors_in_reactants = self.r_adj_matrix[reactant_atom]
140             self.neighbor_weight_matrix[np.ix_(neighbors_in_products, neighbors_in_reactants)] *= float(self.neighbor_weight)
141             
142             self.isolated_carbons[reactant_atom] = False
143             self.isolated_carbons[neighbors_in_reactants] = False
144             # Mapped molecules
145             self.mapped_molecules[self.r_mol_matrix[reactant_atom]] = True
146             
147         if self.mask_mapped_product_atoms:
148             self.neighbor_weight_matrix[product_atom] = np.zeros(self.n_ratoms)
149         if self.mask_mapped_reactant_atoms:
150             self.neighbor_weight_matrix[:,reactant_atom] = np.zeros(self.n_patoms)
151         return 
152     
153     def map_on_rxn(self, reactant_mapping, product_mapping):
154         self.mapped_reactant = copy.copy(self.reactant_mol)
155         self.mapped_product = copy.copy(self.product_mol)
156         [atom.SetAtomMapNum(reactant_mapping[atom.GetIdx()]) if atom.GetIdx() in reactant_mapping else atom.SetAtomMapNum(0) for atom in self.mapped_reactant.GetAtoms()]
157         [atom.SetAtomMapNum(product_mapping[atom.GetIdx()])  if atom.GetIdx() in product_mapping else atom.SetAtomMapNum(0) for atom in self.mapped_product.GetAtoms()]
158         
159         return '>>'.join(Chem.MolToSmiles(smiles, canonical = False) for smiles in [self.mapped_reactant, self.mapped_product])
