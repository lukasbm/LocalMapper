441 def confident_pseudo_items(
442     root: str | Path,
443     dataset: str,
444     model_name: str,
445     seed: int,
446     iteration: int,
447     split: str,
448     per_template: int,
449 ) -> list[dict[str, Any]]:
450     if iteration <= 1 or per_template <= 0:
451         return []
452 
453     pred_path = prediction_path(root, dataset, model_name, seed, split, iteration - 1)
454     if not pred_path.exists():
455         return []
456 
457     known_templates = verified_templates(root, dataset, model_name, seed, iteration - 1)
458     if not known_templates:
459         return []
460 
461     predictions = pd.read_csv(pred_path, dtype={"data_idx": str})
462     if predictions.empty:
463         return []
464 
465     annotations = load_annotations(root, dataset, model_name, seed, iteration)
466     annotated_ids = (
467         set(annotations["data_idx"].astype(str)) if not annotations.empty else set()
468     )
469     predictions = predictions[
470         predictions["template"].fillna("").isin(known_templates)
471         & ~predictions["data_idx"].astype(str).isin(annotated_ids)
472     ].copy()
473     if "invalid_mapping" in predictions:
474         invalid = predictions["invalid_mapping"].astype(str).str.lower()
475         predictions = predictions[~invalid.isin({"true", "1", "yes"})].copy()
476     predictions = predictions[
477         predictions["mapped_rxn"].map(reaction_passes_paper_filters)
478     ].copy()
479     if predictions.empty:
480         return []
481 
482     sampled = []
483     rng = np.random.default_rng(seed + 10_000 + iteration)
484     for _, group in predictions.groupby("template"):
485         n = min(per_template, len(group))
486         chosen = group.sample(n=n, random_state=int(rng.integers(0, 2**31 - 1))).copy()
487         if len(group) <= per_template:
488             chosen["weight"] = PSEUDO_TEMPLATE_TOTAL_WEIGHT / max(len(chosen), 1)
489             chosen["train_split"] = "train"
490         else:
491             chosen["weight"] = 1.0
492             chosen["train_split"] = "train"
493             n_val = max(1, int(round(len(chosen) * 0.1)))
494             val_indices = chosen.sample(
495                 n=n_val, random_state=int(rng.integers(0, 2**31 - 1))
496             ).index
497             chosen.loc[val_indices, "train_split"] = "val"
498         sampled.append(chosen)
499     pseudo = pd.concat(sampled, ignore_index=True) if sampled else pd.DataFrame()
500     return [
501         {
502             "id": str(row["data_idx"]),
503             "rxn": row["mapped_rxn"],
504             "split": row.get("split", split),
505             "source": row.get("source"),
506             "num_mappings": row.get("num_mappings", 1),
507             "weight": float(row["weight"]),
508             "train_split": row["train_split"],
509             "label_source": "confident_prediction",
510         }
511         for _, row in pseudo.iterrows()
512     ]
513 

