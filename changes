131 def load_train_val_dataloaders_from_items(
132     items,
133     mol_to_graph,
134     batch_size=16,
135     val_fraction=0.1,
136     seed=0,
137 ):
138     import numpy as np
139 
140     items = list(items)
141     if not items:
142         raise ValueError("No training items available")
143 
144     if any("train_split" in item for item in items):
145         train_items = [item for item in items if item.get("train_split") != "val"]
146         val_items = [item for item in items if item.get("train_split") == "val"]
147     else:
148         rng = np.random.default_rng(seed)
149         order = rng.permutation(len(items))
150         n_val = int(round(len(items) * val_fraction))
151         val_ids = set(order[:n_val])
152 
153         train_items = [item for i, item in enumerate(items) if i not in val_ids]
154         val_items = [item for i, item in enumerate(items) if i in val_ids]
155     if not train_items:
156         train_items, val_items = items, []
157 
158     train_dataset = ReactionDataset.from_items(
159         train_items,
160         mol_to_graph,
161         include_labels=True,
162     )
163     val_dataset = ReactionDataset.from_items(
164         val_items,
165         mol_to_graph,
166         include_labels=True,
167     )
168     train_loader = DataLoader(
169         train_dataset,
170         batch_size=batch_size,
171         shuffle=True,
172         collate_fn=collate_reaction_batch,
173     )
174     val_loader = DataLoader(
175         val_dataset,
176         batch_size=batch_size,
177         shuffle=False,
178         collate_fn=collate_reaction_batch,
179     )
180     return train_loader, val_loader
181 
