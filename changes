212 def sample_annotations(
213     root: str | Path,
214     dataset: str,
215     model_name: str,
216     seed: int,
217     iteration: int,
218     split: str,
219     sample_limit: int,
220     *,
221     data_root: str | Path,
222     val_fraction: float,
223     test_fraction: float,
224     items: list[dict[str, Any]] | None = None,
225     max_candidates: int | None = None,
226 ) -> pd.DataFrame:
227     if items is None:
228         items = load_dataset_split(
229             dataset,
230             split,
231             data_root=data_root,
232             seed=seed,
233             val_fraction=val_fraction,
234             test_fraction=test_fraction,
235             max_candidates=max_candidates,
236         )
237     all_items = _item_frame(items)
238     if all_items.empty:
239         return all_items
240 
241     previous_annotations = load_annotations(
242         root, dataset, model_name, seed, iteration - 1
243     )
244     annotated_ids = (
245         set(previous_annotations["data_idx"].astype(str))
246         if not previous_annotations.empty
247         else set()
248     )
249     available = all_items[~all_items["data_idx"].astype(str).isin(annotated_ids)].copy()
250     if available.empty:
251         return available
252 
253     rng = np.random.default_rng(seed + iteration)
254     sample_limit = min(sample_limit, len(available))
255     selected_ids: list[str] = []
256     selection_reasons: dict[str, str] = {}
257     predicted_templates: dict[str, str | None] = {}
258 
259     if iteration > 1:
260         pred_path = prediction_path(
261             root, dataset, model_name, seed, split, iteration - 1
262         )
263         known_templates = verified_templates(
264             root, dataset, model_name, seed, iteration - 1
265         )
266         rejected = rejected_templates(
267             root,
268             dataset,
269             model_name,
270             seed,
271             split,
272             through_prediction_iteration=iteration - 2,
273             through_annotation_iteration=iteration - 1,
274         )
275         if pred_path.exists():
276             predictions = pd.read_csv(pred_path, dtype={"data_idx": str})
277             predictions = predictions[
278                 predictions["data_idx"].isin(set(available["data_idx"].astype(str)))
279             ].copy()
280             predictions["template"] = predictions["template"].astype("string")
281             uncertain = predictions[
282                 ~predictions["template"].fillna("").isin(known_templates | rejected)
283             ].copy()
284             if not uncertain.empty:
285                 groups = uncertain.groupby("template", dropna=False)
286                 group_keys = sorted(
287                     groups.groups.keys(),
288                     key=lambda key: len(groups.groups[key]),
289                     reverse=True,
290                 )
291                 for key in group_keys:
292                     if len(selected_ids) >= sample_limit:
293                         break
294                     group = groups.get_group(key)
295                     chosen = group.sample(
296                         n=1, random_state=int(rng.integers(0, 2**31 - 1))
297                     ).iloc[0]
298                     data_idx = str(chosen["data_idx"])
299                     selected_ids.append(data_idx)
300                     selection_reasons[data_idx] = "uncertain_template"
301                     predicted_templates[data_idx] = (
302                         None if pd.isna(chosen["template"]) else str(chosen["template"])
303                     )
304 
305     if len(selected_ids) < sample_limit:
306         remaining = available[~available["data_idx"].astype(str).isin(selected_ids)]
307         fill = remaining.sample(
308             n=sample_limit - len(selected_ids),
309             random_state=int(rng.integers(0, 2**31 - 1)),
310         )
311         fill_ids = fill["data_idx"].astype(str).tolist()
312         selected_ids.extend(fill_ids)
313         for data_idx in fill_ids:
314             selection_reasons[data_idx] = "random"
315 
316     selected = available[available["data_idx"].astype(str).isin(selected_ids)].copy()
317     order = {data_idx: i for i, data_idx in enumerate(selected_ids)}
318     selected["_order"] = selected["data_idx"].astype(str).map(order)
319     selected = selected.sort_values("_order").drop(columns=["_order"])
320     selected.insert(0, "iteration", iteration)
321     selected["template"] = [
322         template_for(rxn)
323         for rxn in _progress(selected["mapped_rxn"], desc="Extracting annotation templates")
324     ]
325     selected["selection_reason"] = [
326         selection_reasons.get(str(data_idx), "random")
327         for data_idx in selected["data_idx"]
328     ]
329     selected["predicted_template"] = [
330         predicted_templates.get(str(data_idx)) for data_idx in selected["data_idx"]
331     ]
332     selected["rejected_template_memory_size"] = len(
333         rejected_templates(
334             root,
335             dataset,
336             model_name,
337             seed,
338             split,
339             through_prediction_iteration=iteration - 1,
340             through_annotation_iteration=iteration,
341         )
342     )
343     return selected
344 
