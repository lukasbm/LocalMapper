 67 def replace_deuterated(smi):
 68     return re.sub("\[2H\]", r"[H]", smi)
 69 
 70 
 71 def clear_mapnum(mol):
 72     [
 73         a.ClearProp("molAtomMapNumber")
 74         for a in mol.GetAtoms()
 75         if a.HasProp("molAtomMapNumber")
 76     ]
 77     return mol
