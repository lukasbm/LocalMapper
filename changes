360 def save_annotations(
361     root: str | Path,
362     dataset: str,
363     model_name: str,
364     seed: int,
365     iteration: int,
366     annotations: pd.DataFrame,
367 ) -> Path:
368     path = annotation_path(root, dataset, model_name, seed, iteration)
369     mkdir_p(path.parent)
370     annotations.to_csv(path, index=False)
371     save_verified_template_library(root, dataset, model_name, seed, iteration)
