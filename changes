233 @lru_cache(maxsize=100_000)
234 def cgr_signature(rxn: str) -> str | None:
235     if not _use_cgrtools_comparison():
236         return None
237 
238     if _use_isolated_cgrtools_comparison():
239         return _cgr_signature_isolated(rxn)
240 
241     timeout = _cgr_timeout_seconds()
242     use_alarm = timeout > 0 and threading.current_thread() is threading.main_thread()
243     previous_handler = None
244     try:
245         if use_alarm:
246             previous_handler = signal.getsignal(signal.SIGALRM)
247             signal.signal(signal.SIGALRM, _handle_cgr_timeout)
248             signal.setitimer(signal.ITIMER_REAL, timeout)
249         return _cgr_signature_direct(rxn)
250     except Exception:
251         return None
252     finally:
253         if use_alarm:
254             signal.setitimer(signal.ITIMER_REAL, 0)
255             signal.signal(signal.SIGALRM, previous_handler)
