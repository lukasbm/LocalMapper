182 def _load_cgr_smiles_reader():
183     try:
184         from CGRtools import SMILESRead
185 
186         return SMILESRead
187     except Exception:
188         try:
189             from CGRtools.files import SMILESRead
190 
191             return SMILESRead
192         except Exception:
193             return None
