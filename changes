480 def _dataset_key(dataset: str) -> str:
481     return dataset.lower().replace("-", "_")
482 
483 
484 def create_reaction_dataset(
485     dataset: str,
486     mol_to_graph,
487     *,
488     data_root: str | Path = "data",
489     include_labels: bool = True,
490 ) -> ReactionDataset:
491     dataset_cls = DATASETS.get(_dataset_key(dataset))
492     if dataset_cls is None:
493         raise ValueError(f"Unknown dataset: {dataset}")
494     dataset_obj = dataset_cls(
495         mol_to_graph,
496         data_root=data_root,
497         include_labels=include_labels,
498     )
499     return dataset_obj
