903     dataset: str,
904     *,
905     data_root: str | Path = "data",
906 ) -> list[dict[str, Any]]:
907     # For code that only needs the reaction list, not graph construction.
908     return create_reaction_dataset(dataset, lambda mol: mol, data_root=data_root).items
