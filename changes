154 def clean_reactant_map(rxn):
155     r, p = rxn.split(">>")
156     r_mol = Chem.MolFromSmiles(r)
157     [atom.SetAtomMapNum(0) for atom in r_mol.GetAtoms()]
158     r = Chem.MolToSmiles(r_mol, canonical=False)
159     return ">>".join([r, p])
160 
161 
162 def canonicalize_map_rxn(rxn):
163     new_rxn = []
164     for smi in rxn.split(">>"):
165         mol = Chem.MolFromSmiles(smi)
166         index2mapnums = {}
167         for atom in mol.GetAtoms():
168             index2mapnums[atom.GetIdx()] = atom.GetAtomMapNum()
169         mol_cano = Chem.RWMol(mol)
170         [atom.SetAtomMapNum(0) for atom in mol_cano.GetAtoms()]
171         smi_cano = Chem.MolToSmiles(mol_cano)
172         mol_cano = Chem.MolFromSmiles(smi_cano)
173         match = mol.GetSubstructMatch(mol_cano)
174         if match:
175             for atom, mat in zip(mol_cano.GetAtoms(), match):
176                 atom.SetAtomMapNum(index2mapnums[mat])
177             smi = Chem.MolToSmiles(mol_cano, canonical=False)
178         new_rxn.append(smi)
179     return ">>".join(new_rxn)
