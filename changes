 94 @lru_cache(maxsize=100_000)
 95 def has_confusing_reagent(rxn: str, tanimoto_threshold: float = 0.5) -> bool:
 96     r, p = _reaction_mols(rxn)
 97     if r is None or p is None:
 98         return True
 99 
100     product_maps = _mapped_product_maps(p)
101     product_fp = _morgan_fp(p)
102     if product_fp is None:
103         return True
104 
105     try:
106         reactants = Chem.GetMolFrags(r, asMols=True, sanitizeFrags=True)
107     except Exception:
108         reactants = Chem.GetMolFrags(r, asMols=True, sanitizeFrags=False)
109     for reactant in reactants:
110         reactant_maps = {
111             atom.GetAtomMapNum()
112             for atom in reactant.GetAtoms()
113             if atom.GetAtomMapNum() > 0
114         }
115         if reactant_maps & product_maps:
116             continue
117         reactant_fp = _morgan_fp(reactant)
118         if reactant_fp is None:
119             continue
120         if DataStructs.TanimotoSimilarity(reactant_fp, product_fp) >= tanimoto_threshold:
121             return True
122     return False
123 
