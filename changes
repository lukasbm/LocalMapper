 18 def mkdir_p(path):
 19     try:
 20         os.makedirs(path)
 21     except OSError as exc:
 22         if exc.errno == errno.EEXIST and os.path.isdir(path):
 23             pass
 24         else:
 25             raise
 26 
 27 def get_adm(mol, max_distance = 4):
 28     dm = Chem.GetDistanceMatrix(mol)
 29     dm[dm > 100] = -1 # remote (different molecule)
 30     dm[dm > max_distance] = max_distance + 1 # remote (same molecule)
 31     dm[dm == -1] = max_distance + 2 # remote (different molecule)
 32     return dm
 33 
 34 def product_is_unmapped(rxn):
 35     r, p = [Chem.MolFromSmiles(smi) for smi in rxn.split('>>')]
 36     rmaps = [atom.GetAtomMapNum() for atom in r.GetAtoms()]
 37     pmaps = [atom.GetAtomMapNum() for atom in p.GetAtoms()]
 38     return 0 in pmaps or sum([m not in rmaps for m in pmaps]) > 0
 39 
 40 def get_mapping_label(rxn):
 41 #     print (rxn)
 42     rsmi, psmi = rxn.split('>>')
 43     rmol = Chem.MolFromSmiles(rsmi)
 44     pmol = Chem.MolFromSmiles(psmi)
 45     r_atom_dict = {atom.GetAtomMapNum(): atom.GetIdx() for atom in rmol.GetAtoms()}
 46     return [r_atom_dict[atom.GetAtomMapNum()] for atom in pmol.GetAtoms()]
 47 
 48 def clean_reactant_map(rxn):
 49     r, p = rxn.split('>>')
 50     r_mol = Chem.MolFromSmiles(r)
 51     [atom.SetAtomMapNum(0) for atom in r_mol.GetAtoms()]
 52     r = Chem.MolToSmiles(r_mol, canonical = False)
 53     return '>>'.join([r, p])
 54 
 55 def canonicalize_map_rxn(rxn):
 56     new_rxn = []
 57     for smi in rxn.split('>>'):
 58         mol = Chem.MolFromSmiles(smi)
 59         index2mapnums = {}
 60         for atom in mol.GetAtoms():
 61             index2mapnums[atom.GetIdx()] = atom.GetAtomMapNum()
 62         mol_cano = Chem.RWMol(mol)
 63         [atom.SetAtomMapNum(0) for atom in mol_cano.GetAtoms()]
 64         smi_cano = Chem.MolToSmiles(mol_cano)
 65         mol_cano = Chem.MolFromSmiles(smi_cano)
 66         matches = mol.GetSubstructMatches(mol_cano)
 67         if matches:
 68             for atom, mat in zip(mol_cano.GetAtoms(), matches[0]):
 69                 atom.SetAtomMapNum(index2mapnums[mat])
 70             smi = Chem.MolToSmiles(mol_cano, canonical=False)
 71         new_rxn.append(smi)
 72     return '>>'.join(new_rxn)
 73 
 74 class ReactionDataset(object):
 75     def __init__(self, args):
 76         df = pd.read_csv('%s/raw_data.csv' % (args['data_dir']))
 77         self.mode = args['mode']
 78         self.rxns = df['mapped_rxn'].tolist()
 79         self.idxs = [idx for idx in range(len(self.rxns))]
 80         self.labels = [[] for _ in range(len(self.rxns))]
 81         self.weights = [1]*len(self.rxns)
 82         self.mol_to_graph = args['mol_to_graph']
 83         if self.mode == 'train':
 84             self._load_conf_rxns(args)
 85             self._make_graphs()
 86         else:
 87             self.train_idx, self.val_idx, self.test_idx = [], [], self.idxs
 88         
 89         
 90     def _load_conf_rxns(self, args):
 91         print ('Preparing AAM labels...')
 92         train_idx, val_idx = set(), set()
 93         mapped_rxns = {}
 94         for i in range(args['iteration']):
 95             manual_df = pd.read_csv('%s/%s/fixed_train_%d.csv' % (args['data_dir'], args['chemist_name'], i+1))
 96             for idx, rxn in zip(manual_df['data_idx'], manual_df['mapped_rxn']):
 97                 train_idx.add(idx)
 98                 mapped_rxns[idx] = rxn
 99                 self.weights[idx] = 100
100         print ('Load %d reactions from fixed predictions' % len(mapped_rxns))
101                
102         conf_df = pd.read_csv('%s/%s/conf_pred_%d.csv' % (args['data_dir'], args['chemist_name'], args['iteration']))
103         templates_idx = defaultdict(list)
104         for i in conf_df.index:
105             data_idx = conf_df['data_idx'][i]
106             template = conf_df['template'][i]
107             rxn = conf_df['mapped_rxn'][i]
108             if data_idx not in train_idx and not product_is_unmapped(rxn):
109                 templates_idx[template].append(i)
110                 mapped_rxns[data_idx] = rxn
111         print ('Load %d templates with total %d reactions from confident predictions' % (len(templates_idx), len(conf_df)))
112                
113             
114         for template, idx_list in templates_idx.items():
115             if len(idx_list) > 100:
116                 sample_size = 100
117                 add_to_val = True
118                 template_weight = 1
119             else:
120                 sample_size = len(idx_list)
121                 add_to_val = False
122                 template_weight = 100/sample_size
123             np.random.shuffle(idx_list)
124             sampled_idx_list = idx_list[:sample_size]
125             data_idxs = [conf_df['data_idx'][i] for i in sampled_idx_list]
126             if add_to_val:
127                 train_idx.update(data_idxs[:90])
128                 val_idx.update(data_idxs[90:])
129             else:
130                 train_idx.update(data_idxs)
131             for idx in data_idxs:
132                 self.weights[idx] = template_weight
133         print ('Sampled %d train reaction, %d val reactions' % (len(train_idx), len(val_idx)))
134                
135         for idx, rxn in mapped_rxns.items():
136             self.rxns[idx] = rxn
137             self.labels[idx] = get_mapping_label(rxn)
138         self.train_idx, self.val_idx, self.test_idx = list(train_idx), list(val_idx), []
139         return 
140 
141     def _make_graphs(self):
142         self.rgraphs, self.pgraphs = [], []
143         for i, rxn in tqdm(enumerate(self.rxns), total = len(self.rxns), desc = 'Generating molecule graphs...'):
144             if i not in self.train_idx+self.val_idx:
145                 self.rgraphs.append(None)
146                 self.pgraphs.append(None)
147             else:
148                 r, p = rxn.split('>>')
149                 r, p = Chem.MolFromSmiles(r), Chem.MolFromSmiles(p)
150                 self.rgraphs.append(self.mol_to_graph(r))
151                 self.pgraphs.append(self.mol_to_graph(p))
152         return 
153 
154     def __getitem__(self, item):
155         rxn = self.rxns[item]
156         if self.mode == 'train':
157             rgraph, pgraph = self.rgraphs[item], self.pgraphs[item]
158         else:
159             if len(rxn.split('>>')) != 2: # in case of bad reaction
160                 item = 1
161                 rxn = self.rxns[item]
162             r, p = rxn.split('>>')
163             r, p = Chem.MolFromSmiles(r), Chem.MolFromSmiles(p)
164             rgraph, pgraph = self.mol_to_graph(r), self.mol_to_graph(p)
165         return self.idxs[item], rxn, rgraph, pgraph, self.labels[item], self.weights[item]
166 
167     def __len__(self):
168             return len(self.rxns)
169 

scripts/debug_cgrtools.py --- Python
 1 from __future__ import annotations
 2 
 3 import csv
 4 import time
 5 from pathlib import Path
 6 
 7 import fire
 8 
 9 from localmapper.dataset import cgr_signature, mapping_comparison_backend
10 
11 
12 def _iter_reactions(path: Path | None, column: str, limit: int | None):
13     if path is None:
14         yield "[CH3:1][OH:2]>>[CH3:1][Cl:2]"
15         return
16 
17     with path.open() as handle:
18         reader = csv.DictReader(handle)
19         for i, row in enumerate(reader):
20             if limit is not None and i >= limit:
21                 break
22             rxn = row.get(column)
23             if rxn:
24                 yield rxn
25 
26 
27 def main(path=None, column="mapped_rxn", limit=20):
28     path = Path(path) if path else None
29     print(f"backend={mapping_comparison_backend()}")
30     for i, rxn in enumerate(_iter_reactions(path, column, limit)):
31         start = time.perf_counter()
32         signature = cgr_signature(rxn)
33         elapsed = time.perf_counter() - start
34         status = "ok" if signature is not None else "none"
35         print(f"{i}\t{status}\t{elapsed:.3f}s\t{rxn[:160]}")
36 
37 
38 if __name__ == "__main__":
39     fire.Fire(main)
