915     data_root: str | Path = "data",
916     seed: int = 0,
917     val_fraction: float = 0.1,
918     test_fraction: float = 0.1,
919     max_candidates: int | None = None,
920 ) -> list[dict[str, Any]]:
921     return select_split(
922         load_dataset_items(dataset, data_root=data_root),
923         split,
