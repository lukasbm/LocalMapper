14 def get_rdkit_rxn(rxn):
15     def demap(smi):
16         mol = Chem.MolFromSmiles(smi)
17         [atom.SetAtomMapNum(0) for atom in mol.GetAtoms()]
18         return Chem.MolToSmiles(mol)
19     reactant, product = rxn.split('>>')
20     rxn = demap(reactant) + '>>' + demap(product)
21     rdkit_rxn = Chem.rdChemReactions.ReactionFromSmarts(rxn, useSmiles=True)
22     return Chem.Draw.ReactionToImage(rdkit_rxn, subImgSize=(320,700), )
