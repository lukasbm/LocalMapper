198     weight_decay,
199     patience,
200     model_path,
201     init="scratch",
202     checkpoint_path=None,
203 ):
204     model = _build_model(node_featurizer, edge_featurizer, mol_to_graph, device)
205     if init == "checkpoint":
206         if checkpoint_path is None:
207             raise ValueError("checkpoint_path is required when init='checkpoint'")
208         model.load_checkpoint(checkpoint_path, device=device)
209     elif init != "scratch":
210         raise ValueError("init must be 'scratch' or 'checkpoint'")
211     loss_criterion = nn.CrossEntropyLoss()
212     optimizer = Adam(
213         model.parameters(),
214         lr=learning_rate,
215         weight_decay=weight_decay,
216     )
217     scheduler = lr_scheduler.ReduceLROnPlateau(
218         optimizer, mode="min", factor=0.5, patience=1, min_lr=1e-4
219     )
220     stopper = EarlyStopping(mode="lower", patience=patience, filename=model_path)
221     return model, loss_criterion, optimizer, scheduler, stopper
222 
223 
224 def load_test_model(node_featurizer, edge_featurizer, mol_to_graph, device, model_path):
225     model = _build_model(node_featurizer, edge_featurizer, mol_to_graph, device)
226     model.load_checkpoint(model_path, device=device)
227     return model
