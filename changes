931 def collate_reaction_batch(batch):
932     batch = [row for row in batch if row is not None]
933     idxs, rxns, rgraphs, pgraphs, labels, weights, data = zip(*batch)
934     labels_list = [torch.as_tensor(label, dtype=torch.long) for label in labels]
935     masks_list = [torch.ones_like(label, dtype=torch.long) for label in labels_list]
936     return (
937         list(idxs),
938         list(rxns),
939         list(rgraphs),
940         list(pgraphs),
941         labels_list,
942         masks_list,
943         list(weights),
944         list(data),
945     )
