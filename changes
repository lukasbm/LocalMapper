674 
675 def normalize_item_targets(
676     items: list[dict[str, Any]],
677     *,
678     progress_desc: str | None = None,
679 ) -> list[dict[str, Any]]:
680     iterator = (
681         _progress(items, desc=progress_desc, total=len(items))
682         if progress_desc
683         else items
684     )
685     return [
686         normalized
687         for item in iterator
688         if (normalized := normalize_item_target_with_timeout(item)) is not None
689     ]
690 
691 
692 def item_has_valid_mapping(item: dict[str, Any]) -> bool:
693     return any(
694         get_mapping_label(reference_rxn) is not None
695         and reaction_passes_paper_filters(reference_rxn)
696         for reference_rxn in item.get("mapped_rxns", [item["rxn"]])
697     )
698 
699 
700 def select_split(
701     items: list[dict[str, Any]],
702     split: str,
703     *,
704     seed: int = 0,
705     val_fraction: float = 0.1,
706     test_fraction: float = 0.1,
707     max_candidates: int | None = None,
708 ) -> list[dict[str, Any]]:
709     split = split.lower()
710     explicit = [item for item in items if item["split"] == split]
711     if explicit:
712         return normalize_item_targets(
713             explicit,
714             progress_desc=f"Filtering {split} mappings",
715         )
716 
717     unsplit = [item for item in items if item["split"] is None]
718     if not unsplit:
719         return []
720 
721     rng = np.random.default_rng(seed)
722     order = rng.permutation(len(unsplit))
723     n_test = int(round(len(unsplit) * test_fraction))
724     n_val = int(round(len(unsplit) * val_fraction))
725     test_ids = set(order[:n_test])
726     val_ids = set(order[n_test : n_test + n_val])
727 
728     selected = []
729     for i, item in enumerate(unsplit):
730         item_split = "test" if i in test_ids else "val" if i in val_ids else "train"
731         if item_split == split:
732             selected.append({**item, "split": item_split})
733     if max_candidates is not None and len(selected) > max_candidates:
734         selected_order = rng.permutation(len(selected))[:max_candidates]
735         selected = [selected[i] for i in selected_order]
736     return normalize_item_targets(
737         selected,
738         progress_desc=f"Filtering {split} mappings",
739     )
740 
741 
742 def load_dataset_items(
743     dataset: str,
744     *,
745     data_root: str | Path = "data",
746 ) -> list[dict[str, Any]]:
747     # For code that only needs the reaction list, not graph construction.
748     return create_reaction_dataset(dataset, lambda mol: mol, data_root=data_root).items
749 
750 
751 def load_reactions(
752     dataset: str,
753     split: str,
754     *,
755     data_root: str | Path = "data",
756     seed: int = 0,
757     val_fraction: float = 0.1,
758     test_fraction: float = 0.1,
759     max_candidates: int | None = None,
760 ) -> list[dict[str, Any]]:
761     return select_split(
762         load_dataset_items(dataset, data_root=data_root),
763         split,
764         seed=seed,
765         val_fraction=val_fraction,
766         test_fraction=test_fraction,
767         max_candidates=max_candidates,
768     )
769 
770 
771 def collate_reaction_batch(batch):
772     batch = [row for row in batch if row is not None]
773     idxs, rxns, rgraphs, pgraphs, labels, weights, data = zip(*batch)
774     labels_list = [torch.as_tensor(label, dtype=torch.long) for label in labels]
775     masks_list = [torch.ones_like(label, dtype=torch.long) for label in labels_list]
776     return (
777         list(idxs),
778         list(rxns),
779         list(rgraphs),
780         list(pgraphs),
781         labels_list,
782         masks_list,
783         list(weights),
784         list(data),
785     )
