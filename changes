375 def save_verified_template_library(
376     root: str | Path,
377     dataset: str,
378     model_name: str,
379     seed: int,
380     through_iteration: int,
381 ) -> Path:
382     annotations = load_annotations(root, dataset, model_name, seed, through_iteration)
383     path = template_library_path(root, dataset, model_name, seed, through_iteration)
384     mkdir_p(path.parent)
385     if annotations.empty:
386         pd.DataFrame(columns=["template", "count", "first_iteration"]).to_csv(
387             path, index=False
388         )
389         return path
390 
391     library = (
392         annotations.dropna(subset=["template"])
393         .groupby("template", as_index=False)
394         .agg(count=("template", "size"), first_iteration=("iteration", "min"))
395         .sort_values(["first_iteration", "template"])
396     )
397     library.to_csv(path, index=False)
398     return path
