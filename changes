415 def training_items_from_annotations(
416     root: str | Path,
417     dataset: str,
418     model_name: str,
419     seed: int,
420     through_iteration: int,
421 ) -> list[dict[str, Any]]:
422     annotations = load_annotations(root, dataset, model_name, seed, through_iteration)
423     if annotations.empty:
424         return []
425     annotations = annotations.drop_duplicates("data_idx", keep="last")
426     return [
427         {
428             "id": str(row["data_idx"]),
429             "rxn": row["mapped_rxn"],
430             "split": row.get("split"),
431             "source": row.get("source"),
432             "num_mappings": row.get("num_mappings", 1),
433             "weight": ANNOTATION_WEIGHT,
434             "train_split": "train",
435             "label_source": "annotation",
436         }
437         for _, row in annotations.iterrows()
438     ]
