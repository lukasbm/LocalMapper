182 def _load_cgr_smiles_reader():
183     try:
184         from CGRtools import SMILESRead
185 
186         return SMILESRead
187     except Exception:
188         try:
189             from CGRtools.files import SMILESRead
190 
191             return SMILESRead
192         except Exception:
193             return None
194 
195 
196 def cgrtools_available() -> bool:
197     return _load_cgr_smiles_reader() is not None
198 
199 
200 def mapping_comparison_backend() -> str:
201     return "cgrtools"
202 
203 
204 def _cgr_signature_direct(rxn: str) -> str | None:
205     if get_mapping_label(rxn) is None:
206         return None
207 
208     smiles_read = _load_cgr_smiles_reader()
209     if smiles_read is None:
210         return None
211 
212     with smiles_read(
213         StringIO(f"{rxn}\n"),
214         ignore=_cgrtools_ignore_parser_errors(),
215         store_log=bool(_cgr_debug_path()),
216     ) as reader:
217         reaction = next(iter(reader))
218         if _cgr_debug_path():
219             parser_log = reaction.meta.get("CGRtoolsParserLog", "")
220             if parser_log:
221                 _log_cgr_event("cgrtools_parser_log", rxn, detail=parser_log.replace("\n", " | "))
222     cgr = reaction.compose()
223     return str(cgr)
224 
225 
226 @lru_cache(maxsize=100_000)
227 def cgr_signature(rxn: str) -> str | None:
228     return _cgr_signature_isolated(rxn)
229 
230 
231 def mapping_signature(rxn: str) -> tuple[tuple[str, str], tuple[tuple[int, int], ...]] | None:
232     try:
233         rxn = canonicalize_map_rxn(rxn)
234         rsmi, psmi = rxn.split(">>")
235         rmol = Chem.MolFromSmiles(rsmi)
236         pmol = Chem.MolFromSmiles(psmi)
237     except Exception:
238         return None
239     if rmol is None or pmol is None:
240         return None
241 
242     r_demapped = Chem.RWMol(rmol)
243     p_demapped = Chem.RWMol(pmol)
244     for mol in (r_demapped, p_demapped):
245         for atom in mol.GetAtoms():
246             atom.SetAtomMapNum(0)
247     pattern = (
248         Chem.MolToSmiles(r_demapped, canonical=True, isomericSmiles=True),
249         Chem.MolToSmiles(p_demapped, canonical=True, isomericSmiles=True),
250     )
251 
252     reactant_map_to_idx = {
253         atom.GetAtomMapNum(): atom.GetIdx()
254         for atom in rmol.GetAtoms()
255         if atom.GetAtomMapNum() > 0
256     }
257     pairs = []
258     for product_idx, atom in enumerate(pmol.GetAtoms()):
259         map_num = atom.GetAtomMapNum()
260         if map_num <= 0 or map_num not in reactant_map_to_idx:
261             return None
262         pairs.append((product_idx, reactant_map_to_idx[map_num]))
263     return pattern, tuple(pairs)
264 
265 
266 def mappings_are_equivalent(predicted_rxn: str, reference_rxn: str) -> bool:
267     predicted_cgr = cgr_signature(predicted_rxn)
268     reference_cgr = cgr_signature(reference_rxn)
269     return predicted_cgr is not None and predicted_cgr == reference_cgr
270 
271 
272 def mapping_matches_any(predicted_rxn: str, reference_rxns: list[str]) -> bool:
273     return any(mappings_are_equivalent(predicted_rxn, reference) for reference in reference_rxns)
274 
