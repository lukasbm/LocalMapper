15 def get_special_groups(mol):
16     '''Given an RDKit molecule, this function returns a list of tuples, where
17     each tuple contains the AtomIdx's for a special group of atoms which should 
18     be included in a fragment all together. This should only be done for the 
19     reactants, otherwise the products might end up with mapping mismatches
20     We draw a distinction between atoms in groups that trigger that whole
21     group to be included, and "unimportant" atoms in the groups that will not
22     be included if another atom matches.'''
23 
24     # Define templates
25     group_templates = [ 
26         # Functional groups
27 #         (range(2), '[OH0,SH0]=C',), # carbonyl
28         (range(2), '[C,O,N]=[C,O,N]',), # alkene/imine
29         (range(2), '[C,N]#[C,N]',), # alkyne/nitrile
30 #         (range(2), '[S,O,N,P]-[S,O,N,P]',), # hetero bond
31         (range(3), 'O-C-O',), # acetal group
32         (range(3), '[OH0,SH0]=C-O',), # carbonyl acid
33         
34         # Acidic carbon/oxygen
35         ((2,), '[*]=[*]-[C;X4;!$([CX4][F,Cl,Br,I,OH])]',), # acidic carbon
36         ((2,), '[*]#[*]-[C;X4;!$([CX4][F,Cl,Br,I,OH])]',), # acidic carbon
37         ((1,), 'a-[C;X4;!$([CX4][F,Cl,Br,I,OH])]',), # acidic carbon
38         ((2,), 'a-C-O',), # adjacency to aromatic ring
39         ((1,), 'a-O',), # adjacency to aromatic ring
40         
41     ]
42     
43     # Build list
44     groups = []
45     for (add_if_match, template) in group_templates:
46         matches = mol.GetSubstructMatches(Chem.MolFromSmarts(template), useChirality=True)
47         for match in matches:
48             add_if = []
49             for pattern_idx, atom_idx in enumerate(match):
50                 if pattern_idx in add_if_match:
51                     add_if.append(atom_idx)
52             groups.append((add_if, match, template))
53     return groups
54 
55 def expand_atoms_to_use(mol, atoms_to_use, groups=[], symbol_replacements=[]):
56     '''Given an RDKit molecule and a list of AtomIdX which should be included
57     in the reaction, this function expands the list of AtomIdXs to include one 
58     nearest neighbor with special consideration of (a) unimportant neighbors and
59     (b) important functional groupings'''
60 
61     # Copy
62     new_atoms_to_use = atoms_to_use[:]
63     # Look for all atoms in the current list of atoms to use
64     for atom in mol.GetAtoms():
65         if atom.GetIdx() not in atoms_to_use: continue
66         # Ensure membership of changed atom is checked against group
67         for group in groups:
68             if int(atom.GetIdx()) in group[0]:
69                 for idx in group[1]:
70                     if idx not in new_atoms_to_use:
71                         new_atoms_to_use.append(idx)
72     return new_atoms_to_use, symbol_replacements, mol
