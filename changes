 80 def get_tagged_atoms_from_mols(mols):
 81     """Takes a list of RDKit molecules and returns total list of
 82     atoms and their tags"""
 83     atoms = []
 84     atom_tags = []
 85     for mol in mols:
 86         new_atoms, new_atom_tags = get_tagged_atoms_from_mol(mol)
 87         atoms += new_atoms
 88         atom_tags += new_atom_tags
 89     return atoms, atom_tags
 90 
 91 
 92 def get_tagged_atoms_from_mol(mol):
 93     """Takes an RDKit molecule and returns list of tagged atoms and their
 94     corresponding numbers"""
 95     atoms = []
 96     atom_tags = []
 97     for atom in mol.GetAtoms():
 98         if atom.HasProp("molAtomMapNumber"):
 99             atoms.append(atom)
100             atom_tags.append(str(atom.GetProp("molAtomMapNumber")))
101     return atoms, atom_tags
102 
103 
104 def atoms_are_different(atom1, atom2):
105     """Compares two RDKit atoms based on basic properties"""
106 
107     if atom1.GetAtomicNum() != atom2.GetAtomicNum():
108         return True  # must be true for atom mapping
109 
110         #     if atom1.GetNumRadicalElectrons() != atom2.GetNumRadicalElectrons(): return True
111     if REMOTE:
112         if atom1.GetFormalCharge() != atom2.GetFormalCharge():
113             return True
114         # may be wrong information due to wrong atom mapping
115         if atom1.GetTotalNumHs() != atom2.GetTotalNumHs():
116             return True
117 
118     # add or break bonds
119     if atom_neighbors(atom1) != atom_neighbors(atom2):
120         return True
121 
122     # change bonds
123     bonds1 = sorted([bond_to_smarts(bond) for bond in atom1.GetBonds()])
124     bonds2 = sorted([bond_to_smarts(bond) for bond in atom2.GetBonds()])
125     if bonds1 != bonds2:
126         return True
127 
128     return False
129 
130 
131 def find_map_num(mol, mapnum):
132     return [
133         (a.GetIdx(), a)
134         for a in mol.GetAtoms()
135         if a.HasProp("molAtomMapNumber")
136         and a.GetProp("molAtomMapNumber") == str(mapnum)
137     ][0]
