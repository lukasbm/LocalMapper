690 def _log_cgr_event(event: str, rxn: str, *, detail: str = ""):
691     path = _cgr_debug_path()
692     if path is None:
693         return
694     try:
695         path.parent.mkdir(parents=True, exist_ok=True)
696         with path.open("a") as handle:
697             handle.write(f"{time.time():.6f}\t{event}\t{detail}\t{rxn}\n")
698     except Exception:
699         pass
