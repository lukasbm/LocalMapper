429 def training_items_from_annotations(
430     root: str | Path,
431     dataset: str,
432     model_name: str,
433     seed: int,
434     through_iteration: int,
435 ) -> list[dict[str, Any]]:
436     annotations = load_annotations(root, dataset, model_name, seed, through_iteration)
437     if annotations.empty:
438         return []
439     annotations = annotations.drop_duplicates("data_idx", keep="last")
440     return [
441         {
442             "id": str(row["data_idx"]),
443             "rxn": row["mapped_rxn"],
444             "split": row.get("split"),
445             "source": row.get("source"),
446             "num_mappings": row.get("num_mappings", 1),
447             "weight": ANNOTATION_WEIGHT,
448             "train_split": "train",
449             "label_source": "annotation",
450         }
451         for _, row in annotations.iterrows()
452     ]
