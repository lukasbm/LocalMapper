scripts/debug_cgrtools.py --- Python
 1 from __future__ import annotations
 2 
 3 import csv
 4 import time
 5 from pathlib import Path
 6 
 7 import fire
 8 
 9 from localmapper.dataset import cgr_signature, mapping_comparison_backend
10 
11 
12 def _iter_reactions(path: Path | None, column: str, limit: int | None):
13     if path is None:
14         yield "[CH3:1][OH:2]>>[CH3:1][Cl:2]"
15         return
16 
17     with path.open() as handle:
18         reader = csv.DictReader(handle)
19         for i, row in enumerate(reader):
20             if limit is not None and i >= limit:
21                 break
22             rxn = row.get(column)
23             if rxn:
24                 yield rxn
25 
26 
27 def main(path=None, column="mapped_rxn", limit=20):
28     path = Path(path) if path else None
29     print(f"backend={mapping_comparison_backend()}")
30     for i, rxn in enumerate(_iter_reactions(path, column, limit)):
31         start = time.perf_counter()
32         signature = cgr_signature(rxn)
33         elapsed = time.perf_counter() - start
34         status = "ok" if signature is not None else "none"
35         print(f"{i}\t{status}\t{elapsed:.3f}s\t{rxn[:160]}")
36 
37 
38 if __name__ == "__main__":
39     fire.Fire(main)
40 

