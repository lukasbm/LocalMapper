..                                                                                              192 
..                                                                                              193 def _mapping_score(result):
..                                                                                              194     mapper = result.get("mapper")
..                                                                                              195     map_steps = getattr(mapper, "map_steps", None)
..                                                                                              196     if map_steps is None or map_steps.empty or "score" not in map_steps.index:
..                                                                                              197         return 0.0
..                                                                                              198     scores = pd.to_numeric(map_steps.loc["score"], errors="coerce").dropna()
..                                                                                              199     if scores.empty:
..                                                                                              200         return 0.0
..                                                                                              201     return float(scores.mean())
