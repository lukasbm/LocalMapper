..                                                                                                                    374 def main(
..                                                                                                                    375     gpu="cuda:0",
..                                                                                                                    376     batch_size=20,
..                                                                                                                    377     dataset="USPTO_50K",
..                                                                                                                    378     model="LocalMapper",
..                                                                                                                    379     iteration=1,
..                                                                                                                    380     split="train",
..                                                                                                                    381     try_twice=True,
..                                                                                                                    382     seed=0,
..                                                                                                                    383     val_fraction=0.1,
..                                                                                                                    384     test_fraction=0.1,
..                                                                                                                    385     checkpoint=None,
..                                                                                                                    386 ):
..                                                                                                                    387     device = torch.device(gpu) if torch.cuda.is_available() else torch.device("cpu")
..                                                                                                                    388     print(
..                                                                                                                    389         "Testing with device %s, dataset %s, split %s, iteration %s"
..                                                                                                                    390         % (device, dataset, split, iteration)
..                                                                                                                    391     )
..                                                                                                                    392 
..                                                                                                                    393     model_path = checkpoint or str(
..                                                                                                                    394         checkpoint_path(ROOT, dataset, model, seed, iteration)
..                                                                                                                    395     )
..                                                                                                                    396     output_path = prediction_path(ROOT, dataset, model, seed, split, iteration)
..                                                                                                                    397     metrics_path = output_path.with_name(f"metrics_{split}_{iteration}.json")
..                                                                                                                    398 
..                                                                                                                    399     node_featurizer, edge_featurizer, mol_to_graph = init_featurizer()
..                                                                                                                    400     test_loader = load_dataloader(
..                                                                                                                    401         dataset,
..                                                                                                                    402         split,
..                                                                                                                    403         mol_to_graph,
..                                                                                                                    404         batch_size=batch_size,
..                                                                                                                    405         data_root=ROOT / "data",
..                                                                                                                    406         val_fraction=val_fraction,
..                                                                                                                    407         test_fraction=test_fraction,
..                                                                                                                    408         seed=seed,
..                                                                                                                    409         include_labels=False,
..                                                                                                                    410     )
..                                                                                                                    411     mapper_model = load_test_model(
..                                                                                                                    412         node_featurizer, edge_featurizer, mol_to_graph, device, model_path
..                                                                                                                    413     )
..                                                                                                                    414     accepted_templates = verified_templates(
..                                                                                                                    415         ROOT, dataset, model, seed, through_iteration=iteration
..                                                                                                                    416     )
..                                                                                                                    417     metrics = write_predictions(
..                                                                                                                    418         output_path,
..                                                                                                                    419         metrics_path,
..                                                                                                                    420         accepted_templates,
..                                                                                                                    421         mapper_model,
..                                                                                                                    422         test_loader,
..                                                                                                                    423         try_twice,
..                                                                                                                    424     )
..                                                                                                                    425     summary_json, summary_csv = save_run_metrics_summary(
..                                                                                                                    426         output_dir(ROOT, dataset, model, seed)
