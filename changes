392 def normalize_mapped_rxn(rxn: str) -> str | None:
393     if get_mapping_label(rxn) is None or not reaction_passes_paper_filters(rxn):
394         return None
395     if os.environ.get("LOCALMAPPER_CANONICALIZE_TARGETS", "0") != "1":
396         return rxn
397     try:
398         normalized = canonicalize_map_rxn(rxn)
399     except Exception:
400         return None
401     return normalized if get_mapping_label(normalized) is not None else None
