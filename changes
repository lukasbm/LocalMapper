852 def item_has_valid_mapping(item: dict[str, Any]) -> bool:
853     return any(
854         get_mapping_label(reference_rxn) is not None
855         and reaction_passes_paper_filters(reference_rxn)
856         for reference_rxn in item.get("mapped_rxns", [item["rxn"]])
857     )
