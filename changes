373 class ReactionDataset(torch.utils.data.Dataset):
374     def __init__(
375         self,
376         mol_to_graph,
377         *,
378         data_root: str | Path = "data",
379         items: list[dict[str, Any]] | None = None,
380         include_labels: bool = True,
381     ):
382         self.mol_to_graph = mol_to_graph
383         self.include_labels = include_labels
384         self.data_root = Path(data_root)
385         self.items = self.load_items() if items is None else items
386 
387     def load_items(self) -> list[dict[str, Any]]:
388         raise NotImplementedError
389 
390     @classmethod
391     def from_items(
392         cls,
393         items: list[dict[str, Any]],
394         mol_to_graph,
395         *,
396         include_labels: bool = True,
397     ) -> "ReactionDataset":
398         return cls(mol_to_graph, items=items, include_labels=include_labels)
399 
400     def __getitem__(self, item):
401         data = self.items[item]
402         rxn = data["rxn"]
403         r, p = rxn.split(">>")
404         rgraph = self.mol_to_graph(Chem.MolFromSmiles(r))
405         pgraph = self.mol_to_graph(Chem.MolFromSmiles(p))
406         label = get_mapping_label(rxn) if self.include_labels else []
407         if self.include_labels and label is None:
408             raise ValueError(f"Invalid mapped reaction for training item: {data['id']}")
409         return data["id"], rxn, rgraph, pgraph, label, data.get("weight", 1.0), data
410 
411     def __len__(self):
412         return len(self.items)
413 
414 
