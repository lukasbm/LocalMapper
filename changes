24 class localmapper:
25     def __init__(self, device='cpu', model_version='202403'):
26         self.device = torch.device(device) if torch.cuda.is_available() else torch.device('cpu')
27         print ('Loaded LocalMapper (version=%s) at device %s' % (model_version, self.device))
28     
29         config_path = resource_filename('localmapper', 'data/default_config.json')
30         template_path = resource_filename('localmapper', 'data/templates_%s.pkl' % model_version)
31         model_path = resource_filename('localmapper', 'data/LocalMapper_%s.pth' % model_version)
32 
33         with open(template_path, 'rb') as f:
34             self.accepted_templates = pickle.load(f)
35         node_featurizer, edge_featurizer, self.graph_function = init_featurizer()
36         exp_config = get_configure(config_path, node_featurizer, edge_featurizer)
37         self.model = load_model(exp_config, model_path, device)
38         self.model.eval()
39         
40     def pred_pxr(self, rxns):
41         rgraphs, pgraphs = [], []
42         for rxn in rxns:
43             reactant, product = rxn.split('>>')
44             reactant, product = Chem.MolFromSmiles(reactant), Chem.MolFromSmiles(product)
45             rgraph, pgraph = self.graph_function(reactant), self.graph_function(product)
46             rgraphs.append(rgraph)
47             pgraphs.append(pgraph)
48         predictions = predict(self.model, self.device, rgraphs, pgraphs)
49         return [torch.softmax(pred, dim = 1).cpu().numpy() for pred in predictions]
50 
51     def get_atom_map(self, rxns, return_dict=False):
52         single_input = isinstance(rxns, str)
53         if single_input:
54             rxns = [rxns]
55         results = []
56         predictions = self.pred_pxr(rxns)
57         for i, (rxn, prediction) in enumerate(zip(rxns, predictions)):
58             mapped_result = prediction2map(rxn, prediction)
59             result = {'rxn': rxn}
60             result.update(mapped_result)
61             confident = result['template'] in self.accepted_templates
62             if not confident:
63                 mapped_result = prediction2map(rxn, prediction, 90)
64                 result.update(mapped_result)
65                 confident = result['template'] in self.accepted_templates
66             result['confident'] = confident
67             if not return_dict:
68                 result = mapped_result['mapped_rxn']
69             results.append(result)
70         if single_input:
71             return results[0]
72         else:
73             return results
74     
75     def plot_rxn(self, rxn):
76         rdkit_rxn = Chem.rdChemReactions.ReactionFromSmarts(rxn, useSmiles=True)
77         return Chem.Draw.ReactionToImage(rdkit_rxn)
