53 107     def score_graphs(self, rgraphs, pgraphs):
54 108         rbg, pbg = dgl.batch(rgraphs), dgl.batch(pgraphs)
55 109         rbg.set_n_initializer(dgl.init.zero_initializer)
   110         pbg.set_n_initializer(dgl.init.zero_initializer)
   111         rbg.set_e_initializer(dgl.init.zero_initializer)
   112         pbg.set_e_initializer(dgl.init.zero_initializer)
   113         rbg, pbg = rbg.to(self.device), pbg.to(self.device)
   114         rnode_feats, pnode_feats = (
   115             rbg.ndata.pop("h").to(self.device),
   116             pbg.ndata.pop("h").to(self.device),
   117         )
