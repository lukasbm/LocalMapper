258 def mapping_signature(rxn: str) -> tuple[tuple[str, str], tuple[tuple[int, int], ...]] | None:
259     try:
260         rxn = canonicalize_map_rxn(rxn)
261         rsmi, psmi = rxn.split(">>")
262         rmol = Chem.MolFromSmiles(rsmi)
263         pmol = Chem.MolFromSmiles(psmi)
264     except Exception:
265         return None
266     if rmol is None or pmol is None:
267         return None
268 
269     r_demapped = Chem.RWMol(rmol)
270     p_demapped = Chem.RWMol(pmol)
271     for mol in (r_demapped, p_demapped):
272         for atom in mol.GetAtoms():
273             atom.SetAtomMapNum(0)
274     pattern = (
275         Chem.MolToSmiles(r_demapped, canonical=True, isomericSmiles=True),
276         Chem.MolToSmiles(p_demapped, canonical=True, isomericSmiles=True),
277     )
278 
279     reactant_map_to_idx = {
280         atom.GetAtomMapNum(): atom.GetIdx()
281         for atom in rmol.GetAtoms()
282         if atom.GetAtomMapNum() > 0
283     }
284     pairs = []
285     for product_idx, atom in enumerate(pmol.GetAtoms()):
286         map_num = atom.GetAtomMapNum()
287         if map_num <= 0 or map_num not in reactant_map_to_idx:
288             return None
289         pairs.append((product_idx, reactant_map_to_idx[map_num]))
290     return pattern, tuple(pairs)
291 
292 
293 def mappings_are_equivalent(predicted_rxn: str, reference_rxn: str) -> bool:
294     backend = _equivalence_backend()
295     if backend in {"synkit_its_wl", "synkit_rc_wl"}:
296         check_method = backend.removeprefix("synkit_").removesuffix("_wl").upper()
297         predicted = synkit_mapping_fingerprint(predicted_rxn, check_method=check_method)
298         reference = synkit_mapping_fingerprint(reference_rxn, check_method=check_method)
299         return predicted is not None and predicted == reference
300 
301     if backend in {"synkit_its", "synkit_rc"}:
302         return synkit_mapping_equivalent(
303             predicted_rxn,
304             reference_rxn,
305             check_method=backend.removeprefix("synkit_").upper(),
306         )
307 
308     predicted_cgr = cgr_signature(predicted_rxn)
309     reference_cgr = cgr_signature(reference_rxn)
310     if predicted_cgr is not None and reference_cgr is not None:
311         return predicted_cgr == reference_cgr
312 
313     predicted = mapping_signature(predicted_rxn)
314     reference = mapping_signature(reference_rxn)
315     return predicted is not None and predicted == reference
316 
317 
318 def mapping_matches_any(predicted_rxn: str, reference_rxns: list[str]) -> bool:
319     return any(mappings_are_equivalent(predicted_rxn, reference) for reference in reference_rxns)
