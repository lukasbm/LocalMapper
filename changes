 10 def get_template_bond(temp_order, bond_smarts):
 11     bond_match = {}
 12     for n, _ in enumerate(temp_order):
 13         bond_match[(temp_order[n], temp_order[n-1])] = bond_smarts[n-1]
 14         bond_match[(temp_order[n-1], temp_order[n])] = bond_smarts[n-1]
 15     return bond_match   
 16 
 17 def bond_to_smiles(bond):
 18     a1_label = str(bond.GetBeginAtom().GetAtomicNum())
 19     a2_label = str(bond.GetEndAtom().GetAtomicNum())
 20     if bond.GetBeginAtom().HasProp('molAtomMapNumber'):
 21         a1_label += bond.GetBeginAtom().GetProp('molAtomMapNumber')
 22     if bond.GetEndAtom().HasProp('molAtomMapNumber'):
 23         a2_label += bond.GetEndAtom().GetProp('molAtomMapNumber')
 24     atoms = sorted([a1_label, a2_label])
 25     bond_smarts = bond_type_map[str(bond.GetBondType())]
 26     return '{}{}{}'.format(atoms[0], bond_smarts, atoms[1])
 27 
 28 def check_bond_break(bond1, bond2):
 29     if bond1 == None and bond2 != None:
 30         return False
 31     elif bond1 != None and bond2 == None:
 32         return True
 33     else:
 34         return False
 35 
 36 def check_bond_formed(bond1, bond2):
 37     if bond1 != None and bond2 == None:
 38         return False
 39     elif bond1 == None and bond2 != None:
 40         return True
 41     else:
 42         return False
 43     
 44 def check_bond_change(pbond, rbond):
 45     if pbond == None or rbond == None:
 46         return False
 47     elif bond_to_smiles(pbond) != bond_to_smiles(rbond):
 48         return True
 49     else:
 50         return False
 51     
 52 def atom_neighbors(atom):
 53     neighbor = []
 54     for n in atom.GetNeighbors():
 55         neighbor.append(n.GetAtomMapNum())
 56     return sorted(neighbor)
 57 
 58 def extend_changed_atoms(changed_atom_tags, reactants, max_map):
 59     for reactant in reactants:
 60         extend_idx = []
 61         for atom in reactant.GetAtoms():
 62             if str(atom.GetAtomMapNum()) in changed_atom_tags:
 63                 for n in atom.GetNeighbors():
 64                     if n.GetAtomMapNum() == 0:
 65                         extend_idx.append(n.GetIdx())
 66         for idx in extend_idx:
 67             reactant.GetAtomWithIdx(idx).SetAtomMapNum(max_map)
 68 
 69 def check_atom_change(patom, ratom):
 70     return atom_neighbors(patom) != atom_neighbors(ratom)
 71     
 72 def label_retro_edit_site(products, reactants, edit_num):
 73     edit_num = [int(num) for num in edit_num]
 74     pmol = Chem.MolFromSmiles(products)
 75     rmol = Chem.MolFromSmiles(reactants)
 76     patom_map = {atom.GetAtomMapNum():atom.GetIdx() for atom in pmol.GetAtoms()}
 77     ratom_map = {atom.GetAtomMapNum():atom.GetIdx() for atom in rmol.GetAtoms()}
 78     used_atom = set()
 79     grow_atoms = []
 80     broken_bonds = []
 81     changed_bonds = []
 82     
 83     # cut bond
 84     for a in edit_num:
 85         for b in edit_num:
 86             if a >= b:
 87                 continue
 88             pbond = pmol.GetBondBetweenAtoms(patom_map[a], patom_map[b])
 89             rbond = rmol.GetBondBetweenAtoms(ratom_map[a], ratom_map[b])
 90             if check_bond_break(pbond, rbond): # cut bond
 91                 broken_bonds.append((a, b))
 92                 used_atom.update([a, b])
 93     
 94     # Add LG
 95     for a in edit_num:
 96         if a in used_atom:
 97             continue
 98         patom = pmol.GetAtomWithIdx(patom_map[a])
 99         ratom = rmol.GetAtomWithIdx(ratom_map[a])
100         if check_atom_change(patom, ratom):
101             used_atom.update([a])
102             grow_atoms.append(a)
103             
104     # change bond type   
105     for a in edit_num:
106         for b in edit_num:
107             if a >= b:
108                 continue
109             pbond = pmol.GetBondBetweenAtoms(patom_map[a], patom_map[b])
110             rbond = rmol.GetBondBetweenAtoms(ratom_map[a], ratom_map[b])
111             if check_bond_change(pbond, rbond):
112                 if a not in used_atom and b not in used_atom:
113                     changed_bonds.append((a, b))
114                     
115     used_atoms = set(grow_atoms + [atom for bond in broken_bonds+changed_bonds for atom in bond])
116     remote_atoms = [atom for atom in edit_num if atom not in used_atoms]
117     remote_atoms_ = []
118     for a in remote_atoms:
119         atom = rmol.GetAtomWithIdx(ratom_map[a])
120         neighbors_map = [n.GetAtomMapNum() for n in atom.GetNeighbors()]
121         connected_neighbors = [b for b in used_atoms if b in neighbors_map]
122         if len(connected_neighbors) == 0:
123             remote_atoms_.append(a)
124                 
125     return grow_atoms, broken_bonds, changed_bonds, remote_atoms_
126 
127 def label_foward_edit_site(reactants, products, edit_num):
128     edit_num = [int(num) for num in edit_num]
129     rmol = Chem.MolFromSmiles(reactants)
130     pmol = Chem.MolFromSmiles(products)
131     ratom_map = {atom.GetAtomMapNum():atom.GetIdx() for atom in rmol.GetAtoms()}
132     patom_map = {atom.GetAtomMapNum():atom.GetIdx() for atom in pmol.GetAtoms()}
133     formed_bonds = []
134     broken_bonds = []
135     changed_bonds = []
136     acceptors1 = set()
137     acceptors2 = set()
138     donors = set()
139     form_bond = False
140     break_bond = False
141     change_bond = False
142        
143     # cut bond
144     for a in edit_num:
145         for b in edit_num:
146             if a >= b:
147                 continue
148             try:
149                 pbond = pmol.GetBondBetweenAtoms(patom_map[a], patom_map[b])
150             except:
151                 pbond = None
152             rbond = rmol.GetBondBetweenAtoms(ratom_map[a], ratom_map[b])
153             if check_bond_break(rbond, pbond):
154                 if a in patom_map:
155                     broken_bonds.append((a, b))
156                     acceptors1.add(a)
157                 if b in patom_map:
158                     broken_bonds.append((b, a))
159                     acceptors1.add(b)
160                 break_bond = True
161                 
162     # change bond
163     for a in edit_num:
164         for b in edit_num:
165             if a >= b:
166                 continue
167             try:
168                 pbond = pmol.GetBondBetweenAtoms(patom_map[a], patom_map[b])
169             except:
170                 pbond = None
171             rbond = rmol.GetBondBetweenAtoms(ratom_map[a], ratom_map[b])
172             if check_bond_change(rbond, pbond):
173                 changed_bonds.append((a, b))
174                 changed_bonds.append((b, a))
175                 change_bond = True
176                 acceptors2.update([a, b])
177                 
178     symmetric = True
179     # form bond
180     for a in edit_num:
181         for b in edit_num:
182             if a >= b:
183                 continue
184             try:
185                 pbond = pmol.GetBondBetweenAtoms(patom_map[a], patom_map[b])
186             except:
187                 pbond = None
188             rbond = rmol.GetBondBetweenAtoms(ratom_map[a], ratom_map[b])
189             if check_bond_formed(rbond, pbond): # cut bond
190                 form_bond = True
191                 if a not in acceptors1 and b not in acceptors1 and a not in acceptors2 and b not in acceptors2 :
192                     formed_bonds.append((a, b))
193                     formed_bonds.append((b, a))
194                 elif a in acceptors1 and b in acceptors1:
195                     symmetric = False
196                     formed_bonds.append((a, b))
197                     formed_bonds.append((b, a))
198                 else:
199                     symmetric = False
200                     if a in acceptors1:
201                         formed_bonds.append((b, a))
202                     elif a in acceptors2 and b not in acceptors1:
203                         formed_bonds.append((b, a))
204                     if b in acceptors1:
205                         formed_bonds.append((a, b))
206                     elif b in acceptors2 and a not in acceptors1:
207                         formed_bonds.append((a, b))
208 
209     if not symmetric:
210         new_changed_bonds = []
211         # electron acceptor propagation
212         acceptors = set([bond[1] for bond in formed_bonds]).union(acceptors1)
213         for atom in acceptors:
214             for bond in changed_bonds:
215                 if bond[0] == atom:
216                     new_changed_bonds.append(bond)
217         donors = set([bond[0] for bond in formed_bonds])
218         for atom in donors:
219             for bond in changed_bonds:
220                 if bond[1] == atom:
221                     new_changed_bonds.append(bond)
222         changed_bonds = list(set(new_changed_bonds))
223         
224     used_atoms = set([atom for bond in formed_bonds+broken_bonds+changed_bonds for atom in bond])
225     remote_atoms = [atom for atom in edit_num if atom not in used_atoms]
226     remote_bonds = []
227     for a in remote_atoms:
228         atom = rmol.GetAtomWithIdx(ratom_map[a])
229         neighbors_map = [n.GetAtomMapNum() for n in atom.GetNeighbors()]
230         connected_neighbors = [b for b in used_atoms if b in neighbors_map]
231         if len(connected_neighbors) > 0:
232             pass
233         else:
234             for n in neighbors_map:
235                 remote_bonds.append((a, n))
236                 
237     return formed_bonds, broken_bonds, changed_bonds, remote_bonds
238 
239 def label_CH_change(smiles1, smiles2, edit_num, replacement_dict):
240     mol1, mol2 = Chem.MolFromSmiles(smiles1), Chem.MolFromSmiles(smiles2)
241     atom_map_dict1 = {atom.GetAtomMapNum():atom.GetIdx() for atom in mol1.GetAtoms()}
242     atom_map_dict2 = {atom.GetAtomMapNum():atom.GetIdx() for atom in mol2.GetAtoms()}
243     H_dict = defaultdict(dict)
244     C_dict = defaultdict(dict)
245     for atom_map in edit_num:
246         atom_map = int(atom_map)
247         if atom_map in atom_map_dict2:
248             atom1, atom2 = mol1.GetAtomWithIdx(atom_map_dict1[atom_map]), mol2.GetAtomWithIdx(atom_map_dict2[atom_map])
249             H_dict[atom_map]['smiles1'], C_dict[atom_map]['smiles1'] = atom1.GetNumExplicitHs(), int(atom1.GetFormalCharge())
250             H_dict[atom_map]['smiles2'], C_dict[atom_map]['smiles2'] = atom2.GetNumExplicitHs(), int(atom2.GetFormalCharge())
251     H_change = {replacement_dict[k]:v['smiles2'] - v['smiles1'] for k, v in H_dict.items()}
252     Charge_change = {replacement_dict[k]:v['smiles2'] - v['smiles1'] for k, v in C_dict.items()}
253     return atom_map_dict1, H_change, Charge_change
254 
255 def bondmap2idx(bond_maps, idx_dict, temp_dict, remote = False):
256     bond_idxs = [(idx_dict[bond_map[0]], idx_dict[bond_map[1]]) for bond_map in bond_maps]
257     if remote:
258         bond_temps = list(set([(temp_dict[bond_map[0]], -1) for bond_map in bond_maps]))
259     else:
260         bond_temps = [(temp_dict[bond_map[0]], temp_dict[bond_map[1]]) for bond_map in bond_maps]
261     return (bond_idxs, bond_maps, bond_temps)
262 
263 def atommap2idx(atom_maps, idx_dict, temp_dict):
264     atom_idxs = [idx_dict[atom_map] for atom_map in atom_maps]
265     atom_temps = [temp_dict[atom_map] for atom_map in atom_maps]
266     return (atom_idxs, atom_maps, atom_temps)
267 
268 def match_label(reactants, products, replacement_dict, edit_num, retro = True, remote = True):
269     if retro:
270         smiles1 = products
271         smiles2 = reactants
272     else:
273         smiles1 = reactants
274         smiles2 = products
275         
276     replacement_dict = {int(k): int(v) for k, v in replacement_dict.items()}
277     atom_map_dict, H_change, Charge_change = label_CH_change(smiles1, smiles2, edit_num, replacement_dict)
278     
279     if retro:
280         ALG_atoms, broken_bonds, changed_bonds, remote_atoms = label_retro_edit_site(smiles1, smiles2, edit_num)
281         edits = {'A': atommap2idx(ALG_atoms, atom_map_dict, replacement_dict),
282                   'B': bondmap2idx(broken_bonds, atom_map_dict, replacement_dict),
283                   'C': bondmap2idx(changed_bonds, atom_map_dict, replacement_dict)}
284         if remote:
285                   edits['R'] = atommap2idx(remote_atoms, atom_map_dict, replacement_dict)
286     else:
287         formed_bonds, broken_bonds, changed_bonds, remote_bonds = label_foward_edit_site(smiles1, smiles2, edit_num)
288         edits = {'A': bondmap2idx(formed_bonds, atom_map_dict, replacement_dict),
289                   'B': bondmap2idx(broken_bonds, atom_map_dict, replacement_dict),
290                   'C': bondmap2idx(changed_bonds, atom_map_dict, replacement_dict)}
291         if remote:
292                   edits['R'] = bondmap2idx(remote_bonds, atom_map_dict, replacement_dict, True)
293     return edits, H_change, Charge_change
