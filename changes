 29 def init_featurizer(args):
 30     atom_types = ['C', 'N', 'O', 'S', 'F', 'Si', 'P', 'Cl', 'Br', 'Mg', 'Na', 'Ca', 'Fe',
 31              'As', 'Al', 'I', 'B', 'V', 'K', 'Tl', 'Yb', 'Sb', 'Sn', 'Ag', 'Pd', 'Co', 'Se', 'Ti',
 32              'Zn', 'H', 'Li', 'Ge', 'Cu', 'Au', 'Ni', 'Cd', 'In', 'Mn', 'Zr', 'Cr', 'Pt', 'Hg', 'Pb',
 33              'W', 'Ru', 'Nb', 'Re', 'Te', 'Rh', 'Ta', 'Tc', 'Ba', 'Bi', 'Hf', 'Mo', 'U', 'Sm', 'Os', 'Ir',
 34              'Ce', 'Gd', 'Ga', 'Cs']
 35     args['node_featurizer'] = WeaveAtomFeaturizer(atom_types = atom_types)
 36     args['edge_featurizer'] = CanonicalBondFeaturizer(self_loop=True)
 37     args['mol_to_graph'] = partial(mol_to_bigraph, add_self_loop=True, node_featurizer=args['node_featurizer'], edge_featurizer=args['edge_featurizer'], canonical_atom_order=False)
 38     return args
 39 
 40 def get_configure(args):
 41     with open(args['config_path'], 'r') as f:
 42         config = json.load(f)
 43     config['in_node_feats'] = args['node_featurizer'].feat_size()
 44     config['in_edge_feats'] = args['edge_featurizer'].feat_size()
 45     return config
 46     
 47 def load_dataloader(args, test = False):
 48     dataset = ReactionDataset(args)
 49     train_set, val_set, test_set = Subset(dataset, dataset.train_idx), Subset(dataset, dataset.val_idx), Subset(dataset, dataset.test_idx)
 50     
 51     if test:
 52         test_loader = DataLoader(dataset=test_set, batch_size=args['batch_size'], shuffle=False, collate_fn=collate_molgraphs)
 53         return test_loader
 54     else:
 55         train_loader = DataLoader(dataset=train_set, batch_size=args['batch_size'], shuffle=True, collate_fn=collate_molgraphs)
 56         val_loader = DataLoader(dataset=val_set, batch_size=args['batch_size'], shuffle=False, collate_fn=collate_molgraphs)
 57     return train_loader, val_loader
 58     
 59 def Twoway_CrossEntropyLoss(pred, true):
 60     normalized_pred = nn.LogSoftmax(dim = 0)(pred) + nn.LogSoftmax(dim = 1)(pred)
 61     loss = nn.NLLLoss(reduction = 'none')
 62     return loss(normalized_pred, true)
 63     
 64 def load_model(args):
 65     exp_config = get_configure(args)
 66     model = LocalMapper(
 67         node_in_feats=exp_config['in_node_feats'],
 68         edge_in_feats=exp_config['in_edge_feats'],
 69         node_out_feats=exp_config['node_out_feats'],
 70         edge_hidden_feats=exp_config['edge_hidden_feats'],
 71         num_step_message_passing=exp_config['num_step_message_passing'],
 72         attention_heads = exp_config['attention_heads'],
 73         attention_layers = exp_config['attention_layers'])
 74     model = model.to(args['device'])
 75 
 76     if args['mode'] == 'train':
 77         # loss_criterion = Twoway_CrossEntropyLoss
 78         loss_criterion = nn.CrossEntropyLoss()
 79         optimizer = Adam(model.parameters(), lr=args['learning_rate'], weight_decay=args['weight_decay'])
 80         scheduler = lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', factor=0.5, patience=1, min_lr=1e-4)
 81         stopper = EarlyStopping(mode = 'lower', patience=args['patience'], filename=args['model_path'])
 82         return model, loss_criterion, optimizer, scheduler, stopper
 83     
 84     else:
 85         model.load_state_dict(torch.load(args['model_path'], map_location=args['device'])['model_state_dict'])
 86         return model            
 87 
 88 def mask_labels(labels_list):
 89     fixed_labels_list = []
 90     masks_list = []
 91     for labels in labels_list:
 92         fixed_labels = [label if label >= 0 else 0 for label in labels]
 93         masks = [int(label >= 0) for label in labels]
 94         fixed_labels_list.append(torch.LongTensor(fixed_labels))
 95         masks_list.append(torch.LongTensor(masks))
 96         
 97     return fixed_labels_list, masks_list
 98 
 99 def collate_molgraphs(data):
100     idxs, rxns, rgraphs, pgraphs, labels_list, weights_list = map(list, zip(*data))
101     labels_list, masks_list = mask_labels(labels_list)
102     rbg, pbg = dgl.batch(rgraphs),  dgl.batch(pgraphs)
103     rbg.set_n_initializer(dgl.init.zero_initializer) 
104     pbg.set_n_initializer(dgl.init.zero_initializer)
105     rbg.set_e_initializer(dgl.init.zero_initializer)
106     pbg.set_e_initializer(dgl.init.zero_initializer)
107     return idxs, rxns, rbg, pbg, labels_list, masks_list, weights_list
108 
109 def predict(args, model, rbg, pbg):
110     rbg, pbg = rbg.to(args['device']), pbg.to(args['device'])
111     rnode_feats, pnode_feats = rbg.ndata.pop('h').to(args['device']), pbg.ndata.pop('h').to(args['device'])
112     redge_feats, pedge_feats = rbg.edata.pop('e').to(args['device']), pbg.edata.pop('e').to(args['device'])
113     return model(rbg, pbg, rnode_feats, pnode_feats, redge_feats, pedge_feats)
