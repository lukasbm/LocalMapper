 43 def load_dataloader(
 44     dataset_name,
 45     split,
 46     mol_to_graph,
 47     batch_size=16,
 48     data_root="data",
 49     val_fraction=0.1,
 50     test_fraction=0.1,
 51     seed=0,
 52     include_labels=True,
 53 ):
 54     full_dataset = create_reaction_dataset(
 55         dataset=dataset_name,
 56         mol_to_graph=mol_to_graph,
 57         data_root=data_root,
 58         include_labels=include_labels,
 59     )
 60     dataset = ReactionDataset.from_items(
 61         select_split(
 62             full_dataset.items,
 63             split,
 64             seed=seed,
 65             val_fraction=val_fraction,
 66             test_fraction=test_fraction,
 67         ),
 68         mol_to_graph,
 69         include_labels=include_labels,
 70     )
 71     return DataLoader(
 72         dataset,
 73         batch_size=batch_size,
 74         shuffle=split == "train",
 75         collate_fn=collate_reaction_batch,
 76     )
