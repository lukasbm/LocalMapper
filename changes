..                                                                                              204 def _compute_confidence_metrics(y_true, y_pred):
..                                                                                              205     y_true = y_true.astype(bool)
..                                                                                              206     y_pred = y_pred.astype(bool)
..                                                                                              207 
..                                                                                              208     tp = int(np.sum(y_true & y_pred))
..                                                                                              209     tn = int(np.sum(~y_true & ~y_pred))
..                                                                                              210     fp = int(np.sum(~y_true & y_pred))
..                                                                                              211     fn = int(np.sum(y_true & ~y_pred))
..                                                                                              212     total = int(len(y_true))
..                                                                                              213 
..                                                                                              214     accuracy = (tp + tn) / total if total else 0.0
..                                                                                              215     coverage = float(y_pred.mean()) if total else 0.0
..                                                                                              216     confident_accuracy = float(y_true[y_pred].mean()) if np.any(y_pred) else 0.0
..                                                                                              217     unconfident_accuracy = float(y_true[~y_pred].mean()) if np.any(~y_pred) else 0.0
..                                                                                              218     precision = tp / (tp + fp) if (tp + fp) else 0.0
..                                                                                              219     recall = tp / (tp + fn) if (tp + fn) else 0.0
..                                                                                              220     f1 = (
..                                                                                              221         (2 * precision * recall / (precision + recall)) if (precision + recall) else 0.0
..                                                                                              222     )
..                                                                                              223     mcc_denom = float((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))
..                                                                                              224     mcc = ((tp * tn) - (fp * fn)) / np.sqrt(mcc_denom) if mcc_denom else 0.0
..                                                                                              225 
..                                                                                              226     return {
..                                                                                              227         "accuracy": float(accuracy),
..                                                                                              228         "coverage": coverage,
..                                                                                              229         "confident_accuracy": confident_accuracy,
..                                                                                              230         "unconfident_accuracy": unconfident_accuracy,
..                                                                                              231         "precision": float(precision),
..                                                                                              232         "recall": float(recall),
..                                                                                              233         "f1": float(f1),
..                                                                                              234         "mcc": float(mcc),
..                                                                                              235         "confusion": {
..                                                                                              236             "tp": tp,
..                                                                                              237             "tn": tn,
..                                                                                              238             "fp": fp,
..                                                                                              239             "fn": fn,
..                                                                                              240             "total": total,
..                                                                                              241         },
..                                                                                              242     }
..                                                                                              243 
..                                                                                              244 
..                                                                                              245 def _compute_score_calibration(y_true, y_score):
..                                                                                              246     y_true = y_true.astype(bool)
..                                                                                              247     y_score = y_score.astype(float)
..                                                                                              248     threshold, y_pred = _best_threshold(y_true, y_score)
..                                                                                              249     metrics = _compute_score_threshold_metrics(
..                                                                                              250         y_true,
..                                                                                              251         y_score,
..                                                                                              252         threshold=threshold,
..                                                                                              253         threshold_source="best_f1_on_evaluation",
..                                                                                              254     )
..                                                                                              255 
..                                                                                              256     order = np.argsort(-y_score)
..                                                                                              257     sorted_true = y_true[order].astype(int)
..                                                                                              258     positives = int(sorted_true.sum())
..                                                                                              259     if positives == 0:
..                                                                                              260         ap = 0.0
..                                                                                              261     else:
..                                                                                              262         cumulative_tp = np.cumsum(sorted_true)
..                                                                                              263         precision_at_k = cumulative_tp / (np.arange(len(sorted_true)) + 1)
..                                                                                              264         ap = float((precision_at_k * sorted_true).sum() / positives)
..                                                                                              265     metrics["ap"] = float(ap)
..                                                                                              266     return metrics
..                                                                                              267 
..                                                                                              268 
..                                                                                              269 def _compute_score_threshold_metrics(y_true, y_score, *, threshold, threshold_source):
..                                                                                              270     y_true = y_true.astype(bool)
..                                                                                              271     y_score = y_score.astype(float)
..                                                                                              272     y_pred = y_score >= threshold
..                                                                                              273 
..                                                                                              274     tp = int(np.sum(y_true & y_pred))
..                                                                                              275     tn = int(np.sum(~y_true & ~y_pred))
..                                                                                              276     fp = int(np.sum(~y_true & y_pred))
..                                                                                              277     fn = int(np.sum(y_true & ~y_pred))
..                                                                                              278     total = int(len(y_true))
..                                                                                              279 
..                                                                                              280     accuracy = (tp + tn) / total if total else 0.0
..                                                                                              281     precision = tp / (tp + fp) if (tp + fp) else 0.0
..                                                                                              282     recall = tp / (tp + fn) if (tp + fn) else 0.0
..                                                                                              283     f1 = (
..                                                                                              284         (2 * precision * recall / (precision + recall)) if (precision + recall) else 0.0
..                                                                                              285     )
..                                                                                              286     mcc_denom = float((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))
..                                                                                              287     mcc = ((tp * tn) - (fp * fn)) / np.sqrt(mcc_denom) if mcc_denom else 0.0
..                                                                                              288 
..                                                                                              289     return {
..                                                                                              290         "mcc": float(mcc),
..                                                                                              291         "accuracy": float(accuracy),
..                                                                                              292         "precision": float(precision),
..                                                                                              293         "recall": float(recall),
..                                                                                              294         "f1": float(f1),
..                                                                                              295         "threshold": float(threshold),
..                                                                                              296         "threshold_source": threshold_source,
..                                                                                              297         "confusion": {
..                                                                                              298             "tp": tp,
..                                                                                              299             "tn": tn,
..                                                                                              300             "fp": fp,
..                                                                                              301             "fn": fn,
..                                                                                              302             "total": total,
..                                                                                              303         },
..                                                                                              304     }
..                                                                                              305 
..                                                                                              306 
..                                                                                              307 def _best_threshold(y_true, y_score):
..                                                                                              308     if len(y_true) == 0:
..                                                                                              309         return 0.5, np.zeros(0, dtype=bool)
..                                                                                              310 
..                                                                                              311     order = np.argsort(-y_score, kind="mergesort")
..                                                                                              312     sorted_scores = y_score[order]
..                                                                                              313     sorted_true = y_true[order].astype(bool)
..                                                                                              314 
..                                                                                              315     positives = int(sorted_true.sum())
..                                                                                              316     if positives == 0:
..                                                                                              317         return float(sorted_scores[0]) if len(sorted_scores) else 0.5, np.zeros(
..                                                                                              318             len(y_true), dtype=bool
..                                                                                              319         )
..                                                                                              320 
..                                                                                              321     tp_cum = np.cumsum(sorted_true)
..                                                                                              322     fp_cum = np.cumsum(~sorted_true)
..                                                                                              323     precision = tp_cum / np.maximum(tp_cum + fp_cum, 1)
..                                                                                              324     recall = tp_cum / positives
..                                                                                              325     f1 = np.divide(
..                                                                                              326         2 * precision * recall,
..                                                                                              327         precision + recall,
..                                                                                              328         out=np.zeros_like(precision, dtype=float),
..                                                                                              329         where=(precision + recall) != 0,
..                                                                                              330     )
..                                                                                              331 
..                                                                                              332     best_idx = int(np.argmax(f1))
..                                                                                              333     threshold = float(sorted_scores[best_idx])
..                                                                                              334     y_pred = y_score >= threshold
..                                                                                              335     return threshold, y_pred
..                                                                                              336 
..                                                                                              337 
..                                                                                              338 def _flatten_metrics(prefix, value, out):
..                                                                                              339     if isinstance(value, dict):
..                                                                                              340         for key, nested in value.items():
..                                                                                              341             next_prefix = f"{prefix}.{key}" if prefix else key
..                                                                                              342             _flatten_metrics(next_prefix, nested, out)
..                                                                                              343     else:
..                                                                                              344         out[prefix] = value
..                                                                                              345 
..                                                                                              346 
..                                                                                              347 def save_run_metrics_summary(run_dir):
..                                                                                              348     run_dir = Path(run_dir)
..                                                                                              349     predictions_dir = run_dir / "predictions"
..                                                                                              350     rows = []
..                                                                                              351     for metrics_path in sorted(predictions_dir.glob("metrics_*.json")):
..                                                                                              352         parts = metrics_path.stem.split("_")
..                                                                                              353         split = parts[1] if len(parts) >= 3 else None
..                                                                                              354         iteration = int(parts[2]) if len(parts) >= 3 and parts[2].isdigit() else None
..                                                                                              355         with metrics_path.open() as handle:
..                                                                                              356             metrics = json.load(handle)
..                                                                                              357         row = {
..                                                                                              358             "split": split,
..                                                                                              359             "iteration": iteration,
..                                                                                              360             "metrics_path": str(metrics_path),
..                                                                                              361         }
..                                                                                              362         _flatten_metrics("", metrics, row)
..                                                                                              363         rows.append(row)
..                                                                                              364 
..                                                                                              365     mkdir_p(run_dir)
..                                                                                              366     summary_json = run_dir / "metrics_summary.json"
..                                                                                              367     summary_csv = run_dir / "metrics_summary.csv"
..                                                                                              368     with summary_json.open("w") as handle:
..                                                                                              369         json.dump(rows, handle, indent=2, sort_keys=True)
..                                                                                              370     pd.DataFrame(rows).to_csv(summary_csv, index=False)
..                                                                                              371     return summary_json, summary_csv
