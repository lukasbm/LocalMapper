550 
551 def _log_cgr_event(event: str, rxn: str, *, detail: str = ""):
552     path = _cgr_debug_path()
553     if path is None:
554         return
555     try:
556         path.parent.mkdir(parents=True, exist_ok=True)
557         with path.open("a") as handle:
558             handle.write(f"{time.time():.6f}\t{event}\t{detail}\t{rxn}\n")
559     except Exception:
560         pass
561 
562 
563 _CGR_WORKER = None
564 _CGR_TASK_QUEUE = None
565 _CGR_RESULT_QUEUE = None
566 _CGR_TASK_ID = 0
567 
568 
569 def _cgr_worker_loop(task_queue, result_queue):
570     while True:
571         task = task_queue.get()
572         if task is None:
573             return
574         task_id, rxn = task
575         try:
576             signature = _cgr_signature_direct(rxn)
577             error = ""
578         except Exception:
579             signature = None
580             error = traceback.format_exc(limit=1).strip().replace("\n", " | ")
581         result_queue.put((task_id, signature, error))
582 
583 
584 def _stop_cgr_worker():
585     global _CGR_WORKER, _CGR_TASK_QUEUE, _CGR_RESULT_QUEUE
586     worker = _CGR_WORKER
587     if worker is not None and worker.is_alive():
588         try:
589             _CGR_TASK_QUEUE.put_nowait(None)
590             worker.join(timeout=0.2)
591         except Exception:
592             pass
593         if worker.is_alive():
594             worker.terminate()
595             worker.join(timeout=0.2)
596     _CGR_WORKER = None
597     _CGR_TASK_QUEUE = None
598     _CGR_RESULT_QUEUE = None
599 
600 
601 def _ensure_cgr_worker():
602     global _CGR_WORKER, _CGR_TASK_QUEUE, _CGR_RESULT_QUEUE
603     if _CGR_WORKER is not None and _CGR_WORKER.is_alive():
604         return
605     _stop_cgr_worker()
606     context = mp.get_context(os.environ.get("LOCALMAPPER_CGR_MP_CONTEXT", "fork"))
607     _CGR_TASK_QUEUE = context.Queue(maxsize=1)
608     _CGR_RESULT_QUEUE = context.Queue(maxsize=1)
609     _CGR_WORKER = context.Process(
610         target=_cgr_worker_loop,
611         args=(_CGR_TASK_QUEUE, _CGR_RESULT_QUEUE),
612         daemon=True,
613     )
614     _CGR_WORKER.start()
615 
616 
617 def _cgr_signature_isolated(rxn: str) -> str | None:
618     global _CGR_TASK_ID
619     if threading.current_thread() is not threading.main_thread():
620         try:
621             return _cgr_signature_direct(rxn)
622         except Exception:
623             return None
624 
625     timeout = _cgr_timeout_seconds()
626     if timeout <= 0:
627         try:
628             return _cgr_signature_direct(rxn)
629         except Exception:
630             return None
631 
632     _ensure_cgr_worker()
633     _CGR_TASK_ID += 1
634     task_id = _CGR_TASK_ID
635     try:
636         _CGR_TASK_QUEUE.put((task_id, rxn), timeout=timeout)
637         while True:
638             result_id, signature, error = _CGR_RESULT_QUEUE.get(timeout=timeout)
639             if result_id == task_id:
640                 if signature is None:
641                     _log_cgr_event("cgrtools_none", rxn, detail=error)
642                 return signature
643     except (queue.Empty, queue.Full):
644         _log_cgr_event("cgrtools_timeout", rxn, detail=f"timeout={timeout}")
645         _stop_cgr_worker()
646         return None
647 
648 
649 atexit.register(_stop_cgr_worker)
650 
651 
652 def normalize_item_target_with_timeout(item: dict[str, Any]) -> dict[str, Any] | None:
653     timeout = _filter_timeout_seconds()
654     if timeout <= 0 or threading.current_thread() is not threading.main_thread():
655         return normalize_item_target(item)
656 
657     previous_handler = signal.getsignal(signal.SIGALRM)
658     signal.signal(signal.SIGALRM, _handle_filter_timeout)
659     signal.setitimer(signal.ITIMER_REAL, timeout)
660     try:
661         return normalize_item_target(item)
662     except FilterTimeoutError:
663         return None
664     finally:
665         signal.setitimer(signal.ITIMER_REAL, 0)
666         signal.signal(signal.SIGALRM, previous_handler)
667 
668 
669 def _progress(iterable, *, desc: str, total: int | None = None):
670     if tqdm is None or os.environ.get("LOCALMAPPER_PROGRESS", "1") == "0":
671         return iterable
672     return tqdm(iterable, desc=desc, total=total)
