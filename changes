 10 class MultiHeadAttention(nn.Module):
 11     def __init__(self, heads, d_model, positional_number = 0, dropout = 0.1, return_att=False):
 12         super(MultiHeadAttention, self).__init__()
 13         self.return_att = return_att
 14         self.p_k = positional_number
 15         self.d_model = d_model
 16         self.d_k = d_model // heads
 17         self.h = heads
 18         if self.p_k != 0:
 19             self.relative_k = nn.Parameter(torch.randn(self.p_k, self.d_k))
 20             self.relative_v = nn.Parameter(torch.randn(self.p_k, self.d_k))
 21         self.q_linear = nn.Linear(d_model, d_model, bias=False)
 22         self.k_linear = nn.Linear(d_model, d_model, bias=False)
 23         self.v_linear = nn.Linear(d_model, d_model, bias=False)
 24         self.gating = nn.Linear(d_model, d_model)
 25         self.to_out = nn.Linear(d_model, d_model)
 26         self.dropout1 = nn.Dropout(dropout)
 27         self.dropout2 = nn.Dropout(dropout)
 28         self.layer_norm = nn.LayerNorm(d_model, eps=1e-6)
 29         self.reset_parameters()
 30         
 31     def reset_parameters(self):
 32         for p in self.parameters():
 33             if p.dim() > 1:
 34                 nn.init.xavier_uniform_(p)
 35         nn.init.constant_(self.gating.weight, 0.)
 36         nn.init.constant_(self.gating.bias, 1.)
 37         
 38     def one_hot_embedding(self, labels):
 39         y = torch.eye(self.p_k)
 40         return y[labels]
 41     
 42     def forward(self, x_q, x_k, mask=None):
 43         bs = x_q.size(0)
 44         x_q = self.layer_norm(x_q)
 45         x_k = self.layer_norm(x_k)
 46         q = self.q_linear(x_q)
 47         k = self.k_linear(x_k)
 48         v = self.v_linear(x_k)
 49 
 50         k1 = k.view(bs, -1, self.h, self.d_k).transpose(1,2)
 51         q1 = q.view(bs, -1, self.h, self.d_k).transpose(1,2)
 52         v1 = v.view(bs, -1, self.h, self.d_k).transpose(1,2)
 53         attn1 = torch.matmul(q1, k1.permute(0, 1, 3, 2))
 54         
 55         if self.p_k == 0:
 56             attn = attn1/math.sqrt(self.d_k)
 57         else:
 58             gpms = self.one_hot_embedding(gpm.unsqueeze(1).repeat(1, self.h, 1, 1)).to(x.device)
 59             attn2 = torch.matmul(q1, self.relative_k.transpose(0, 1))
 60             attn2 = torch.matmul(gpms, attn2.unsqueeze(-1)).squeeze(-1)
 61             attn = (attn1 + attn2) /math.sqrt(self.d_k)
 62         
 63         if mask:
 64             mask = mask.bool()
 65             mask = mask.unsqueeze(1).repeat(1,mask.size(-1),1)
 66             mask = mask.unsqueeze(1).repeat(1,attn.size(1),1,1)
 67             attn[~mask] = float(-9e9)
 68 
 69         if self.return_att:
 70             return attn[:, 0]
 71             
 72         attn = torch.softmax(attn, dim=-1) * torch.softmax(attn, dim=-2)
 73         v1 = v.view(bs, -1, self.h, self.d_k).permute(0, 2, 1, 3)
 74         output = torch.matmul(self.dropout1(attn), v1)
 75         output = output.transpose(1,2).contiguous().view(bs, -1, self.d_model).squeeze(-1)
 76         output = self.to_out(output * self.gating(x_q).sigmoid()) # gate attention
 77         return self.dropout2(output)
 78 
 79         
 80     
 81 class GELU(nn.Module):
 82     def forward(self, x):
 83         return 0.5 * x * (1 + torch.tanh(math.sqrt(2/math.pi) * (x + 0.044715 * torch.pow(x, 3)))) 
 84     
 85 class FeedForward(nn.Module):
 86     def __init__(self, d_model, dropout = 0.1):
 87         super(FeedForward, self).__init__()
 88         self.net = nn.Sequential(
 89             nn.Linear(d_model, d_model*2),
 90             GELU(),
 91             nn.Dropout(dropout),
 92             nn.Linear(d_model*2, d_model))
 93         self.layer_norm = nn.LayerNorm(d_model, eps=1e-6)
 94         self.dropout = nn.Dropout(dropout)
 95         
 96     def forward(self, x):
 97         x = self.layer_norm(x)
 98         return self.net(x)
 99 
100 class CrossReactivityAttention(nn.Module):
101     def __init__(self, d_model, heads, n_layers = 3, positional_number = 0, dropout = 0.1):
102         super(CrossReactivityAttention, self).__init__()
103         self.positional_number = positional_number
104         self.n_layers = n_layers
105         att_stack = []
106         pff_stack = []
107         for _ in range(n_layers):
108             att_stack.append(MultiHeadAttention(heads, d_model, positional_number, dropout))
109             pff_stack.append(FeedForward(d_model, dropout))
110 #         att_stack.append(MultiHeadAttention(1, d_model, positional_number, dropout, return_att=True))
111         self.att_stack = nn.ModuleList(att_stack)
112         self.pff_stack = nn.ModuleList(pff_stack)
113         
114     def forward(self, x_q, x_k, mask=None):
115         for n in range(self.n_layers):
116             m = self.att_stack[n](x_q, x_k, mask)
117             x_q = x_q + self.pff_stack[n](x_q+m)
118 #         score = self.att_stack[-1](x_q, x_k, mask)
119         return x_q
120     
