162 def predicted_templates(
163     root: str | Path,
164     dataset: str,
165     model_name: str,
166     seed: int,
167     split: str,
168     through_iteration: int,
169 ) -> set[str]:
170     templates: set[str] = set()
171     for iteration in range(1, through_iteration + 1):
172         path = prediction_path(root, dataset, model_name, seed, split, iteration)
173         if not path.exists():
174             continue
175         predictions = pd.read_csv(path, usecols=lambda col: col == "template")
176         if "template" in predictions:
177             templates.update(_valid_template_values(predictions["template"]))
178     return templates
