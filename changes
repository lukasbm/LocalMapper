 91 def summarize_dataset(
 92     dataset_key: str,
 93     *,
 94     data_root: Path,
 95     max_items: int | None,
 96     top_n: int,
 97 ) -> dict[str, Any]:
 98     dataset = DATASETS[dataset_key](lambda mol: mol, data_root=data_root)
 99     raw_items = list(dataset.items)
100     if max_items is not None:
101         raw_items = raw_items[:max_items]
102 
103     split_counts = Counter(item.get("split") or "unsplit" for item in raw_items)
104     source_counts = Counter(
105         str(item.get("source")) for item in raw_items if item.get("source") is not None
106     )
107 
108     valid_items = []
109     invalid_mapping = 0
110     for item in raw_items:
111         normalized_item = normalize_item_target(item)
112         if normalized_item is None:
113             invalid_mapping += 1
114         else:
115             valid_items.append(normalized_item)
116 
117     mapped_rxns = [item["rxn"] for item in valid_items]
118     mapping_alternatives = [int(item.get("num_mappings", 1) or 1) for item in raw_items]
119 
120     pattern_counter: Counter[str] = Counter()
121     pattern_failures = 0
122     reactant_atoms = []
123     product_atoms = []
124     for rxn in mapped_rxns:
125         pattern = reaction_pattern(rxn)
126         if pattern is None:
127             pattern_failures += 1
128         else:
129             pattern_counter[pattern] += 1
130 
131         counts = atom_counts(rxn)
132         if counts is not None:
133             reactant_atoms.append(counts[0])
134             product_atoms.append(counts[1])
135 
136     template_counter: Counter[str] = Counter()
137     template_failures = 0
138     for rxn in mapped_rxns:
139         try:
140             template = extract_from_reaction(rxn)
141         except Exception:
142             template = None
143         if template:
144             template_counter[template] += 1
145         else:
146             template_failures += 1
147 
148     valid_count = len(valid_items)
149     summary = {
150         "dataset": CANONICAL_DATASETS[dataset_key],
151         "raw_items": len(raw_items),
152         "valid_items": valid_count,
153         "invalid_mapping": invalid_mapping,
154         "split_counts": dict(split_counts),
155         "source_counts": dict(source_counts),
156         "mapped_unique": len(set(mapped_rxns)),
157         "mapped_unique_ratio": len(set(mapped_rxns)) / valid_count if valid_count else 0.0,
158         "pattern_unique": len(pattern_counter),
159         "pattern_unique_ratio": len(pattern_counter) / valid_count if valid_count else 0.0,
160         "pattern_failures": pattern_failures,
161         "template_unique": len(template_counter),
162         "template_unique_ratio": len(template_counter) / valid_count if valid_count else 0.0,
163         "template_failures": template_failures,
164         "multi_mapping_rows": sum(1 for count in mapping_alternatives if count > 1),
165         "max_mappings_per_row": max(mapping_alternatives, default=0),
166         "mean_mappings_per_row": _safe_mean(mapping_alternatives),
167         "mean_reactant_atoms": _safe_mean(reactant_atoms),
168         "mean_product_atoms": _safe_mean(product_atoms),
169         "median_reactant_atoms": _safe_median(reactant_atoms),
170         "median_product_atoms": _safe_median(product_atoms),
171         "top_templates": _top(template_counter, top_n),
172         "top_patterns": _top(pattern_counter, top_n),
173         "top_sources": _top(source_counts, top_n),
174     }
175     return summary
176 
177 
178 def print_summary(summary: dict[str, Any]) -> None:
179     print(f"\n=== {summary['dataset']} ===")
180     print(
181         "  items: raw={raw_items}, valid_mapping={valid_items}, invalid_mapping={invalid_mapping}".format(
182             **summary
183         )
184     )
185     print(f"  splits: {summary['split_counts']}")
186     if summary["source_counts"]:
187         print(f"  sources: {summary['source_counts']}")
188     print(
189         "  mapping alternatives: multi_rows={multi_mapping_rows}, mean_per_row={mean_mappings_per_row}, max_per_row={max_mappings_per_row}".format(
190             multi_mapping_rows=summary["multi_mapping_rows"],
191             mean_mappings_per_row=_fmt_number(summary["mean_mappings_per_row"]),
192             max_mappings_per_row=summary["max_mappings_per_row"],
193         )
194     )
195     print(
196         "  unique mapped reactions: {mapped_unique} ({mapped_unique_ratio})".format(
197             mapped_unique=summary["mapped_unique"],
198             mapped_unique_ratio=_fmt_ratio(summary["mapped_unique_ratio"]),
199         )
200     )
201     print(
202         "  unique demapped patterns: {pattern_unique} ({pattern_unique_ratio}), failures={pattern_failures}".format(
203             pattern_unique=summary["pattern_unique"],
204             pattern_unique_ratio=_fmt_ratio(summary["pattern_unique_ratio"]),
205             pattern_failures=summary["pattern_failures"],
206         )
207     )
208     print(
209         "  unique templates: {template_unique} ({template_unique_ratio}), failures={template_failures}".format(
210             template_unique=summary["template_unique"],
211             template_unique_ratio=_fmt_ratio(summary["template_unique_ratio"]),
212             template_failures=summary["template_failures"],
213         )
214     )
215     print(
216         "  atoms: reactants mean/median={}/{}; products mean/median={}/{}".format(
217             _fmt_number(summary["mean_reactant_atoms"]),
218             _fmt_number(summary["median_reactant_atoms"]),
219             _fmt_number(summary["mean_product_atoms"]),
220             _fmt_number(summary["median_product_atoms"]),
221         )
222     )
223     _print_top("top templates", summary["top_templates"], summary["valid_items"])
224     _print_top("top demapped patterns", summary["top_patterns"], summary["valid_items"])
225     _print_top("top sources", summary["top_sources"], summary["raw_items"])
226 
