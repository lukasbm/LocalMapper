729 def _cgr_worker_loop(task_queue, result_queue):
730     while True:
731         task = task_queue.get()
732         if task is None:
733             return
734         task_id, rxn = task
735         try:
736             signature = _cgr_signature_direct(rxn)
737             error = ""
738         except Exception:
739             signature = None
740             error = traceback.format_exc(limit=1).strip().replace("\n", " | ")
741         result_queue.put((task_id, signature, error))
742 
743 
744 def _stop_cgr_worker():
745     global _CGR_WORKER, _CGR_TASK_QUEUE, _CGR_RESULT_QUEUE
746     worker = _CGR_WORKER
747     if worker is not None and worker.is_alive():
748         try:
749             _CGR_TASK_QUEUE.put_nowait(None)
750             worker.join(timeout=0.2)
751         except Exception:
752             pass
753         if worker.is_alive():
754             worker.terminate()
755             worker.join(timeout=0.2)
756     _CGR_WORKER = None
757     _CGR_TASK_QUEUE = None
758     _CGR_RESULT_QUEUE = None
759 
760 
761 def _ensure_cgr_worker():
762     global _CGR_WORKER, _CGR_TASK_QUEUE, _CGR_RESULT_QUEUE
763     if _CGR_WORKER is not None and _CGR_WORKER.is_alive():
764         return
765     _stop_cgr_worker()
766     context = mp.get_context(os.environ.get("LOCALMAPPER_CGR_MP_CONTEXT", "spawn"))
767     _CGR_TASK_QUEUE = context.Queue(maxsize=1)
768     _CGR_RESULT_QUEUE = context.Queue(maxsize=1)
769     _CGR_WORKER = context.Process(
770         target=_cgr_worker_loop,
771         args=(_CGR_TASK_QUEUE, _CGR_RESULT_QUEUE),
772         daemon=True,
773     )
774     _CGR_WORKER.start()
775 
776 
777 def _cgr_signature_isolated(rxn: str) -> str | None:
778     global _CGR_TASK_ID
779     if threading.current_thread() is not threading.main_thread():
780         try:
781             return _cgr_signature_direct(rxn)
782         except Exception:
783             return None
784 
785     timeout = _cgr_timeout_seconds()
786     if timeout <= 0:
787         try:
788             return _cgr_signature_direct(rxn)
789         except Exception:
790             return None
791 
792     _ensure_cgr_worker()
793     _CGR_TASK_ID += 1
794     task_id = _CGR_TASK_ID
795     try:
796         _CGR_TASK_QUEUE.put((task_id, rxn), timeout=timeout)
797         while True:
798             result_id, signature, error = _CGR_RESULT_QUEUE.get(timeout=timeout)
799             if result_id == task_id:
800                 if signature is None:
801                     _log_cgr_event("cgrtools_none", rxn, detail=error)
802                 return signature
803     except (queue.Empty, queue.Full):
804         _log_cgr_event("cgrtools_timeout", rxn, detail=f"timeout={timeout}")
805         _stop_cgr_worker()
806         return None
807 
808 
809 atexit.register(_stop_cgr_worker)
810 
811 
812 def normalize_item_target_with_timeout(item: dict[str, Any]) -> dict[str, Any] | None:
813     timeout = _filter_timeout_seconds()
814     if timeout <= 0 or threading.current_thread() is not threading.main_thread():
815         return normalize_item_target(item)
816 
817     previous_handler = signal.getsignal(signal.SIGALRM)
818     signal.signal(signal.SIGALRM, _handle_filter_timeout)
819     signal.setitimer(signal.ITIMER_REAL, timeout)
820     try:
821         return normalize_item_target(item)
822     except FilterTimeoutError:
823         return None
824     finally:
825         signal.setitimer(signal.ITIMER_REAL, 0)
826         signal.signal(signal.SIGALRM, previous_handler)
827 
