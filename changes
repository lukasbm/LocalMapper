618 def normalize_item_target(item: dict[str, Any]) -> dict[str, Any] | None:
619     reference_rxns = item.get("mapped_rxns", [item["rxn"]])
620     normalized_rxns = [
621         normalized
622         for reference_rxn in reference_rxns
623         if (normalized := normalize_mapped_rxn(reference_rxn))
624     ]
625     if not normalized_rxns:
626         return None
627     return {
628         **item,
629         "rxn": normalized_rxns[0],
630         "mapped_rxns": normalized_rxns,
631         "num_mappings": len(normalized_rxns),
632     }
