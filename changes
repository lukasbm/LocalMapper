 16 ROOT = Path(__file__).resolve().parents[1]
 17 
 18 CANONICAL_DATASETS = {
 19     "uspto_50k": "USPTO_50K",
 20     "golden": "Golden",
 21     "natcomm": "NatComm",
 22     "schneider": "Schneider",
 23     "ringreactions": "ringreactions",
 24     "metamdb": "metAMDB",
