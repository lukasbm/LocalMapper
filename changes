859 
860 def select_split(
861     items: list[dict[str, Any]],
862     split: str,
863     *,
864     seed: int = 0,
865     val_fraction: float = 0.1,
866     test_fraction: float = 0.1,
867     max_candidates: int | None = None,
868 ) -> list[dict[str, Any]]:
869     split = split.lower()
870     explicit = [item for item in items if item["split"] == split]
871     if explicit:
872         return normalize_item_targets(
873             explicit,
874             progress_desc=f"Filtering {split} mappings",
875         )
876 
877     unsplit = [item for item in items if item["split"] is None]
878     if not unsplit:
879         return []
880 
881     rng = np.random.default_rng(seed)
882     order = rng.permutation(len(unsplit))
883     n_test = int(round(len(unsplit) * test_fraction))
884     n_val = int(round(len(unsplit) * val_fraction))
885     test_ids = set(order[:n_test])
886     val_ids = set(order[n_test : n_test + n_val])
887 
888     selected = []
889     for i, item in enumerate(unsplit):
890         item_split = "test" if i in test_ids else "val" if i in val_ids else "train"
891         if item_split == split:
892             selected.append({**item, "split": item_split})
893     if max_candidates is not None and len(selected) > max_candidates:
894         selected_order = rng.permutation(len(selected))[:max_candidates]
895         selected = [selected[i] for i in selected_order]
896     return normalize_item_targets(
897         selected,
898         progress_desc=f"Filtering {split} mappings",
899     )
900 
