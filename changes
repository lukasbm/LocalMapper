 38 def get_adm(mol, max_distance=4):
 39     dm = Chem.GetDistanceMatrix(mol)
 40     dm[dm > 100] = -1  # remote (different molecule)
 41     dm[dm > max_distance] = max_distance + 1  # remote (same molecule)
 42     dm[dm == -1] = max_distance + 2  # remote (different molecule)
 43     return dm
 44 
 45 
 46 def _reaction_mols(rxn: str):
 47     if not _valid_rxn(rxn):
 48         return None, None
 49     r, p = [Chem.MolFromSmiles(smi) for smi in rxn.split(">>")]
 50     return r, p
 51 
 52 
 53 @lru_cache(maxsize=100_000)
 54 def product_has_invalid_mapping(rxn: str) -> bool:
 55     r, p = _reaction_mols(rxn)
 56     if r is None or p is None:
 57         return True
 58 
 59     r_map_counts: dict[int, int] = {}
 60     for atom in r.GetAtoms():
 61         map_num = atom.GetAtomMapNum()
 62         if map_num > 0:
 63             r_map_counts[map_num] = r_map_counts.get(map_num, 0) + 1
 64 
 65     pmaps = [atom.GetAtomMapNum() for atom in p.GetAtoms()]
 66     return (
 67         0 in pmaps
 68         or len(pmaps) != len(set(pmaps))
 69         or any(r_map_counts.get(map_num, 0) != 1 for map_num in pmaps)
 70     )
 71 
 72 
 73 def product_is_unmapped(rxn):
 74     return product_has_invalid_mapping(rxn)
 75 
 76 
 77 def _mapped_product_maps(p: Chem.Mol) -> set[int]:
 78     return {atom.GetAtomMapNum() for atom in p.GetAtoms() if atom.GetAtomMapNum() > 0}
 79 
 80 
 81 def _morgan_fp(mol: Chem.Mol):
 82     try:
 83         Chem.GetSymmSSSR(mol)
 84         return AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=2048)
 85     except Exception:
 86         try:
 87             mol = Chem.Mol(mol)
 88             Chem.SanitizeMol(mol)
 89             return AllChem.GetMorganFingerprintAsBitVect(mol, 2, nBits=2048)
 90         except Exception:
 91             return None
 92 
 93 
 94 @lru_cache(maxsize=100_000)
 95 def has_confusing_reagent(rxn: str, tanimoto_threshold: float = 0.5) -> bool:
 96     r, p = _reaction_mols(rxn)
 97     if r is None or p is None:
 98         return True
 99 
100     product_maps = _mapped_product_maps(p)
101     product_fp = _morgan_fp(p)
102     if product_fp is None:
103         return True
104 
105     try:
106         reactants = Chem.GetMolFrags(r, asMols=True, sanitizeFrags=True)
107     except Exception:
108         reactants = Chem.GetMolFrags(r, asMols=True, sanitizeFrags=False)
109     for reactant in reactants:
110         reactant_maps = {
111             atom.GetAtomMapNum()
112             for atom in reactant.GetAtoms()
113             if atom.GetAtomMapNum() > 0
114         }
115         if reactant_maps & product_maps:
116             continue
117         reactant_fp = _morgan_fp(reactant)
118         if reactant_fp is None:
119             continue
120         if DataStructs.TanimotoSimilarity(reactant_fp, product_fp) >= tanimoto_threshold:
121             return True
122     return False
123 
124 
125 @lru_cache(maxsize=100_000)
126 def reaction_passes_paper_filters(rxn: str) -> bool:
127     if product_has_invalid_mapping(rxn):
128         return False
129     if os.environ.get("LOCALMAPPER_CONFUSING_REAGENT_FILTER", "0") != "1":
130         return True
131     return not has_confusing_reagent(rxn)
132 
133 
134 def get_mapping_label(rxn):
135     rsmi, psmi = rxn.split(">>")
136     rmol = Chem.MolFromSmiles(rsmi)
137     pmol = Chem.MolFromSmiles(psmi)
138     if rmol is None or pmol is None or product_has_invalid_mapping(rxn):
139         return None
140     r_atom_dict = {
141         atom.GetAtomMapNum(): atom.GetIdx()
142         for atom in rmol.GetAtoms()
143         if atom.GetAtomMapNum() > 0
144     }
145     labels = []
146     for atom in pmol.GetAtoms():
147         map_num = atom.GetAtomMapNum()
148         if map_num not in r_atom_dict:
149             return None
150         labels.append(r_atom_dict[map_num])
151     return labels
152 
153 
154 def clean_reactant_map(rxn):
155     r, p = rxn.split(">>")
156     r_mol = Chem.MolFromSmiles(r)
157     [atom.SetAtomMapNum(0) for atom in r_mol.GetAtoms()]
158     r = Chem.MolToSmiles(r_mol, canonical=False)
159     return ">>".join([r, p])
160 
161 
162 def canonicalize_map_rxn(rxn):
163     new_rxn = []
164     for smi in rxn.split(">>"):
165         mol = Chem.MolFromSmiles(smi)
166         index2mapnums = {}
167         for atom in mol.GetAtoms():
168             index2mapnums[atom.GetIdx()] = atom.GetAtomMapNum()
169         mol_cano = Chem.RWMol(mol)
170         [atom.SetAtomMapNum(0) for atom in mol_cano.GetAtoms()]
171         smi_cano = Chem.MolToSmiles(mol_cano)
172         mol_cano = Chem.MolFromSmiles(smi_cano)
173         match = mol.GetSubstructMatch(mol_cano)
174         if match:
175             for atom, mat in zip(mol_cano.GetAtoms(), match):
176                 atom.SetAtomMapNum(index2mapnums[mat])
177             smi = Chem.MolToSmiles(mol_cano, canonical=False)
178         new_rxn.append(smi)
179     return ">>".join(new_rxn)
180 
