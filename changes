361 def save_verified_template_library(
362     root: str | Path,
363     dataset: str,
364     model_name: str,
365     seed: int,
366     through_iteration: int,
367 ) -> Path:
368     annotations = load_annotations(root, dataset, model_name, seed, through_iteration)
369     path = template_library_path(root, dataset, model_name, seed, through_iteration)
370     mkdir_p(path.parent)
371     if annotations.empty:
372         pd.DataFrame(columns=["template", "count", "first_iteration"]).to_csv(
373             path, index=False
374         )
375         return path
376 
377     library = (
378         annotations.dropna(subset=["template"])
379         .groupby("template", as_index=False)
380         .agg(count=("template", "size"), first_iteration=("iteration", "min"))
381         .sort_values(["first_iteration", "template"])
382     )
383     library.to_csv(path, index=False)
384     return path
385 
