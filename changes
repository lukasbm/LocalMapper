181 def rejected_templates(
182     root: str | Path,
183     dataset: str,
184     model_name: str,
185     seed: int,
186     split: str,
187     through_prediction_iteration: int,
188     through_annotation_iteration: int,
189 ) -> set[str]:
190     if through_prediction_iteration <= 0:
191         return set()
192     known = verified_templates(
193         root, dataset, model_name, seed, through_annotation_iteration
194     )
195     return predicted_templates(
196         root, dataset, model_name, seed, split, through_prediction_iteration
197     ) - known
