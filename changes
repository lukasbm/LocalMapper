276 def normalize_mapped_rxn(rxn: str) -> str | None:
277     if get_mapping_label(rxn) is None or not reaction_passes_paper_filters(rxn):
278         return None
279     if os.environ.get("LOCALMAPPER_CANONICALIZE_TARGETS", "0") != "1":
280         return rxn
281     try:
282         normalized = canonicalize_map_rxn(rxn)
283     except Exception:
284         return None
285     return normalized if get_mapping_label(normalized) is not None else None
286 
287 
288 def _valid_rxn(rxn: Any) -> bool:
289     if not isinstance(rxn, str) or rxn.count(">>") != 1:
290         return False
291     reactants, products = rxn.split(">>")
292     return bool(reactants and products)
293 
294 
295 def _alternatives(value: Any) -> list[str]:
296     if not isinstance(value, str):
297         return []
298     return [
299         part.strip() for part in value.strip().split(",") if _valid_rxn(part.strip())
300     ]
301 
302 
303 def _item(
304     idx: Any,
305     rxn: Any,
306     *,
307     split: str | None = None,
308     source: Any = None,
309     alternatives: list[str] | None = None,
310 ) -> dict[str, Any] | None:
311     rxns = alternatives if alternatives is not None else _alternatives(rxn)
312     if not rxns:
313         return None
314     return {
315         "id": str(idx),
316         "rxn": rxns[0],
317         "mapped_rxns": rxns,
318         "split": split,
319         "original_split": split,
320         "source": None if pd.isna(source) else source,
321         "num_mappings": len(rxns),
322     }
323 
324 
325 def _from_frame(
326     df: pd.DataFrame,
327     rxn_col: str,
328     *,
329     split: str | None = None,
330     id_col: str | None = None,
331     source_col: str | None = None,
332 ) -> list[dict[str, Any]]:
333     items = []
334     for i, row in df.iterrows():
335         item = _item(
336             row[id_col] if id_col and id_col in df.columns else i,
337             row[rxn_col],
338             split=split,
339             source=row[source_col] if source_col and source_col in df.columns else None,
340         )
341         if item is not None:
342             items.append(item)
343     return items
344 
345 
346 def _from_line_file(path: Path, *, split: str, id_prefix: str | None = None) -> list[dict[str, Any]]:
347     items = []
348     with path.open() as f:
349         for i, line in enumerate(f):
350             rxns = _alternatives(line.rstrip("\n\r"))
351             idx = f"{id_prefix}:{i}" if id_prefix else i
352             item = _item(idx, None, split=split, alternatives=rxns)
353             if item is not None:
354                 items.append(item)
355     return items
356 
357 
358 def _from_semicolon_file(path: Path, *, split: str, id_prefix: str | None = None) -> list[dict[str, Any]]:
359     items = []
360     with path.open() as f:
361         for i, line in enumerate(f):
362             line = line.rstrip("\n\r")
363             if not line:
364                 continue
365             idx, payload = line.split(";", 1) if ";" in line else (i, line)
366             idx = f"{id_prefix}:{idx}" if id_prefix else idx
367             item = _item(idx, None, split=split, alternatives=_alternatives(payload))
368             if item is not None:
369                 items.append(item)
370     return items
371 
