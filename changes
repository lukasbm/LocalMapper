                                                                                                181 def clean_map(rxn):
                                                                                                182     r_mol, p_mol = [Chem.MolFromSmiles(s) for s in rxn.split(">>")]
                                                                                                183     p_maps = [atom.GetAtomMapNum() for atom in p_mol.GetAtoms()]
                                                                                                184     [
                                                                                                185         atom.SetAtomMapNum(0)
                                                                                                186         for atom in r_mol.GetAtoms()
                                                                                                187         if atom.GetAtomMapNum() not in p_maps
                                                                                                188     ]
                                                                                                189     return ">>".join([Chem.MolToSmiles(m) for m in [r_mol, p_mol]])

