scripts/models.py --- Python
 1 import torch
 2 import torch.nn as nn
 3 from torch.nn.utils.rnn import pad_sequence
 4 
 5 import sklearn
 6 import dgl
 7 import dgllife
 8 from dgllife.model import MPNNGNN
 9 
10 from model_utils import GELU, MultiHeadAttention, CrossReactivityAttention
11     
12 class LocalMapper(nn.Module):
13     def __init__(self,
14                  node_in_feats,
15                  edge_in_feats,
16                  node_out_feats,
17                  edge_hidden_feats,
18                  num_step_message_passing,
19                  attention_heads,
20                  attention_layers
21                 ):
22         super(LocalMapper, self).__init__()
23            
24         self.mpnn = MPNNGNN(node_in_feats=node_in_feats,
25                            node_out_feats=node_out_feats,
26                            edge_in_feats=edge_in_feats,
27                            edge_hidden_feats=edge_hidden_feats,
28                            num_step_message_passing=num_step_message_passing)
29         
30         self.cross_att = CrossReactivityAttention(node_out_feats, attention_heads, attention_layers)
31         self.amm_att = MultiHeadAttention(1, node_out_feats, dropout=0.2, return_att=True)
32 
33 
34     def batch_att(self, rbg, pbg, feats_r, feats_p):
35         device = feats_r.device
36         mapping_scores = []
37         rbg.ndata['h'], pbg.ndata['h'] = feats_r, feats_p
38         rgs, pgs = dgl.unbatch(rbg), dgl.unbatch(pbg)
39         batch_p = pad_sequence([g.ndata['h'] for g in pgs], batch_first=True, padding_value= 0) # batch, patom_n, hidden_n
40         batch_r = pad_sequence([g.ndata['h'] for g in rgs], batch_first=True, padding_value= 0) # batch, ratom_n, hidden_n
41         
42         batch_p = self.cross_att(batch_p, batch_r)
43         aam_score = self.amm_att(batch_p, batch_r)
44         aam_score = [score[:pg.num_nodes(), :rg.num_nodes()] for pg, rg, score in zip(pgs, rgs, aam_score)]
45         return aam_score
46 
47     def forward(self, rbg, pbg, rnode_feats, pnode_feats, redge_feats, pedge_feats):
48         rnode_feats = self.mpnn(rbg, rnode_feats, redge_feats)
49         pnode_feats = self.mpnn(pbg, pnode_feats, pedge_feats)
50         mapping_scores = self.batch_att(rbg, pbg, rnode_feats, pnode_feats)
51         return mapping_scores
52     
