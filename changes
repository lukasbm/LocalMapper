212 def sample_annotations(
213     root: str | Path,
214     dataset: str,
215     model_name: str,
216     seed: int,
217     iteration: int,
218     split: str,
219     sample_limit: int,
220     *,
221     data_root: str | Path,
222     val_fraction: float,
223     test_fraction: float,
224     items: list[dict[str, Any]] | None = None,
225     max_candidates: int | None = None,
226 ) -> pd.DataFrame:
227     if items is None:
228         items = load_dataset_split(
229             dataset,
230             split,
231             data_root=data_root,
232             seed=seed,
233             val_fraction=val_fraction,
234             test_fraction=test_fraction,
235             max_candidates=max_candidates,
236         )
237     all_items = _item_frame(items)
238     if all_items.empty:
239         return all_items
240 
241     previous_annotations = load_annotations(
242         root, dataset, model_name, seed, iteration - 1
243     )
244     annotated_ids = (
245         set(previous_annotations["data_idx"].astype(str))
246         if not previous_annotations.empty
247         else set()
248     )
249     available = all_items[~all_items["data_idx"].astype(str).isin(annotated_ids)].copy()
250     if available.empty:
251         return available
252 
253     rng = np.random.default_rng(seed + iteration)
254     sample_limit = min(sample_limit, len(available))
255     selected_ids: list[str] = []
256     selection_reasons: dict[str, str] = {}
257     predicted_templates: dict[str, str | None] = {}
258     previous_predictions_by_id: dict[str, dict[str, Any]] = {}
259 
260     if iteration > 1:
261         pred_path = prediction_path(
262             root, dataset, model_name, seed, split, iteration - 1
263         )
264         known_templates = verified_templates(
265             root, dataset, model_name, seed, iteration - 1
266         )
267         rejected = rejected_templates(
268             root,
269             dataset,
270             model_name,
271             seed,
272             split,
273             through_prediction_iteration=iteration - 2,
274             through_annotation_iteration=iteration - 1,
275         )
276         if pred_path.exists():
277             predictions = pd.read_csv(pred_path, dtype={"data_idx": str})
278             predictions = predictions[
279                 predictions["data_idx"].isin(set(available["data_idx"].astype(str)))
280             ].copy()
281             previous_predictions_by_id = {
282                 str(row["data_idx"]): row.to_dict()
283                 for _, row in predictions.iterrows()
284             }
285             predictions["template"] = predictions["template"].astype("string")
286             uncertain = predictions[
287                 ~predictions["template"].fillna("").isin(known_templates | rejected)
288             ].copy()
289             if not uncertain.empty:
290                 groups = uncertain.groupby("template", dropna=False)
291                 group_keys = sorted(
292                     groups.groups.keys(),
293                     key=lambda key: len(groups.groups[key]),
294                     reverse=True,
295                 )
296                 for key in group_keys:
297                     if len(selected_ids) >= sample_limit:
298                         break
299                     group = groups.get_group(key)
300                     chosen = group.sample(
301                         n=1, random_state=int(rng.integers(0, 2**31 - 1))
302                     ).iloc[0]
303                     data_idx = str(chosen["data_idx"])
304                     selected_ids.append(data_idx)
305                     selection_reasons[data_idx] = "uncertain_template"
306                     predicted_templates[data_idx] = (
307                         None if pd.isna(chosen["template"]) else str(chosen["template"])
308                     )
309 
310     if len(selected_ids) < sample_limit:
311         remaining = available[~available["data_idx"].astype(str).isin(selected_ids)]
312         fill = remaining.sample(
313             n=sample_limit - len(selected_ids),
314             random_state=int(rng.integers(0, 2**31 - 1)),
315         )
316         fill_ids = fill["data_idx"].astype(str).tolist()
317         selected_ids.extend(fill_ids)
318         for data_idx in fill_ids:
319             selection_reasons[data_idx] = "random"
320 
321     selected = available[available["data_idx"].astype(str).isin(selected_ids)].copy()
322     order = {data_idx: i for i, data_idx in enumerate(selected_ids)}
323     selected["_order"] = selected["data_idx"].astype(str).map(order)
324     selected = selected.sort_values("_order").drop(columns=["_order"])
325     selected.insert(0, "iteration", iteration)
326     selected["template"] = [
327         template_for(rxn)
328         for rxn in _progress(selected["mapped_rxn"], desc="Extracting annotation templates")
329     ]
330     selected["selection_reason"] = [
331         selection_reasons.get(str(data_idx), "random")
332         for data_idx in selected["data_idx"]
333     ]
334     selected["predicted_template"] = [
335         predicted_templates.get(str(data_idx)) for data_idx in selected["data_idx"]
336     ]
337     selected["model_mapped_rxn"] = [
338         previous_predictions_by_id.get(str(data_idx), {}).get("mapped_rxn")
339         for data_idx in selected["data_idx"]
340     ]
341     selected["model_template"] = [
342         previous_predictions_by_id.get(str(data_idx), {}).get("template")
343         for data_idx in selected["data_idx"]
344     ]
345     selected["annotation_source"] = "dataset_ground_truth"
346     selected["rejected_template_memory_size"] = len(
347         rejected_templates(
348             root,
349             dataset,
350             model_name,
351             seed,
352             split,
353             through_prediction_iteration=iteration - 1,
354             through_annotation_iteration=iteration,
355         )
356     )
357     return selected
