200 def mapping_comparison_backend() -> str:
201     backend = _equivalence_backend()
202     if backend in {"synkit_its", "synkit_rc", "synkit_its_wl", "synkit_rc_wl"}:
203         return backend
204     if _use_isolated_cgrtools_comparison():
205         return "cgrtools_isolated"
206     if _use_cgrtools_comparison() and cgrtools_available():
207         return "cgrtools_direct"
208     return "canonical_signature"
