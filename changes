..                                                                                              149 def _atom_correspondence_metrics(predicted_rxn, reference_rxns):
..                                                                                              150     predicted = mapping_signature(predicted_rxn)
..                                                                                              151     references = [
..                                                                                              152         signature for rxn in reference_rxns if (signature := mapping_signature(rxn))
..                                                                                              153     ]
..                                                                                              154     if not references:
..                                                                                              155         return {"correct": 0, "total": 0, "accuracy": 0.0, "invalid": True}
..                                                                                              156     fallback_total = max(len(reference_pairs) for _, reference_pairs in references)
..                                                                                              157     if predicted is None:
..                                                                                              158         return {
..                                                                                              159             "correct": 0,
..                                                                                              160             "total": int(fallback_total),
..                                                                                              161             "accuracy": 0.0,
..                                                                                              162             "invalid": True,
..                                                                                              163         }
..                                                                                              164 
..                                                                                              165     predicted_pattern, predicted_pairs = predicted
..                                                                                              166     predicted_map = dict(predicted_pairs)
..                                                                                              167     best_correct = 0
..                                                                                              168     best_total = 0
..                                                                                              169     for reference_pattern, reference_pairs in references:
..                                                                                              170         if reference_pattern != predicted_pattern:
..                                                                                              171             continue
..                                                                                              172         reference_map = dict(reference_pairs)
..                                                                                              173         total = len(reference_map)
..                                                                                              174         correct = sum(
..                                                                                              175             predicted_map.get(product_idx) == reactant_idx
..                                                                                              176             for product_idx, reactant_idx in reference_map.items()
..                                                                                              177         )
..                                                                                              178         if correct > best_correct:
..                                                                                              179             best_correct = correct
..                                                                                              180             best_total = total
..                                                                                              181 
..                                                                                              182     if best_total == 0:
..                                                                                              183         best_total = fallback_total
..                                                                                              184 
..                                                                                              185     return {
..                                                                                              186         "correct": int(best_correct),
..                                                                                              187         "total": int(best_total),
..                                                                                              188         "accuracy": float(best_correct / best_total) if best_total else 0.0,
..                                                                                              189         "invalid": False,
..                                                                                              190     }
