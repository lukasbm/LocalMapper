200 def _item_frame(items: list[dict[str, Any]]) -> pd.DataFrame:
201     return pd.DataFrame(
202         {
203             "data_idx": [item["id"] for item in items],
204             "split": [item["split"] for item in items],
205             "mapped_rxn": [item["rxn"] for item in items],
206             "source": [item["source"] for item in items],
207             "num_mappings": [item["num_mappings"] for item in items],
208         }
