489 class ReactionDataset(torch.utils.data.Dataset):
490     def __init__(
491         self,
492         mol_to_graph,
493         *,
494         data_root: str | Path = "data",
495         items: list[dict[str, Any]] | None = None,
496         include_labels: bool = True,
497     ):
498         self.mol_to_graph = mol_to_graph
499         self.include_labels = include_labels
500         self.data_root = Path(data_root)
501         self.items = self.load_items() if items is None else items
502 
503     def load_items(self) -> list[dict[str, Any]]:
504         raise NotImplementedError
505 
506     @classmethod
507     def from_items(
508         cls,
509         items: list[dict[str, Any]],
510         mol_to_graph,
511         *,
512         include_labels: bool = True,
513     ) -> "ReactionDataset":
514         return cls(mol_to_graph, items=items, include_labels=include_labels)
515 
516     def __getitem__(self, item):
517         data = self.items[item]
518         rxn = data["rxn"]
519         r, p = rxn.split(">>")
520         rgraph = self.mol_to_graph(Chem.MolFromSmiles(r))
521         pgraph = self.mol_to_graph(Chem.MolFromSmiles(p))
522         label = get_mapping_label(rxn) if self.include_labels else []
523         if self.include_labels and label is None:
524             raise ValueError(f"Invalid mapped reaction for training item: {data['id']}")
525         return data["id"], rxn, rgraph, pgraph, label, data.get("weight", 1.0), data
526 
527     def __len__(self):
528         return len(self.items)
529 
530 
