 79 def load_train_val_dataloaders(
 80     dataset_name,
 81     mol_to_graph,
 82     batch_size=16,
 83     data_root="data",
 84     val_fraction=0.1,
 85     test_fraction=0.1,
 86     seed=0,
 87 ):
 88     full_dataset = create_reaction_dataset(
 89         dataset_name,
 90         mol_to_graph,
 91         data_root=data_root,
 92         include_labels=True,
 93     )
 94     train_dataset = ReactionDataset.from_items(
 95         select_split(
 96             full_dataset.items,
 97             "train",
 98             seed=seed,
 99             val_fraction=val_fraction,
100             test_fraction=test_fraction,
101         ),
102         mol_to_graph,
103         include_labels=True,
104     )
105     val_dataset = ReactionDataset.from_items(
106         select_split(
107             full_dataset.items,
108             "val",
109             seed=seed,
110             val_fraction=val_fraction,
111             test_fraction=test_fraction,
112         ),
113         mol_to_graph,
114         include_labels=True,
115     )
116     train_loader = DataLoader(
117         train_dataset,
118         batch_size=batch_size,
119         shuffle=True,
120         collate_fn=collate_reaction_batch,
121     )
122     val_loader = DataLoader(
123         val_dataset,
124         batch_size=batch_size,
125         shuffle=False,
126         collate_fn=collate_reaction_batch,
127     )
128     return train_loader, val_loader
