 31 def clean_map_and_sort(smiles_list, product_maps = [], return_mols = False):
 32     mols = []
 33     for smiles in smiles_list:
 34         if not smiles: continue
 35         mol = Chem.MolFromSmiles(smiles)
 36         [atom.SetAtomMapNum(0) for atom in mol.GetAtoms() if atom.GetAtomMapNum() not in product_maps]
 37         mols.append(mol)
 38 #         mols.append(Chem.MolFromSmiles(Chem.MolToSmiles(mol)))
 39     mols = sorted(mols, key= lambda m: m.GetNumAtoms(), reverse=True)
 40     if return_mols:
 41         return mols                                                                                
 42     else:
 43         return [Chem.MolToSmiles(mol) for mol in mols]
 44 
 45 def replace_deuterated(smi):
 46     return re.sub('\[2H\]', r'[H]', smi)
 47 
 48 def clear_mapnum(mol):
 49     [a.ClearProp('molAtomMapNumber') for a in mol.GetAtoms() if a.HasProp('molAtomMapNumber')]
 50     return mol
 51 
 52 def get_tagged_atoms_from_mols(mols):
 53     '''Takes a list of RDKit molecules and returns total list of
 54     atoms and their tags'''
 55     atoms = []
 56     atom_tags = []
 57     for mol in mols:
 58         new_atoms, new_atom_tags = get_tagged_atoms_from_mol(mol)
 59         atoms += new_atoms 
 60         atom_tags += new_atom_tags
 61     return atoms, atom_tags
 62 
 63 def get_tagged_atoms_from_mol(mol):
 64     '''Takes an RDKit molecule and returns list of tagged atoms and their
 65     corresponding numbers'''
 66     atoms = []
 67     atom_tags = []
 68     for atom in mol.GetAtoms():
 69         if atom.HasProp('molAtomMapNumber'):
 70             atoms.append(atom)
 71             atom_tags.append(str(atom.GetProp('molAtomMapNumber')))
 72     return atoms, atom_tags
 73 
 74 def atoms_are_different(atom1, atom2): 
 75     '''Compares two RDKit atoms based on basic properties'''
 76 
 77     if atom1.GetAtomicNum() != atom2.GetAtomicNum(): return True # must be true for atom mapping
 78     
 79 #     if atom1.GetNumRadicalElectrons() != atom2.GetNumRadicalElectrons(): return True
 80     if REMOTE:
 81         if atom1.GetFormalCharge() != atom2.GetFormalCharge(): return True
 82         # may be wrong information due to wrong atom mapping
 83         if atom1.GetTotalNumHs() != atom2.GetTotalNumHs(): return True
 84         
 85     # add or break bonds
 86     if atom_neighbors(atom1) != atom_neighbors(atom2): return True 
 87     
 88     # change bonds
 89     bonds1 = sorted([bond_to_smarts(bond) for bond in atom1.GetBonds()]) 
 90     bonds2 = sorted([bond_to_smarts(bond) for bond in atom2.GetBonds()]) 
 91     if bonds1 != bonds2: return True
 92 
 93     return False
 94 
 95 def find_map_num(mol, mapnum):
 96     return [(a.GetIdx(), a) for a in mol.GetAtoms() if a.HasProp('molAtomMapNumber') 
 97          and a.GetProp('molAtomMapNumber') == str(mapnum)][0]
 98 
 99 def clear_isotope(mol):
100     [a.SetIsotope(0) for a in mol.GetAtoms()]
101 
102 def get_changed_atoms(reactants, products):
103     '''Looks at mapped atoms in a reaction and determines which ones changed'''
104 
105     err = 0
106     prod_atoms, prod_atom_tags = get_tagged_atoms_from_mols(products)
107 
108     if VERBOSE: print('Products contain {} tagged atoms'.format(len(prod_atoms)))
109     if VERBOSE: print('Products contain {} unique atom numbers'.format(len(set(prod_atom_tags))))
110 
111     reac_atoms, reac_atom_tags = get_tagged_atoms_from_mols(reactants)
112     if len(set(prod_atom_tags)) != len(set(reac_atom_tags)):
113         if VERBOSE: print('warning: different atom tags appear in reactants and products')
114     if len(prod_atoms) != len(reac_atoms):
115         if VERBOSE: print('warning: total number of tagged atoms differ, stoichometry != 1?')
116 
117     # Find differences 
118     changed_atoms = [] # actual reactant atom species
119     changed_atom_tags = [] # atom map numbers of those atoms
120 
121     # Product atoms that are different from reactant atom equivalent
122     for i, prod_tag in enumerate(prod_atom_tags):
123         for j, reac_tag in enumerate(reac_atom_tags):
124             if reac_tag != prod_tag: continue
125             if reac_tag not in changed_atom_tags: # don't bother comparing if we know this atom changes
126                 # If atom changed, add
127                 if atoms_are_different(prod_atoms[i], reac_atoms[j]):
128                     changed_atoms.append(reac_atoms[j])
129                     changed_atom_tags.append(reac_tag)
130                     break
131                 # If reac_tag appears multiple times, add (need for stoichometry > 1)
132                 if prod_atom_tags.count(reac_tag) > 1:
133                     changed_atoms.append(reac_atoms[j])
134                     changed_atom_tags.append(reac_tag)
135                     break
136 
137     # Reactant atoms that do not appear in product (tagged leaving groups)
138     for j, reac_tag in enumerate(reac_atom_tags):
139         if reac_tag not in changed_atom_tags:
140             if reac_tag not in prod_atom_tags:
141                 changed_atoms.append(reac_atoms[j])
142                 changed_atom_tags.append(reac_tag)
143 
144     [clear_isotope(reactant) for reactant in reactants]
145     [clear_isotope(product) for product in products]
146 
147 
148     if VERBOSE: 
149         print('{} tagged atoms in reactants change 1-atom properties'.format(len(changed_atom_tags)))
150         for smarts in [atom.GetSmarts() for atom in changed_atoms]:
151             print('  {}'.format(smarts))
152     
153     return changed_atoms, changed_atom_tags, err
154 
155 def template_scorer(template, atom_dict):
156     score = 0
157     for s, b in enumerate(['-', ':', '=', '#']):
158         score += template.count(b) * (s+1)
159     for n in re.findall('\:([0-9]+)\]', template):
160         if n in atom_dict:
161             score += 0.1*atom_dict[n]['charge'] + 0.01*atom_dict[n]['Hs']
162     return score
163 
164 def inv_temp(template): # for more canonical representation
165     symbols = re.findall('\[[a-zA-Z@]+\:.*?\]', template)
166     nums = [int(n) for n in re.findall('\[[a-zA-Z@]+\:(.*?)\]', template)]
167     if len(nums) not in [2, 3] or ']1' in template:
168         return template
169     if nums[0] < nums[1]:
170         return template
171     if len(nums) == 3:
172         if nums[0] < nums[2]:
173             return template
174     bonds = [''] + [sorted(bond)[1] for bond in re.findall(r']([-=#:])|]1([-=#:])', template)]
175     return ''.join(['%s%s' % (a,b) for a, b in zip(symbols[::-1], bonds[::-1])])
176 
177 def inverse_template(template): # for more canonical representation
178     n_atoms = sum([Chem.MolFromSmarts(smarts).GetNumAtoms() for smarts in template.split('>>')])
179     labels = re.findall('(\[[a-zA-Z@]+\:.*?\])', template)
180     if n_atoms > len(labels): # include leaving group
181         return template
182     def score_bonds(bonds):
183         bond_dict = {b:str(i+1) for i,b in enumerate(['-', ':', '=', '#'])}
184         return eval(''.join([bond_dict[b] for b in bonds]))
185     if ']1' in template:
186         ring_template = True
187     else:
188         ring_template = False
189     bonds1 = [sorted(bond)[1] for bond in re.findall(r']([-=#:])|]1([-=#:])', template)]
190     bonds2 = bonds1[::-1]
191     if len(bonds1) == 0 or ')' in template or score_bonds(bonds1) <= score_bonds(bonds2):
192         return template
193     
194     labels = re.findall(r'\[.*?]', template)[::-1]
195     inv_template = labels[0]
196     for i in range(len(bonds2)):
197         if ring_template:
198             if i == 0:
199                 inv_template += '1'
200             if i+1 == len(labels):
201                 inv_template += bonds2[0]
202                 inv_template += '1' 
203             else:
204                 inv_template += bonds2[i+1]
205                 inv_template += labels[i+1]
206         else:
207             inv_template += bonds2[i]
208             inv_template += labels[i+1]
209     return inv_template
210 
211 def canonicalize_smarts(smarts): # for more canonical representation
212     return smarts
213     if USE_ATOM_SYMBOL:
214         return smarts
215     preserved_info = {'[#0:%s]' % a.split(':')[-1].split(']')[0]: a for a in re.findall(r"\[.*?]", smarts)}
216     try:
217         smiles = Chem.MolToSmiles(Chem.MolFromSmarts(smarts))
218         smarts_ = Chem.MolToSmarts(Chem.MolFromSmiles(smiles))
219     except:
220         return smarts
221     if '(' not in smarts_:
222         smarts = smarts_
223         for k, v in preserved_info.items():
224             smarts = smarts.replace(k, v)
225     return smarts
226 
227 def sort_template(transform, atom_dict): # for more canonical representation
228     transform = transform.split('>>')[0][1:-1].replace(').(', '.') + \
229         '>>' + transform.split('>>')[1][1:-1].replace(').(', '.')
230     templates = []
231     for tt in transform.split('>>'):
232         ts = []
233         for smarts in sorted(tt.split('.'), key=lambda s: template_scorer(s, atom_dict)):
234             try:
235                 ts.append(inverse_template(canonicalize_smarts(smarts)))
236             except:
237                 ts.append(canonicalize_smarts(smarts))
238         templates.append('.'.join(ts))
239     return '>>'.join(templates)
240 
241 def permutations(template):
242     n_atoms = sum([Chem.MolFromSmarts(smarts).GetNumAtoms() for smarts in template.split('>>')])
243     labels = re.findall('(\[[a-zA-Z@]+\:.*?\])', template)
244     if len(labels) == 1 or '(' in template or n_atoms > len(labels): # include leaving group
245         return [labels]
246     charges = re.findall('\;(.+?[0-9]+)\:', template)
247     bonds = re.findall('\]([-=#:])\[', template)
248     if ''.join(bonds) != ''.join(bonds[::-1]) or ''.join(charges) != ''.join(charges[::-1]):
249         return [labels]
250     return [labels,  labels[::-1]]
251         
252 def enumerate_mapping(transform):
253     for i, templates in enumerate(transform.split('>>')):
254         grow_template = None
255         for template in templates.split('.'):
256             pert_template = permutations(template)
257             if grow_template == None:
258                 grow_template = pert_template
259             else:
260                 growed_template = []
261                 for t in grow_template:
262                     for p in pert_template:
263                         growed_template.append(t + p)
264                 grow_template = growed_template
265         if i == 0:
266             r_permutes = grow_template
267         else:
268             p_permutes = grow_template
269                 
270     t_permutes = []
271     for r in r_permutes:
272         for p in p_permutes:
273                 t_permutes.append(r+p)
274     return t_permutes
275 
276 def reassign_atom_mapping(transform, atom_dict):
277     if not RETRO:
278         transform = '>>'.join(transform.split('>>')[::-1])
279     transform = sort_template(transform, atom_dict)
280     
281     p_labels = enumerate_mapping(transform)
282     templates = set()
283     templates_sort = {}
284     replacement_dicts = {}
285     for all_labels in p_labels:
286     # Define list of replacements which matches all_labels *IN ORDER*
287         replacements = []
288         replacement_dict_symbol = {}
289         replacement_dict = {}
290         counter = 1
291         for label in all_labels: # keep in order! this is important
292             atom_map = label.split(':')[1].split(']')[0]
293             if atom_map not in replacement_dict:
294                 replacement_dict_symbol[label] = '%s:%s]' % (label.split(':')[0], counter)
295                 replacement_dict[atom_map] = str(counter)
296                 counter += 1
297             else:
298                 replacement_dict_symbol[label] = '%s:%s]' % (label.split(':')[0], replacement_dict[atom_map])
299             replacements.append(replacement_dict_symbol[label])
300             
301         # Perform replacements in order
302         transform_newmaps = re.sub('\[[a-zA-Z@]+\:.*?\]', lambda match: (replacements.pop(0)), transform)
303         transform_newmaps = '>>'.join(transform_newmaps.split('>>')[::-1])
304             
305         templates.add(transform_newmaps)
306         templates_sort[transform_newmaps] = ''.join(re.findall('\[[a-zA-Z@]+\:.*?\]', transform_newmaps))
307         replacement_dicts[transform_newmaps] = replacement_dict
308     
309     transform_newmaps = sorted(list(templates), key = lambda t:templates_sort[t])[0]
310     replacement_dict = replacement_dicts[transform_newmaps]
311     return transform_newmaps, replacement_dict
312 
313 def get_strict_smarts_for_atom(atom):
314     '''
315     For an RDkit atom object, generate a SMARTS pattern that
316     matches the atom as strictly as possible
317     '''        
318     if USE_ATOM_SYMBOL:
319         symbol = '[%s:%s]' % (atom.GetSymbol(), atom.GetAtomMapNum())
320     else:
321         symbol = '[A:%s]' % (atom.GetAtomMapNum())
322         
323     if atom.GetIsAromatic():
324         symbol = symbol.lower()
325         
326     if atom.GetSymbol() == 'H':
327         symbol = '[#1]'
328         
329     if '[' not in symbol:
330         symbol = '[' + symbol + ']'
331             
332     return symbol
333 
334 def get_fragments_for_changed_atoms(mols, changed_atom_tags, category = 'reactant', special_atoms = []):
335     fragments = ''
336     mols_changed = []
337     mols_special = []
338     for mol in mols:
339         # Initialize list of replacement symbols (updated during expansion)
340         symbol_replacements = []
341 
342         # Build list of atoms to use
343         atoms_to_use = []
344  
345         for atom in mol.GetAtoms():
346             # Check self (only tagged atoms)
347             if ':' in atom.GetSmarts():
348                 atom_map = atom.GetSmarts().split(':')[1][:-1]
349                 if atom_map in changed_atom_tags+special_atoms:
350                     atoms_to_use.append(atom.GetIdx())
351                     symbol = get_strict_smarts_for_atom(atom)
352                     if atom_map in changed_atom_tags:
353                         symbol = get_strict_smarts_for_atom(atom)
354                         if symbol != atom.GetSmarts():
355                             symbol_replacements.append((atom.GetIdx(), symbol))
356                     else:
357                         if atom.GetIsAromatic():
358                             symbol_replacements.append((atom.GetIdx(), atom.GetSymbol().lower()))
359                         else:
360                             symbol_replacements.append((atom.GetIdx(), atom.GetSymbol()))
361                     
362         if category == 'reactant':
363             if INCLUDE_NEIGHBORS:
364                 groups = get_special_groups(mol)
365                 atoms_to_use, symbol_replacements, mol = expand_atoms_to_use(mol, atoms_to_use, 
366                     groups=groups, symbol_replacements=symbol_replacements)
367                 for atom_idx in atoms_to_use:
368                     atom = mol.GetAtomWithIdx(atom_idx)
369                     atom_map = str(atom.GetAtomMapNum())
370                     if atom_map not in changed_atom_tags:
371                         special_atoms.append(atom_map)
372                         if atom.GetIsAromatic():
373                             symbol_replacements.append((atom.GetIdx(), atom.GetSymbol().lower()))
374                         else:
375                             symbol_replacements.append((atom.GetIdx(), atom.GetSymbol()))
376             
377             for atom in mol.GetAtoms():
378                 if not atom.HasProp('molAtomMapNumber'): # LG in reactant is also mapped in foward synthesis
379                     atoms_to_use.append(atom.GetIdx())
380         
381         else:
382             groups = []
383         mols_special.append(mol)
384         # Define new symbols based on symbol_replacements
385         symbols = [atom.GetSmarts() for atom in mol.GetAtoms()]
386         for (i, symbol) in symbol_replacements:
387             symbols[i] = symbol
388         if not atoms_to_use: 
389             continue
390         
391         mol_copy = deepcopy(mol)
392         [x.ClearProp('molAtomMapNumber') for x in mol_copy.GetAtoms()]   
393         this_fragment = AllChem.MolFragmentToSmiles(mol_copy, atoms_to_use, 
394             atomSymbols=symbols, allHsExplicit=True, 
395             isomericSmiles=USE_STEREOCHEMISTRY, allBondsExplicit=True)
396         fragments += '(' + this_fragment + ').'
397         mols_changed.append(Chem.MolToSmiles(clear_mapnum(Chem.MolFromSmiles(Chem.MolToSmiles(mol, True))), True))
398         
399     # auxiliary template information: is this an intramolecular reaction or dimerization?
400     intra_only = (1 == len(mols_changed))
401     dimer_only = (1 == len(set(mols_changed))) and (len(mols_changed) == 2)
402     return fragments[:-1], intra_only, dimer_only, mols_special, special_atoms
403 
404 def canonicalize_transform(transform, atom_dict):
405     '''This function takes an atom-mapped SMARTS transform and
406     converts it to a canonical form by, if nececssary, rearranging
407     the order of reactant and product templates and reassigning
408     atom maps.'''
409 
410     transform_reordered = '>>'.join([canonicalize_template(x) for x in transform.split('>>')])
411     return reassign_atom_mapping(transform_reordered, atom_dict)
412 
413 def canonicalize_template(template):
414     '''This function takes one-half of a template SMARTS string 
415     (i.e., reactants or products) and re-orders them based on
416     an equivalent string without atom mapping.'''
417 
418     # Strip labels to get sort orders
419     template_nolabels = re.sub('\:[0-9]+\]', ']', template)
420 
421     # Split into separate molecules *WITHOUT wrapper parentheses*
422     template_nolabels_mols = template_nolabels[1:-1].split(').(')
423     template_mols          = template[1:-1].split(').(')
424 
425     # Split into fragments within those molecules
426     for i in range(len(template_mols)):
427         nolabel_mol_frags = template_nolabels_mols[i].split('.')
428         mol_frags         = template_mols[i].split('.')
429 
430         # Get sort order within molecule, defined WITHOUT labels
431         sortorder = [j[0] for j in sorted(enumerate(nolabel_mol_frags), key = lambda x:x[1])]
432 
433         # Apply sorting and merge list back into overall mol fragment
434         template_nolabels_mols[i] = '.'.join([nolabel_mol_frags[j] for j in sortorder])
435         template_mols[i]          = '.'.join([mol_frags[j] for j in sortorder])
436 
437     # Get sort order between molecules, defined WITHOUT labels
438     sortorder = [j[0] for j in sorted(enumerate(template_nolabels_mols), key = lambda x:x[1])]
439 
440     # Apply sorting and merge list back into overall transform
441     template = '(' + ').('.join([template_mols[i] for i in sortorder]) + ')'
442 
443     return template
444 
445 def bond_to_smarts(bond):
446     '''This function takes an RDKit bond and creates a label describing
447     the most important attributes'''
448     a1_label = str(bond.GetBeginAtom().GetAtomicNum())
449     a2_label = str(bond.GetEndAtom().GetAtomicNum())
450     if bond.GetBeginAtom().HasProp('molAtomMapNumber'):
451         a1_label += bond.GetBeginAtom().GetProp('molAtomMapNumber')
452     if bond.GetEndAtom().HasProp('molAtomMapNumber'):
453         a2_label += bond.GetEndAtom().GetProp('molAtomMapNumber')
454     atoms = sorted([a1_label, a2_label])
455     bond_dict = {'SINGLE':'-', 'DOUBLE':'=', 'TRIPLE':'#', 'AROMATIC':':'}
456     bond_smarts = bond_dict[str(bond.GetBondType())]
457     
458     return '{}{}{}'.format(atoms[0], bond_smarts, atoms[1])
459 
460 def split_reagents(reaction):
461     rs, ps = replace_deuterated(reaction['reactants']).split('.'), replace_deuterated(reaction['products']).split('.')
462     largest_p = [Chem.MolFromSmiles(smiles).GetNumAtoms() for smiles in ps if smiles not in rs and smiles != '']
463     if len(largest_p) == 0:
464         return [], [], []
465     least_atom_n = min([max(largest_p), LEAST_ATOM_NUM])
466     reactants = []
467     reagents = []
468     products = []
469     pmaps = []
470     for smiles in ps:
471         mol = Chem.MolFromSmiles(smiles)
472         if mol.GetNumAtoms() >= least_atom_n and smiles not in reagents:
473             pmaps += [atom.GetAtomMapNum() for atom in mol.GetAtoms()]
474             products.append(smiles)
475 
476     for smiles in rs:
477         mol = Chem.MolFromSmiles(smiles)
478         if smiles in ps or sum([atom.GetAtomMapNum() in pmaps for atom in mol.GetAtoms()]) == 0:
479             reagents.append(smiles)
480         else:
481             reactants.append(smiles)
482     products = [p for p in products if p not in reagents]
483     return reactants, reagents, products                                                     
484     
485 def extract_from_reaction(reaction, setting = default_setting):
486     set_extractor(setting)
487     if type(reaction) == type('string'):
488         reaction = {'reactants': reaction.split('>>')[0], 'products': reaction.split('>>')[1]}
489     reactants_list, reagents_list, products_list = split_reagents(reaction)
490     
491     if len(products_list) == 0:
492         return None
493     product_maps = [atom.GetAtomMapNum() for products in products_list for atom in Chem.MolFromSmiles(products).GetAtoms()]
494     products = clean_map_and_sort(products_list, product_maps, return_mols = True)
495     reactants = clean_map_and_sort(reactants_list, product_maps, return_mols = True)
496 
497     if None in reactants: return None
498     if None in products: return None
499     # try to sanitize molecules
500     try:
501         for i in range(len(reactants)):
502             reactants[i] = AllChem.RemoveHs(reactants[i]) # *might* not be safe
503         for i in range(len(products)):
504             products[i] = AllChem.RemoveHs(products[i]) # *might* not be safe
505         [Chem.SanitizeMol(mol) for mol in reactants + products] # redundant w/ RemoveHs
506         [mol.UpdatePropertyCache() for mol in reactants + products]
507     except Exception as e:
508         if VERBOSE:
509             print(e)
510             print('Could not load SMILES or sanitize')
511         return
512 
513     if None in reactants + products:
514         if VERBOSE:
515             print('Could not parse all molecules in reaction, skipping')
516         return
517 
518     
519     # Calculate changed atoms
520     changed_atoms, changed_atom_tags, err = get_changed_atoms(reactants, products)
521             
522     if err: 
523         if VERBOSE:
524             print('Could not get changed atoms')
525         return
526     if not changed_atom_tags:
527         if VERBOSE:
528             print('No atoms changed?')
529         return 
530 
531     try:
532         reactant_fragments, _, _, reactants, special_atoms = get_fragments_for_changed_atoms(reactants, changed_atom_tags, 'reactant', [])
533         product_fragments, _, _, _, _  = get_fragments_for_changed_atoms(products, changed_atom_tags, 'product', special_atoms)
534         reaction['reactants'] = '.'.join([Chem.MolToSmiles(m, canonical=False) for m in reactants])
535     except ValueError as e:
536         if VERBOSE:
537             print(e)
538         return 
539     
540     # Put together and canonicalize (as best as possible)
541     rxn_string = reactant_fragments + '>>' + product_fragments
542     if VERBOSE:
543         print (rxn_string)
544     atom_dict = {str(atom.GetAtomMapNum()): {'charge': atom.GetFormalCharge(), 'Hs': atom.GetNumExplicitHs()} for atom in changed_atoms}
545     
546     rxn_canonical, replacement_dict = canonicalize_transform(rxn_string, atom_dict)
547     
548     reactants_string = rxn_canonical.split('>>')[0]
549     products_string  = rxn_canonical.split('>>')[1]
550     products_smiles = '.'.join([Chem.MolToSmiles(p) for p in products])
551     reactants_smiles = '.'.join([Chem.MolToSmiles(r) for r in reactants])
552     try:
553         products_string = canonicalize_smarts(products_string)
554         reactants_string = canonicalize_smarts(reactants_string)
555     except:
556         pass
557     
558     canonical_template = '%s>>%s' % (reactants_string, products_string)
559     rxn = AllChem.ReactionFromSmarts(canonical_template)
560     if rxn.Validate()[1] != 0: 
561         if VERBOSE: 
562             print('Could not validate reaction successfully')
563             print('canonical_template: {}'.format(canonical_template))
564             print (reaction['reactants'] + '>>' + reaction['products'])
565         return 
566     
567     return canonical_template
568 

