118             "cgrtools": _package_version("CGRtools", "cgrtools-plus", "CGRtools"),
119             "torch": _package_version("torch", "torch"),
120         },
121         "git": {
122             "commit": _git_value("rev-parse", "HEAD"),
123             "dirty": bool(_git_value("status", "--porcelain")),
124         },
125     }
126 
127     metadata_path = run_dir / "run_metadata.json"
128     with metadata_path.open("w") as handle:
